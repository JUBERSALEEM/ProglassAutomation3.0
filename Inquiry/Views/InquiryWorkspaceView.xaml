<UserControl x:Class="ProGlassAutomation.Inquiry.InquiryWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProGlassAutomation.Inquiry"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- The Inquiry module's workspace: the register (list), the website
         inbox (separate page, owner spec) and the detail editor switch
         in place. The register is the module's landing view; the same
         page pattern is reused by later modules (PI, JO, DN, TI). -->
    <Grid>
        <local:InquiryListView x:Name="ListView" />
        <local:InquiryInboxView x:Name="InboxView" Visibility="Collapsed" />
        <local:InquiryEditorView x:Name="EditorView" Visibility="Collapsed" />
    </Grid>
</UserControl>
