<UserControl x:Class="ProGlassAutomation.Inquiry.InquiryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Inquiry"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="EditorFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
        </Style>
        <Style x:Key="EditorRowRemove" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="AutomationProperties.Name" Value="Remove line" />
        </Style>
        <Style x:Key="StageChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="{DynamicResource PaddingMark}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Compact card: same contract Card, tighter padding (8,4). -->
        <Style x:Key="EditorCompactCard" TargetType="ContentControl" BasedOn="{DynamicResource Card}">
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Header: back, title, status actions, save ──────────── -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSecondary}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Margin="{DynamicResource PaddingPage}" Padding="{DynamicResource PaddingCompact}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Register" Style="{DynamicResource SubtleButton}"
                        Command="{Binding GoBackCommand}" Margin="{DynamicResource MarginInline}"
                        VerticalAlignment="Top" AutomationProperties.Name="Back to register" />
                <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{DynamicResource StatusBadge}" Tag="{Binding StatusTag}" Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="{Binding Status}" Style="{DynamicResource StatusText}" Tag="{Binding StatusTag}" />
                            </Border>
                            <TextBlock Text="{Binding HeaderDotText}" FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Center" Margin="{DynamicResource MarginInline}"
                                       Foreground="{DynamicResource StatusWarning}"
                                       ToolTip="Unsaved changes" />
                        </StackPanel>
                        <TextBlock Text="{Binding HeaderTitle}" Style="{DynamicResource PageHeading}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
                            <Border Background="{DynamicResource StatusErrorSurface}"
                            BorderBrush="{DynamicResource StatusError}"
                            BorderThickness="{DynamicResource BorderThicknessControl}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource PaddingControl}"
                            Margin="{DynamicResource MarginItem}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="{DynamicResource MarginItem}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Prepare" Style="{DynamicResource SubtleButton}" Command="{Binding ChangeStatusCommand}"
                            CommandParameter="Prepared"
                            Margin="{DynamicResource MarginInline}" IsEnabled="{Binding CanPrepare}"
                            AutomationProperties.Name="Prepare inquiry" />
                    <Button Content="Send" Style="{DynamicResource SubtleButton}" Command="{Binding ChangeStatusCommand}"
                            CommandParameter="Sent"
                            Margin="{DynamicResource MarginInline}" IsEnabled="{Binding CanSend}"
                            AutomationProperties.Name="Send inquiry" />
                    <Button Content="Confirm" Style="{DynamicResource SubtleButton}" Command="{Binding ChangeStatusCommand}"
                            CommandParameter="Confirmed"
                            Margin="{DynamicResource MarginInline}" IsEnabled="{Binding CanConfirm}"
                            AutomationProperties.Name="Confirm inquiry" />
                    <Button Content="Hold" Style="{DynamicResource SubtleButton}" Command="{Binding ChangeStatusCommand}"
                            CommandParameter="Hold"
                            Margin="{DynamicResource MarginInline}" IsEnabled="{Binding CanHold}"
                            AutomationProperties.Name="Hold inquiry" />
                    <Button Content="Cancel inquiry" Style="{DynamicResource SubtleButton}" Command="{Binding ChangeStatusCommand}"
                            CommandParameter="Cancelled"
                            Margin="{DynamicResource MarginInline}" IsEnabled="{Binding CanCancel}"
                            AutomationProperties.Name="Cancel inquiry" />
                    <Button Content="Cancel changes" Style="{DynamicResource SubtleButton}" Command="{Binding CancelCommand}"
                            Margin="{DynamicResource MarginInline}"
                            AutomationProperties.Name="Close without saving" />
                    <Button Content="{Binding SaveCommandText}" Style="{DynamicResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Margin="{DynamicResource MarginInline}"
                            AutomationProperties.Name="Save inquiry" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── Scrollable content cards ───────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{DynamicResource PaddingPage}">
            <StackPanel>
                <!-- Header fields -->
                <ContentControl Style="{DynamicResource EditorCompactCard}">
                    <StackPanel>
                        <TextBlock Text="Header fields" Style="{DynamicResource SectionHeading}" />
                        <UniformGrid Columns="3" Margin="{DynamicResource MarginItem}">
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Reference" Style="{StaticResource EditorFieldLabel}" />
                                <TextBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Reference" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Customer  (required)" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" VerticalAlignment="Center" IsEditable="True"
                                          ItemsSource="{Binding Customers}" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="Customer" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Location" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" VerticalAlignment="Center" IsEditable="True"
                                          ItemsSource="{Binding CustomerLocations}" Text="{Binding CustomerLocation, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="Customer location" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Project  (required)" Style="{StaticResource EditorFieldLabel}" />
                                <TextBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Project" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Salesman" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" VerticalAlignment="Center" IsEditable="True"
                                          ItemsSource="{Binding Salesmen}" Text="{Binding SalesmanName, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="Salesman" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Priority" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" VerticalAlignment="Center" ItemsSource="{Binding Priorities}"
                                          SelectedItem="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="Priority" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Received" Style="{StaticResource EditorFieldLabel}" />
                                <DatePicker SelectedDate="{Binding ReceivedDate}" AutomationProperties.Name="Received date"
                                            Margin="{DynamicResource MarginItem}" />
                                <TextBlock Text="{Binding ReceivedHint}" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Value (AED)" />
                                <TextBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Inquiry value in AED" />
                                <TextBlock Text="{Binding ValueHint}" Margin="{DynamicResource MarginItem}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValueError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource MarginInline}">
                                <TextBlock Text="Prepared by" Style="{StaticResource EditorFieldLabel}" />
                                <TextBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" IsReadOnly="True"
                                         Text="{Binding Record.PreparedByName, Mode=OneWay}" AutomationProperties.Name="Prepared by" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="{DynamicResource MarginItem}">
                            <TextBlock Text="Project description" Style="{StaticResource EditorFieldLabel}" />
                            <TextBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False" TextWrapping="Wrap" AutomationProperties.Name="Project description" />
                        </StackPanel>
                        <StackPanel Margin="{DynamicResource MarginItem}">
                            <TextBlock Text="Notes" Style="{StaticResource EditorFieldLabel}" />
                            <TextBox Margin="{DynamicResource MarginItem}" MinHeight="{DynamicResource ControlMinHeight}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Notes" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <!-- Scope of supply (BOQ) -->
                <ContentControl Style="{DynamicResource EditorCompactCard}" Margin="{DynamicResource MarginItem}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Add row" Style="{DynamicResource SubtleButton}"
                                    Command="{Binding AddLineItemCommand}" Margin="{DynamicResource MarginInline}"
                                    AutomationProperties.Name="Add scope of supply row" />
                            <TextBlock Text="Scope of supply (BOQ)" Style="{DynamicResource SectionHeading}" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding LineItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  SelectionMode="SingleRow"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  MinHeight="140"
                                  Margin="{DynamicResource MarginItem}"
                                  AutomationProperties.Name="Scope of supply lines">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Glass build" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static vm:InquiryEditorViewModel.BoqGlassTypes}"
                                                      SelectedItem="{Binding GlassType, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      AutomationProperties.Name="Glass build" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Item / specification" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SpecName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Item specification" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Outer" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Outer glass" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Inner" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding InnerGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Inner glass" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="W mm" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Right"
                                                     AutomationProperties.Name="Width in millimetres" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="H mm" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Right"
                                                     AutomationProperties.Name="Height in millimetres" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qty" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Right"
                                                     AutomationProperties.Name="Quantity" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rate / m²" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding RatePerSqm, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Right"
                                                     ToolTip="Expected rate only — 0 keeps it unpriced until the PI"
                                                     AutomationProperties.Name="Expected rate per square metre" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Notes" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Line notes" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="52" IsSortable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource EditorRowRemove}"
                                                    Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="{DynamicResource MarginItem}">
                            <TextBlock Text="Rate 0 = prices are decided later in the PI"
                                       Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineItemsAreaText}"
                                       Style="{DynamicResource Caption}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </ContentControl>

                <!-- Attachments -->
                <ContentControl Style="{DynamicResource EditorCompactCard}" Margin="{DynamicResource MarginItem}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open folder" Style="{DynamicResource SubtleButton}"
                                    Command="{Binding OpenAttachmentsFolderCommand}" Margin="{DynamicResource MarginInline}"
                                    AutomationProperties.Name="Open attachments folder" />
                            <Button DockPanel.Dock="Right" Content="+ Add attachment" Style="{DynamicResource SubtleButton}"
                                    Command="{Binding AddAttachmentCommand}" Margin="{DynamicResource MarginInline}"
                                    AutomationProperties.Name="Add attachment" />
                            <TextBlock Text="Attachments" Style="{DynamicResource SectionHeading}" />
                        </DockPanel>
                        <TextBlock Text="PDF, images, DWG/DXF, XLSX/CSV, ZIP or TXT · up to 30 MB per file"
                                   Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}" />
                        <ListBox ItemsSource="{Binding AttachmentItems}"
                                 BorderThickness="0" Background="{DynamicResource SurfacePrimary}"
                                 Margin="{DynamicResource MarginItem}" AutomationProperties.Name="Attachments">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{DynamicResource MarginItem}">
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{DynamicResource SubtleButton}"
                                                Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="{DynamicResource MarginInline}"
                                                AutomationProperties.Name="Delete attachment" />
                                        <Button DockPanel.Dock="Right" Content="Open" Style="{DynamicResource SubtleButton}"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="{DynamicResource MarginInline}"
                                                AutomationProperties.Name="Open attachment" />
                                        <TextBlock Text="{Binding DetailText}" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource StageChip}">
                                                <TextBlock Text="{Binding TypeLabel}" Style="{DynamicResource Caption}" />
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" Margin="{DynamicResource MarginInline}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="420" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No attachments yet."
                                   Margin="{DynamicResource MarginItem}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ContentControl>

                <!-- Communications -->
                <ContentControl Style="{DynamicResource EditorCompactCard}" Margin="{DynamicResource MarginItem}">
                    <StackPanel>
                        <TextBlock Text="Communications &amp; activity" Style="{DynamicResource SectionHeading}" />
                        <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="{DynamicResource MarginItem}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{DynamicResource MarginItem}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OccurredAt, StringFormat='{}{0:dd MMM yyyy · HH:mm}'}"
                                                   Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="{DynamicResource FontWeightHeading}" />
                                            <TextBlock Text="{Binding Description}" Style="{DynamicResource Caption}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Actor, StringFormat=By {0}}" Style="{DynamicResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No activity yet — status changes and BOQ saves appear here."
                                   Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentActivity}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ContentControl>

                <!-- Lifecycle -->
                <ContentControl Style="{DynamicResource EditorCompactCard}" Margin="{DynamicResource MarginItem}">
                    <StackPanel>
                        <TextBlock Text="Lifecycle" Style="{DynamicResource SectionHeading}" />
                        <TextBlock Text="{Binding PipelineProgressText}" Style="{DynamicResource Caption}"
                                   Margin="{DynamicResource MarginItem}" />
                        <ItemsControl ItemsSource="{Binding Stages}" Margin="{DynamicResource MarginItem}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{DynamicResource MarginItem}">
                                        <Border DockPanel.Dock="Right" Style="{DynamicResource StatusBadge}" Tag="{Binding StateTag}">
                                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}" Tag="{Binding StateTag}"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}">
                                            <Border Style="{StaticResource StageChip}">
                                                <TextBlock Text="{Binding Short}" Style="{DynamicResource Caption}"
                                                           FontFamily="{DynamicResource FontFamilyMono}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Margin="{DynamicResource MarginInline}"
                                                       VerticalAlignment="Center" FontWeight="{DynamicResource FontWeightHeading}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
