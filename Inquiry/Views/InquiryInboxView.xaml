<UserControl x:Class="ProGlassAutomation.Inquiry.InquiryInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="InboxCountBadge" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page heading + primary actions ─────────────────────── -->
        <DockPanel Grid.Row="0" Margin="{DynamicResource PaddingPage}">
            <Button DockPanel.Dock="Right" Content="Check now"
                    Style="{DynamicResource PrimaryButton}"
                    Command="{Binding CheckNowCommand}"
                    Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Check the customer website now" />
            <Button DockPanel.Dock="Right" Content="Test connection" Style="{DynamicResource SubtleButton}"
                    Command="{Binding TestConnectionCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Test the website connection" />
            <Button DockPanel.Dock="Right" Content="← Register" Style="{DynamicResource SubtleButton}"
                    Command="{Binding BackCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Back to the inquiry register" />
            <StackPanel>
                <TextBlock Text="Customer inbox" Style="{DynamicResource PageHeading}" />
                <TextBlock Text="Inquiries arriving from the customer website — sync, review, then create local inquiries" Style="{DynamicResource Caption}" />
            </StackPanel>
        </DockPanel>

        <!-- ── Status strip ───────────────────────────────────────── -->
        <ContentControl Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionText}"
                               FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LastSyncText}" Style="{DynamicResource Caption}" />
                        <TextBlock Text="  ·  " Style="{DynamicResource Caption}" />
                        <TextBlock Text="{Binding AutoSyncText}" Style="{DynamicResource Caption}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource StatusBadge}" Tag="Information"
                            Margin="{DynamicResource MarginInline}">
                        <StackPanel Style="{StaticResource InboxCountBadge}">
                            <TextBlock Text="{Binding ReadyCount}"
                                       FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource StatusInformation}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" awaiting import" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource StatusBadge}" Tag="Success"
                            Margin="{DynamicResource MarginInline}">
                        <StackPanel Style="{StaticResource InboxCountBadge}">
                            <TextBlock Text="{Binding IngestedCount}"
                                       FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource StatusSuccess}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" in register" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource StatusBadge}" Tag="Error"
                            Margin="{DynamicResource MarginInline}">
                        <StackPanel Style="{StaticResource InboxCountBadge}">
                            <TextBlock Text="{Binding FailedCount}"
                                       FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource StatusError}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" failed" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- ── Website connection card ────────────────────────────── -->
        <ContentControl Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="{DynamicResource MarginItem}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Save connection" Style="{DynamicResource SubtleButton}"
                                Command="{Binding SaveSettingsCommand}" Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Save the website connection" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding SavedPasswordHint}" Style="{DynamicResource Caption}"
                                   ToolTip="{Binding SavedPasswordHint}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Website connection" Style="{DynamicResource SectionHeading}" />
                        <TextBlock Text="Sign in with an eligible Supabase Auth account. Delivery access requires the website-granted inbox capability."
                                   Style="{DynamicResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Supabase URL" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. https://xxxx.supabase.co"
                                 AutomationProperties.Name="Supabase URL" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Supabase API key (anon or publishable)" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}"
                                   ToolTip="Use a public anon or publishable key. Never enter a service_role secret here." />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding AnonKey, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Supabase API key" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Supabase account email" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding BridgeEmail, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Supabase account email" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Supabase password" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}"
                                   ToolTip="Use the password for this Supabase Auth account." />
                        <PasswordBox x:Name="PasswordBox" Style="{DynamicResource {x:Type PasswordBox}}"
                                     MinWidth="{DynamicResource ControlMinWidth}"
                                     ToolTip="Your account must have the website-granted inbox.plan.bridge capability."
                                     AutomationProperties.Name="Supabase account password" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Inbox folder" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding InboxRoot, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Shared with the Node bridge (GLASS_INBOX_ROOT)"
                                 AutomationProperties.Name="Inbox folder" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Automatic check" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                      ItemsSource="{Binding PollIntervalOptions}"
                                      SelectedItem="{Binding SelectedPollInterval, Mode=TwoWay}"
                                      Width="120" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Automatic check interval">
                                <!-- ItemTemplate, not DisplayMemberPath: the closed
                                     box shows SelectionBoxItem through its template. -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                 Columns="4" VerticalAlignment="Center">
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="Desktop notifications" IsChecked="{Binding NotificationsEnabled}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Desktop notifications" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="With sound" IsChecked="{Binding NotificationSound}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  IsEnabled="{Binding NotificationsEnabled}"
                                  AutomationProperties.Name="Notification sound" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="Report status" IsChecked="{Binding ReportStatusToWebsite}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Report status to website"
                                  ToolTip="{Binding ReportStatusHint}" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="Sync website chat" IsChecked="{Binding SyncWebsiteChat}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Sync website chat"
                                  ToolTip="{Binding ChatSyncHint}" />
                    </UniformGrid>
                </Grid>
                <TextBlock Grid.Row="2" Margin="{DynamicResource MarginItem}"
                           Text="{Binding AccessReportText}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Authenticated account roles and access report" />
                <TextBlock Grid.Row="3" Margin="{DynamicResource MarginItem}"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </ContentControl>

        <!-- ── Deliveries ─────────────────────────────────────────── -->
        <ContentControl Grid.Row="3" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="{DynamicResource MarginItem}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedErrorText}"
                                   Foreground="{DynamicResource StatusError}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource MarginInline}" />
                        <Button Content="{Binding SelectedIngestActionLabel}" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding IngestSelectedCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Import or re-import the selected delivery from disk" />
                        <Button Content="Open inquiry" Style="{DynamicResource SubtleButton}"
                                Command="{Binding OpenInquirySelectedCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Open the local inquiry for the selected delivery" />
                        <Button Content="Open folder" Style="{DynamicResource SubtleButton}"
                                Command="{Binding OpenFolderSelectedCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Open the delivery folder" />
                    </StackPanel>
                    <TextBlock Text="Website deliveries" Style="{DynamicResource SectionHeading}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
                    <DataGrid Style="{DynamicResource ListGrid}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              Margin="0"
                              AutomationProperties.Name="Website deliveries"
                              MouseDoubleClick="OnRowDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}"
                                                ElementStyle="{StaticResource ListMonoText}" />
                            <DataGridTextColumn Header="Company" Binding="{Binding Company}"
                                                ElementStyle="{StaticResource ListStrongText}" />
                            <DataGridTextColumn Header="Project" Binding="{Binding Project}"
                                                ElementStyle="{StaticResource ListText}" />
                            <DataGridTextColumn Header="Prepared by" Binding="{Binding Estimator}"
                                                ElementStyle="{StaticResource ListText}" />
                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Files" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DocumentsText}"
                                                Style="{DynamicResource SubtleButton}"
                                                Padding="4,1" Margin="0"
                                                Click="OnFilesClick"
                                                AutomationProperties.Name="Show delivery folder and file names" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}"
                                                ElementStyle="{StaticResource ListText}" />
                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="State" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusBadge}" Tag="{Binding StateTag}"
                                                HorizontalAlignment="Center"
                                                ToolTip="{Binding Error}"
                                                ToolTipService.ShowDuration="60000">
                                            <TextBlock Text="{Binding State}" Style="{DynamicResource StatusText}"
                                                       Tag="{Binding StateTag}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Local inquiry" Binding="{Binding LocalNumber}"
                                                ElementStyle="{StaticResource ListMonoText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- The empty state is a heading, so it is the heading style — the same one
                                 InquiryListView's empty state uses. Literal text carrying the
                                 section size and weight by hand is what the owner meant by
                                 "few text didnt have heading type" (round 49). -->
                            <TextBlock Text="No website deliveries yet"
                                   Style="{DynamicResource SectionHeading}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="When the customer website receives an inquiry, it appears here automatically — or press Check now."
                                   Style="{DynamicResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="{DynamicResource PaddingCompact}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
