<UserControl x:Class="ProGlassAutomation.Inquiry.InquiryInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- PasswordBox has a distinct WPF control template and cannot
             inherit TextBox's template. Keep it on the same theme tokens,
             with a rounded field frame and the required PART_ContentHost. -->
        <Style x:Key="InboxPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          IsTabStop="False" Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InboxRefCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InboxCompanyCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InboxCountBadge" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page heading + primary actions ─────────────────────── -->
        <DockPanel Grid.Row="0" Margin="{DynamicResource PaddingPage}">
            <Button DockPanel.Dock="Right" Content="Check now"
                    Style="{DynamicResource PrimaryButton}"
                    Command="{Binding CheckNowCommand}"
                    Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Check the customer website now" />
            <Button DockPanel.Dock="Right" Content="Test connection" Style="{DynamicResource SubtleButton}"
                    Command="{Binding TestConnectionCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Test the website connection" />
            <Button DockPanel.Dock="Right" Content="← Register" Style="{DynamicResource SubtleButton}"
                    Command="{Binding BackCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Back to the inquiry register" />
            <StackPanel>
                <TextBlock Text="Customer inbox" Style="{DynamicResource PageHeading}" />
                <TextBlock Text="Inquiries arriving from the customer website — sync, review, then create local inquiries" Style="{DynamicResource Caption}" />
            </StackPanel>
        </DockPanel>

        <!-- ── Status strip ───────────────────────────────────────── -->
        <ContentControl Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionText}"
                               FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LastSyncText}" Style="{DynamicResource Caption}" />
                        <TextBlock Text="  ·  " Style="{DynamicResource Caption}" />
                        <TextBlock Text="{Binding AutoSyncText}" Style="{DynamicResource Caption}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource StatusBadge}" Tag="Information"
                            Margin="{DynamicResource MarginInline}">
                        <StackPanel Style="{StaticResource InboxCountBadge}">
                            <TextBlock Text="{Binding ReadyCount}"
                                       FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource StatusInformation}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" ready" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource StatusBadge}" Tag="Success"
                            Margin="{DynamicResource MarginInline}">
                        <StackPanel Style="{StaticResource InboxCountBadge}">
                            <TextBlock Text="{Binding IngestedCount}"
                                       FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource StatusSuccess}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" in register" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource StatusBadge}" Tag="Error"
                            Margin="{DynamicResource MarginInline}">
                        <StackPanel Style="{StaticResource InboxCountBadge}">
                            <TextBlock Text="{Binding FailedCount}"
                                       FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource StatusError}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" failed" Style="{DynamicResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- ── Website connection card ────────────────────────────── -->
        <ContentControl Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="{DynamicResource MarginItem}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Save connection" Style="{DynamicResource SubtleButton}"
                                Command="{Binding SaveSettingsCommand}" Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Save the website connection" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding SavedPasswordHint}" Style="{DynamicResource Caption}"
                                   ToolTip="{Binding SavedPasswordHint}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Website connection"
                                   FontSize="{DynamicResource FontSizeSection}"
                                   FontWeight="{DynamicResource FontWeightHeading}" />
                        <TextBlock Text="Desktop bridge credentials. Website operator sign-in uses email OTP; the bridge account must have a Supabase Auth password."
                                   Style="{DynamicResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Supabase URL" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. https://xxxx.supabase.co"
                                 AutomationProperties.Name="Supabase URL" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Supabase API key (anon or publishable)" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}"
                                   ToolTip="Use a public anon or publishable key. Never enter a service_role secret here." />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding AnonKey, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Supabase API key" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Bridge account email" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding BridgeEmail, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Bridge account email" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Bridge password" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}"
                                   ToolTip="Website operator sign-in uses an email OTP. The desktop bridge requires a Supabase Auth password." />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InboxPasswordBox}"
                                     ToolTip="Use the password set for the dedicated inquiry bridge account. An emailed OTP is not a password."
                                     AutomationProperties.Name="Dedicated inquiry bridge account password" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Inbox folder" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="0" MinWidth="{DynamicResource ControlMinWidth}"
                                 Text="{Binding InboxRoot, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Shared with the Node bridge (GLASS_INBOX_ROOT)"
                                 AutomationProperties.Name="Inbox folder" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Automatic check" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                      ItemsSource="{Binding PollMinutesOptions}"
                                      SelectedItem="{Binding PollMinutes}"
                                      Width="70" VerticalAlignment="Center"
                                      AutomationProperties.Name="Automatic check interval in minutes" />
                            <TextBlock Text="minute(s)" Style="{DynamicResource Caption}"
                                       VerticalAlignment="Center" Margin="{DynamicResource MarginInline}" />
                        </StackPanel>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                 Columns="4" VerticalAlignment="Center">
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="Desktop notifications" IsChecked="{Binding NotificationsEnabled}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Desktop notifications" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="With sound" IsChecked="{Binding NotificationSound}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  IsEnabled="{Binding NotificationsEnabled}"
                                  AutomationProperties.Name="Notification sound" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="Report status" IsChecked="{Binding ReportStatusToWebsite}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Report status to website"
                                  ToolTip="{Binding ReportStatusHint}" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}" Content="Sync website chat" IsChecked="{Binding SyncWebsiteChat}"
                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Sync website chat"
                                  ToolTip="{Binding ChatSyncHint}" />
                    </UniformGrid>
                </Grid>
                <TextBlock Grid.Row="2" Margin="{DynamicResource MarginItem}"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </ContentControl>

        <!-- ── Deliveries ─────────────────────────────────────────── -->
        <ContentControl Grid.Row="3" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="{DynamicResource MarginItem}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedErrorText}"
                                   Foreground="{DynamicResource StatusError}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource MarginInline}" />
                        <Button Content="Create local inquiry" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding IngestSelectedCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Create a local inquiry from the selected delivery" />
                        <Button Content="Open inquiry" Style="{DynamicResource SubtleButton}"
                                Command="{Binding OpenInquirySelectedCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Open the local inquiry for the selected delivery" />
                        <Button Content="Open folder" Style="{DynamicResource SubtleButton}"
                                Command="{Binding OpenFolderSelectedCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Open the delivery folder" />
                    </StackPanel>
                    <TextBlock Text="Website deliveries"
                               FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
                    <DataGrid Style="{DynamicResource {x:Type DataGrid}}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              AutomationProperties.Name="Website deliveries"
                              MouseDoubleClick="OnRowDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"
                                                ElementStyle="{StaticResource InboxRefCell}" />
                            <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="170"
                                                ElementStyle="{StaticResource InboxCompanyCell}" />
                            <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="160" />
                            <DataGridTextColumn Header="Prepared by" Binding="{Binding Estimator}" Width="130" />
                            <DataGridTextColumn Header="Files" Binding="{Binding DocumentsText}" Width="80"
                                                CanUserSort="False" />
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" Width="140" />
                            <DataGridTemplateColumn Header="State" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusBadge}" Tag="{Binding StateTag}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding State}" Style="{DynamicResource StatusText}"
                                                       Tag="{Binding StateTag}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Local inquiry" Binding="{Binding LocalNumber}" Width="130"
                                                ElementStyle="{StaticResource InboxRefCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No website deliveries yet"
                                   FontSize="{DynamicResource FontSizeSection}"
                                   FontWeight="{DynamicResource FontWeightHeading}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="When the customer website receives an inquiry, it appears here automatically — or press Check now."
                                   Style="{DynamicResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="{DynamicResource PaddingCompact}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
