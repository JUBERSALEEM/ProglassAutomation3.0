<UserControl x:Class="ProGlassAutomation.Inquiry.InquiryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- Status chip: BorderSubtle idle, AccentPrimary selected,
             TextOnAccent on the selected label. -->
        <Style x:Key="InquiryChipButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ChipCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StatePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Same geometry contract as the client register: the cell and header
             templates are owned here so the theme cannot paint a rule per cell
             (which boxed every data row). Alignment comes from the cell — a
             ContentControl, which really declares HorizontalContentAlignment —
             and the presenter carries it as FrameworkElement alignment through a
             TemplateBinding, because ContentPresenter has no such property of its
             own. Every colour stays a TemplateBinding. -->
        <Style x:Key="InquiryHeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="{DynamicResource SpacingMedium}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{DynamicResource TransparentBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryCell" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <!-- The view draws one hairline per column boundary and switches the
                 theme's header frame off: that frame is a package-wide control
                 weight (2px in Neumorphism, 4px in Claymorphism) and at that
                 weight a header reads as a boxed grid. -->
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True" />
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource InquiryHeaderGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource InquiryHeaderGripper}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryHeaderLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
        </Style>
        <Style x:Key="InquiryHeaderRule" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style x:Key="InquiryCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Filter dropdowns bind the active theme's implicit ComboBox style
             directly so changing themes replaces the template as well as its tokens. -->
        <Style x:Key="InquiryCustomerCell" TargetType="TextBlock"
               BasedOn="{StaticResource InquiryCellText}">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        </Style>
        <!-- ── Register reading rules ───────────────────────────────────
             Owner feedback: values sat hard against the column edges and read
             as left-aligned even when the eye expects them centred.

             A DataGridTextColumn hands its cell a full-width slot, but a
             template column (Status) hands it a content-sized one, so alignment
             belongs on the cell. The cell also ignores the themed Padding (the
             stock cell template does not bind it), so each value carries the
             theme's compact inset as a margin and trims with an ellipsis — a
             twelve-column register has no room for text that runs into its
             neighbour.

             Both derived styles keep the theme's own cell chrome, header
             template and resize grippers; the header is repainted in
             BorderStrong so each column has a visible edge, matching the client
             register. -->
        <Style x:Key="InquiryNumberCell" TargetType="TextBlock"
               BasedOn="{StaticResource InquiryCellText}">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        </Style>
        <Style x:Key="InquiryValueCell" TargetType="TextBlock"
               BasedOn="{StaticResource InquiryCellText}">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dashboard header: accent pipeline card, three compact KPIs, and actions. -->
        <Grid Grid.Row="0" Margin="{DynamicResource PaddingPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="2.55*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{DynamicResource HeroCard}"
                            Background="{DynamicResource AccentPrimary}"
                            Margin="{DynamicResource PaddingCompact}">
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="PROGLASS  ·  INQUIRIES" FontWeight="{DynamicResource FontWeightHeading}"
                               Foreground="{DynamicResource TextOnAccent}" />
                    <TextBlock Text="Filtered pipeline value" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextOnAccent}" Margin="{DynamicResource MarginInline}" />
                    <TextBlock Text="{Binding PipelineValueText}" FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="{DynamicResource FontWeightHeading}"
                               Foreground="{DynamicResource TextOnAccent}" Margin="{DynamicResource MarginInline}" />
                    <TextBlock Text="Cancelled inquiries excluded" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextOnAccent}" Margin="{DynamicResource MarginInline}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="1" Style="{DynamicResource MetricCard}" Margin="{DynamicResource PaddingCompact}">
                <StackPanel>
                    <TextBlock Text="Open" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding OpenCount}" FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <TextBlock Text="Received + prepared" Style="{DynamicResource Caption}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{DynamicResource MetricCard}" Margin="{DynamicResource PaddingCompact}">
                <StackPanel>
                    <TextBlock Text="Awaiting customer" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding AwaitingCount}" FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <TextBlock Text="Sent, waiting confirmation" Style="{DynamicResource Caption}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="3" Style="{DynamicResource MetricCard}" Margin="{DynamicResource PaddingCompact}">
                <StackPanel>
                    <TextBlock Text="Confirmed" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding ConfirmedCount}" FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <TextBlock Text="Ready to convert to PI" Style="{DynamicResource Caption}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="4" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingCompact}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="{DynamicResource PaddingCompact}">
                        <TextBlock Text="Actions" Style="{DynamicResource Caption}" />
                        <Button Content="＋  NEW INQUIRY" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding NewInquiryCommand}" HorizontalAlignment="Stretch"
                                Margin="{DynamicResource PaddingCompact}" AutomationProperties.Name="New inquiry" />
                    </StackPanel>
                    <!-- Equal thirds, then the long inbox action on its own row.
                         A WrapPanel sized every button to its label and dropped
                         the last one onto an orphan line, which read as a
                         collapsed stack of chips (owner feedback). -->
                    <Grid Grid.Row="1" Margin="{DynamicResource PaddingCompact}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="Refresh" Style="{DynamicResource SubtleButton}"
                                Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Stretch" Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Refresh register" />
                        <Button Grid.Row="0" Grid.Column="1" Content="Import" Style="{DynamicResource SubtleButton}"
                                Command="{Binding ImportCommand}"
                                HorizontalAlignment="Stretch" Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Import inquiries from CSV" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Export" Style="{DynamicResource SubtleButton}"
                                Command="{Binding ExportCommand}"
                                HorizontalAlignment="Stretch" Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Export inquiries to CSV" />
                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Content="Import from website inbox" Style="{DynamicResource SubtleButton}"
                                Command="{Binding OpenInboxCommand}"
                                HorizontalAlignment="Stretch" Margin="{DynamicResource MarginInline}"
                                ToolTip="Open accepted website deliveries, verify/download files, then create local inquiries."
                                AutomationProperties.Name="Open website inbox to import accepted deliveries" />
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- Full-width status segments. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusTabs}" Focusable="False"
                      Margin="{DynamicResource PaddingPage}" AutomationProperties.Name="Inquiry status filters">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource InquiryChipButton}"
                            Command="{Binding DataContext.SelectStatusTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Key}" Content="{Binding Label}"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Label}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Module strip; future modules are intentionally disabled until their views exist. -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding ModuleTabs}" Focusable="False"
                      Margin="{DynamicResource PaddingPage}" AutomationProperties.Name="Inquiry module navigation">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectModuleTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Key}" Content="{Binding Label}" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InquiryChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Single compact filter row, following the reference register layout. -->
        <ContentControl Grid.Row="3" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Search" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                    <TextBox Style="{DynamicResource {x:Type TextBox}}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by number, customer, project, salesman or preparer"
                             AutomationProperties.Name="Search inquiries" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Date" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              Margin="{DynamicResource MarginInline}"
                              MinWidth="{DynamicResource ControlMinWidth}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding DateRanges}"
                              SelectedItem="{Binding SelectedDateRange}"
                              AutomationProperties.Name="Received date range" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Salesman" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              Margin="{DynamicResource MarginInline}"
                              MinWidth="{DynamicResource ControlMinWidth}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Salesmen}"
                              SelectedItem="{Binding SelectedSalesman}"
                              AutomationProperties.Name="Filter by salesman" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Prepared by" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              Margin="{DynamicResource MarginInline}"
                              MinWidth="{DynamicResource ControlMinWidth}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding PreparedByUsers}"
                              SelectedItem="{Binding SelectedPreparedBy}"
                              AutomationProperties.Name="Filter by preparer" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Priority" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              Margin="{DynamicResource MarginInline}"
                              MinWidth="{DynamicResource ControlMinWidth}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Priorities}"
                              SelectedItem="{Binding SelectedPriority}"
                              AutomationProperties.Name="Filter by priority" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Sort order" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              Margin="{DynamicResource MarginInline}"
                              MinWidth="{DynamicResource ControlMinWidth}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              AutomationProperties.Name="Sort order" />
                </StackPanel>
                <CheckBox Grid.Column="6" Style="{DynamicResource {x:Type CheckBox}}"
                          Content="Has attachments" IsChecked="{Binding HasAttachmentsOnly}"
                          VerticalAlignment="Center" Margin="{DynamicResource MarginInline}"
                          AutomationProperties.Name="Only inquiries with attachments" />
                <Button Grid.Column="7" Content="Reset" Style="{DynamicResource SubtleButton}"
                        Command="{Binding ResetFiltersCommand}" Margin="{DynamicResource MarginInline}"
                        AutomationProperties.Name="Reset filters" />
            </Grid>
        </ContentControl>

        <!-- ── Register: error surface + data grid + empty state ──── -->
        <ContentControl Grid.Row="4" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource StatusErrorSurface}"
                        BorderBrush="{DynamicResource StatusError}"
                        BorderThickness="{DynamicResource BorderThicknessControl}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Margin="{DynamicResource MarginItem}" Padding="{DynamicResource PaddingControl}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                </Border>
                <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
                    <DataGrid Style="{DynamicResource {x:Type DataGrid}}"
                              ItemsSource="{Binding Inquiries}"
                              SelectedItem="{Binding SelectedInquiry, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              CellStyle="{StaticResource InquiryCell}"
                              GridLinesVisibility="None"
                              ColumnHeaderStyle="{StaticResource InquiryColumnHeader}"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              MinColumnWidth="{DynamicResource ControlMinWidth}"
                              AutomationProperties.Name="Inquiry register"
                              MouseDoubleClick="OnRowDoubleClick"
                              KeyDown="OnGridKeyDown">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="RowMenu">
                                <MenuItem Header="Open inquiry…"
                                          Command="{Binding DataContext.OpenInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Edit inquiry…"
                                          Command="{Binding DataContext.EditInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Change status">
                                    <MenuItem Header="Prepare"
                                              Command="{Binding DataContext.PrepareRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanPrepareWorkflow}" />
                                    <MenuItem Header="Send"
                                              Command="{Binding DataContext.SendRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanSendWorkflow}" />
                                    <MenuItem Header="Confirm"
                                              Command="{Binding DataContext.ConfirmRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanConfirmWorkflow}" />
                                    <MenuItem Header="Hold"
                                              Command="{Binding DataContext.HoldRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanHoldWorkflow}" />
                                    <MenuItem Header="Cancel inquiry"
                                              Command="{Binding DataContext.CancelRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanCancelWorkflow}" />
                                </MenuItem>
                                <MenuItem Header="Change priority">
                                    <MenuItem Header="Urgent"
                                              Command="{Binding DataContext.SetUrgentPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="High"
                                              Command="{Binding DataContext.SetHighPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Normal"
                                              Command="{Binding DataContext.SetNormalPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Low"
                                              Command="{Binding DataContext.SetLowPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Duplicate inquiry"
                                          Command="{Binding DataContext.DuplicateInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Delete inquiry"
                                          Command="{Binding DataContext.DeleteInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Copy inquiry number"
                                          Command="{Binding DataContext.CopyInquiryNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Copy summary"
                                          Command="{Binding DataContext.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Copy PI number"
                                          Command="{Binding DataContext.CopyProformaNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Lifecycle.HasProforma}" />
                                <MenuItem Header="Copy JO number"
                                          Command="{Binding DataContext.CopyJobOrderNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Lifecycle.HasJobOrder}" />
                                <MenuItem Header="Open attachments folder"
                                          Command="{Binding DataContext.OpenAttachmentsFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasAttachments}" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ContextMenu" Value="{DynamicResource RowMenu}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding InquiryNumber}"
                                                ElementStyle="{StaticResource InquiryNumberCell}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Inquiry" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding CustomerName}"
                                                ElementStyle="{StaticResource InquiryCustomerCell}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Customer" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Project}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Project" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Salesman}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Salesman" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding PreparedBy}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Prepared by" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="*" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Status" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusBadge}" Tag="{Binding StatusTag}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Style="{DynamicResource StatusText}"
                                                       Tag="{Binding StatusTag}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding ValueText}"
                                                ElementStyle="{StaticResource InquiryValueCell}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Value (AED)" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding ReceivedDateText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Received" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding UpdatedText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Updated" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding ProformaCellText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="PI" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding JobOrderCellText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="JO" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding AttachmentChipText}"
                                                ElementStyle="{StaticResource InquiryCellText}" CanUserSort="False">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Files" Style="{StaticResource InquiryHeaderLabel}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInquiries}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No inquiries match the current filters"
                                   FontSize="{DynamicResource FontSizeSection}"
                                   FontWeight="{DynamicResource FontWeightHeading}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Adjust the filters or create a new inquiry from the toolbar above."
                                   Style="{DynamicResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="{DynamicResource PaddingCompact}" />
                        <Button Content="New inquiry" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding NewInquiryCommand}"
                                HorizontalAlignment="Center"
                                Margin="{DynamicResource PaddingCompact}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ── Footer: status + pagination ────────────────────────── -->
        <DockPanel Grid.Row="5" Margin="{DynamicResource PaddingPage}">
            <Button DockPanel.Dock="Right" Content="Next page" Style="{DynamicResource SubtleButton}"
                    Command="{Binding NextPageCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Next page" />
            <Button DockPanel.Dock="Right" Content="Previous page" Style="{DynamicResource SubtleButton}"
                    Command="{Binding PreviousPageCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Previous page" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding PageIndicator}"
                       Style="{DynamicResource Caption}" VerticalAlignment="Center"
                       Margin="{DynamicResource MarginInline}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Loading…" VerticalAlignment="Center"
                           Margin="{DynamicResource MarginInline}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PageStatus}" Style="{DynamicResource Caption}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
