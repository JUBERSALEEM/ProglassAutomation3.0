<UserControl x:Class="ProGlassAutomation.Inquiry.InquiryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- Same geometry contract as the client register: the cell and header
             templates are owned here so the theme cannot paint a rule per cell
             (which boxed every data row). Alignment comes from the cell — a
             ContentControl, which really declares HorizontalContentAlignment —
             and the presenter carries it as FrameworkElement alignment through a
             TemplateBinding, because ContentPresenter has no such property of its
             own. Every colour stays a TemplateBinding. -->
        <Style x:Key="InquiryHeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="{DynamicResource SpacingMedium}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{DynamicResource TransparentBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryCell" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <!-- The view draws one hairline per column boundary and switches the
                 theme's header frame off: that frame is a package-wide control
                 weight (2px in Neumorphism, 4px in Claymorphism) and at that
                 weight a header reads as a boxed grid. -->
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True" />
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource InquiryHeaderGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource InquiryHeaderGripper}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InquiryHeaderLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
        </Style>
        <Style x:Key="InquiryHeaderRule" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style x:Key="InquiryCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Filter dropdowns bind the active theme's implicit ComboBox style
             directly so changing themes replaces the template as well as its tokens. -->
        <Style x:Key="InquiryCustomerCell" TargetType="TextBlock"
               BasedOn="{StaticResource InquiryCellText}">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        </Style>
        <!-- ── Register reading rules ───────────────────────────────────
             Owner feedback: values sat hard against the column edges and read
             as left-aligned even when the eye expects them centred.

             A DataGridTextColumn hands its cell a full-width slot, but a
             template column (Status) hands it a content-sized one, so alignment
             belongs on the cell. The cell also ignores the themed Padding (the
             stock cell template does not bind it), so each value carries the
             theme's compact inset as a margin and trims with an ellipsis — a
             twelve-column register has no room for text that runs into its
             neighbour.

             Both derived styles keep the theme's own cell chrome, header
             template and resize grippers; the header is repainted in
             BorderStrong so each column has a visible edge, matching the client
             register. -->
        <Style x:Key="InquiryNumberCell" TargetType="TextBlock"
               BasedOn="{StaticResource InquiryCellText}">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        </Style>
        <Style x:Key="InquiryValueCell" TargetType="TextBlock"
               BasedOn="{StaticResource InquiryCellText}">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── One command bar ─────────────────────────────────────────
             Owner direction: "apply same in inquiry page ... all received prepared
             sent confirmed etc move to dropdown single section. same for proforma
             invoice job order etc".

             What was here: a hero card carrying the pipeline value, three KPI
             cards, a fourth card of five buttons, then a full-width strip of
             seven status chips, then a strip of six module chips, then a card of
             seven filter controls - five rows of chrome before the first row of
             data. The register is the page; all of that is now one bar.

             Where everything went:
               pipeline value + 3 KPI counts  -> one caption line (no cards)
               seven status chips             -> the Status dropdown, with counts
               six module chips               -> the Module dropdown, planned
                                                 modules listed but inert
               five action buttons            -> NEW INQUIRY + one overflow menu
               seven filter controls          -> a Filters row that is collapsed
                                                 until asked for (the button
                                                 carries the active-filter count)

             Only contracted controls: Plate, Caption, ComboBox, TextBox, Button,
             PrimaryButton, SubtleButton, CheckBox, ContextMenu, MenuItem,
             ShellMark. No ComboBoxItem ItemContainerStyle is set, so the items
             keep taking their template from whichever package is active. -->
        <ContentControl Grid.Row="0" Style="{DynamicResource Plate}" Margin="{DynamicResource PaddingPage}">
            <Grid Margin="{DynamicResource PaddingCompact}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status: one dropdown instead of seven full-width chips. The
                     labels carry their own live count, so the register still says
                     how much sits in each state without spending a row on it. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Status" Style="{DynamicResource Caption}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              MinWidth="170"
                              ItemsSource="{Binding StatusTabs}"
                              SelectedItem="{Binding SelectedStatusTab, Mode=TwoWay}"
                              ToolTip="Filter by status"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Filter by status">
                        <!-- The closed box renders SelectionBoxItem through
                             SelectionBoxItemTemplate; DisplayMemberPath produces
                             no such template, so the box would print the type
                             name (ProGlassAutomation...InquiryStatusTab). -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LabelWithCount}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Module: the same dropdown idiom for the register set. A planned
                     module is listed and painted muted with a "(soon)" tag; the view
                     model refuses it in SelectedModuleTab and re-notifies on the
                     dispatcher, so the control snaps back instead of displaying a
                     module that is not routed anywhere. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="Module" Style="{DynamicResource Caption}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource MarginInline}" />
                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                              MinWidth="185"
                              ItemsSource="{Binding ModuleTabs}"
                              SelectedItem="{Binding SelectedModuleTab, Mode=TwoWay}"
                              ToolTip="Switch register"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Register module">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="  (soon)" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Pipeline and counts as one sentence, plus the active-filter
                     state, in the space the four cards used to take. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            Margin="{DynamicResource MarginInline}">
                    <TextBlock Style="{DynamicResource Caption}" TextWrapping="Wrap"
                               Margin="{DynamicResource MarginInline}">
                        <Run Text="Pipeline " />
                        <Run Text="{Binding PipelineValueText, Mode=OneWay}" FontWeight="{DynamicResource FontWeightHeading}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding OpenCount, Mode=OneWay}" />
                        <Run Text=" open  ·  " />
                        <Run Text="{Binding AwaitingCount, Mode=OneWay}" />
                        <Run Text=" awaiting  ·  " />
                        <Run Text="{Binding ConfirmedCount, Mode=OneWay}" />
                        <Run Text=" confirmed" />
                    </TextBlock>
                </StackPanel>

                <!-- One row of actions, every control on the same baseline. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

                    <Grid Width="240" VerticalAlignment="Center"
                          Margin="{DynamicResource MarginInline}">
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by number, customer, project, salesman or preparer"
                                 AutomationProperties.Name="Search inquiries" />
                        <TextBlock Text="Search inquiries…" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource PaddingCompact}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Advanced filters are one click away, never in the way. -->
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding ToggleFiltersCommand}"
                            Margin="{DynamicResource MarginInline}"
                            AutomationProperties.Name="Show or hide advanced filters">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Settings" Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FiltersToggleLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource PrimaryButton}"
                            Command="{Binding NewInquiryCommand}"
                            Margin="{DynamicResource MarginInline}"
                            AutomationProperties.Name="New inquiry">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Add" Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="NEW INQUIRY" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Files and refresh: frequent enough to keep one click away,
                         not frequent enough to own a row. -->
                    <Button Style="{DynamicResource SubtleButton}"
                            Content="⋯"
                            Click="OnMoreActionsClick"
                            ToolTip="More actions"
                            AutomationProperties.Name="More inquiry actions">
                        <Button.ContextMenu>
                            <ContextMenu Style="{DynamicResource {x:Type ContextMenu}}">
                                <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
                                <Separator />
                                <MenuItem Header="Import inquiries from CSV…" Command="{Binding ImportCommand}" />
                                <MenuItem Header="Export inquiries to CSV…" Command="{Binding ExportCommand}" />
                                <MenuItem Header="Import from website inbox…" Command="{Binding OpenInboxCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- ── Advanced filters: collapsed until asked for ───────────────
             Same seven controls the filter card held, in one row, with no card
             and no labels above each control - each one names itself in its
             tooltip and keeps its own placeholder text, so the row reads as a
             line of controls rather than a form. -->
        <Grid Grid.Row="1" Margin="{DynamicResource PaddingPage}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AreFiltersExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Style="{DynamicResource Plate}">
                <UniformGrid Rows="1" Margin="{DynamicResource PaddingCompact}">
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  Margin="{DynamicResource MarginInline}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding DateRanges}"
                                  SelectedItem="{Binding SelectedDateRange}"
                                  ToolTip="Received date range"
                                  AutomationProperties.Name="Received date range" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  Margin="{DynamicResource MarginInline}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Salesmen}"
                                  SelectedItem="{Binding SelectedSalesman}"
                                  ToolTip="Filter by salesman"
                                  AutomationProperties.Name="Filter by salesman" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  Margin="{DynamicResource MarginInline}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding PreparedByUsers}"
                                  SelectedItem="{Binding SelectedPreparedBy}"
                                  ToolTip="Filter by preparer"
                                  AutomationProperties.Name="Filter by preparer" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  Margin="{DynamicResource MarginInline}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Priorities}"
                                  SelectedItem="{Binding SelectedPriority}"
                                  ToolTip="Filter by priority"
                                  AutomationProperties.Name="Filter by priority" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  Margin="{DynamicResource MarginInline}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  ToolTip="Sort order"
                                  AutomationProperties.Name="Sort order" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                  Content="Has attachments" IsChecked="{Binding HasAttachmentsOnly}"
                                  VerticalAlignment="Center" Margin="{DynamicResource MarginInline}"
                                  AutomationProperties.Name="Only inquiries with attachments" />
                            <Button Content="Reset filters" Style="{DynamicResource SubtleButton}"
                                    Command="{Binding ResetFiltersCommand}" Margin="{DynamicResource MarginInline}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Reset filters" />
                </UniformGrid>
            </ContentControl>
        </Grid>

        <!-- ── Register: error surface + data grid + empty state ──── -->
        <ContentControl Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource PaddingPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource StatusErrorSurface}"
                        BorderBrush="{DynamicResource StatusError}"
                        BorderThickness="{DynamicResource BorderThicknessControl}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Margin="{DynamicResource MarginItem}" Padding="{DynamicResource PaddingControl}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                </Border>
                <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
                    <DataGrid Style="{DynamicResource {x:Type DataGrid}}"
                              ItemsSource="{Binding Inquiries}"
                              SelectedItem="{Binding SelectedInquiry, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              CellStyle="{StaticResource InquiryCell}"
                              GridLinesVisibility="None"
                              ColumnHeaderStyle="{StaticResource InquiryColumnHeader}"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              MinColumnWidth="{DynamicResource ControlMinWidth}"
                              AutomationProperties.Name="Inquiry register"
                              MouseDoubleClick="OnRowDoubleClick"
                              KeyDown="OnGridKeyDown">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="RowMenu">
                                <MenuItem Header="Open inquiry…"
                                          Command="{Binding DataContext.OpenInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Edit inquiry…"
                                          Command="{Binding DataContext.EditInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Change status">
                                    <MenuItem Header="Prepare"
                                              Command="{Binding DataContext.PrepareRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanPrepareWorkflow}" />
                                    <MenuItem Header="Send"
                                              Command="{Binding DataContext.SendRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanSendWorkflow}" />
                                    <MenuItem Header="Confirm"
                                              Command="{Binding DataContext.ConfirmRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanConfirmWorkflow}" />
                                    <MenuItem Header="Hold"
                                              Command="{Binding DataContext.HoldRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanHoldWorkflow}" />
                                    <MenuItem Header="Cancel inquiry"
                                              Command="{Binding DataContext.CancelRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanCancelWorkflow}" />
                                </MenuItem>
                                <MenuItem Header="Change priority">
                                    <MenuItem Header="Urgent"
                                              Command="{Binding DataContext.SetUrgentPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="High"
                                              Command="{Binding DataContext.SetHighPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Normal"
                                              Command="{Binding DataContext.SetNormalPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Low"
                                              Command="{Binding DataContext.SetLowPriorityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Duplicate inquiry"
                                          Command="{Binding DataContext.DuplicateInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Delete inquiry"
                                          Command="{Binding DataContext.DeleteInquiryRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Copy inquiry number"
                                          Command="{Binding DataContext.CopyInquiryNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Copy summary"
                                          Command="{Binding DataContext.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Copy PI number"
                                          Command="{Binding DataContext.CopyProformaNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Lifecycle.HasProforma}" />
                                <MenuItem Header="Copy JO number"
                                          Command="{Binding DataContext.CopyJobOrderNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding Lifecycle.HasJobOrder}" />
                                <MenuItem Header="Open attachments folder"
                                          Command="{Binding DataContext.OpenAttachmentsFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding HasAttachments}" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ContextMenu" Value="{DynamicResource RowMenu}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding InquiryNumber}"
                                                ElementStyle="{StaticResource InquiryNumberCell}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Inquiry" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding CustomerName}"
                                                ElementStyle="{StaticResource InquiryCustomerCell}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Customer" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Project}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Project" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Salesman}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Salesman" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding PreparedBy}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Prepared by" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="*" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Status" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusBadge}" Tag="{Binding StatusTag}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Style="{DynamicResource StatusText}"
                                                       Tag="{Binding StatusTag}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding ValueText}"
                                                ElementStyle="{StaticResource InquiryValueCell}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Value (AED)" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding ReceivedDateText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Received" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding UpdatedText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Updated" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding ProformaCellText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="PI" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding JobOrderCellText}"
                                                ElementStyle="{StaticResource InquiryCellText}">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="JO" Style="{StaticResource InquiryHeaderLabel}" />
                                        <Border Style="{StaticResource InquiryHeaderRule}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding AttachmentChipText}"
                                                ElementStyle="{StaticResource InquiryCellText}" CanUserSort="False">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <TextBlock Text="Files" Style="{StaticResource InquiryHeaderLabel}" />
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInquiries}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No inquiries match the current filters"
                                   Style="{DynamicResource SectionHeading}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Adjust the filters or create a new inquiry from the command bar above."
                                   Style="{DynamicResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="{DynamicResource PaddingCompact}" />
                        <Button Content="New inquiry" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding NewInquiryCommand}"
                                HorizontalAlignment="Center"
                                Margin="{DynamicResource PaddingCompact}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- ── Footer: status + pagination ────────────────────────── -->
        <DockPanel Grid.Row="3" Margin="{DynamicResource PaddingPage}">
            <Button DockPanel.Dock="Right" Content="Next page" Style="{DynamicResource SubtleButton}"
                    Command="{Binding NextPageCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Next page" />
            <Button DockPanel.Dock="Right" Content="Previous page" Style="{DynamicResource SubtleButton}"
                    Command="{Binding PreviousPageCommand}" Margin="{DynamicResource MarginInline}"
                    AutomationProperties.Name="Previous page" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding PageIndicator}"
                       Style="{DynamicResource Caption}" VerticalAlignment="Center"
                       Margin="{DynamicResource MarginInline}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Loading…" VerticalAlignment="Center"
                           Margin="{DynamicResource MarginInline}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PageStatus}" Style="{DynamicResource Caption}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
