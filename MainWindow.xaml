<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
        xmlns:inq="clr-namespace:ProGlassAutomation.Inquiry"
        Title="ProGlass Automation" Height="1000" Width="1700"
        MinHeight="{DynamicResource WindowMinHeight}" MinWidth="{DynamicResource WindowMinWidth}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Style="{DynamicResource ThemedWindow}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Focusable="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <DrawingImage x:Key="AppMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource AccentPrimary}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource TextOnAccent}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M9,7 L9,25 L12.4,25 L12.4,17.6 L16.4,17.6 C20.2,17.6 22.6,15.1 22.6,12.3 C22.6,9.5 20.2,7 16.4,7 Z M12.4,10 L16.2,10 C18.3,10 19.4,10.9 19.4,12.3 C19.4,13.7 18.3,14.6 16.2,14.6 L12.4,14.6 Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="ShellSidebar" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource StudioSidebarWidth}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSpatial}" Value="True">
                    <Setter Property="Margin" Value="{DynamicResource SpatialStagePad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSwiss}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                    <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHolographic}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HeroAccent}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellIconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellNavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <ContentControl Style="{DynamicResource Plate}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Focusable="False">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </ContentControl>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellExpanderCard" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ContentRow" Height="0" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Padding="{DynamicResource PaddingControl}" Cursor="Hand" FocusVisualStyle="{DynamicResource KeyboardFocus}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                                                <DockPanel>
                                                    <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False"><Setter TargetName="Arrow" Property="Text" Value="▸" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="{DynamicResource PaddingCompact}">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentRow" Property="Height" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLiquid}" Value="True" />
                        <Condition Binding="{Binding IsDark}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsGlass}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassFrostBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
        </Style>
        <Style x:Key="ShellModuleBanner" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="{DynamicResource MarginSection}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                <ContentControl Style="{DynamicResource Card}" Focusable="False">
                    <ContentPresenter />
                </ContentControl>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellBannerCluster" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                <ContentControl Style="{DynamicResource Plate}" Focusable="False">
                    <ContentPresenter />
                </ContentControl>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellBannerButton" TargetType="Button" BasedOn="{StaticResource ShellIconButton}">
            <Setter Property="MinHeight" Value="{DynamicResource FontSizeSection}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="ShellBannerRule" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Height" Value="{DynamicResource FontSizeSection}" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="ShellBody">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource ShellSidebar}">
            <ContentControl Style="{DynamicResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="{DynamicResource PaddingCompact}">
                    <Button DockPanel.Dock="Right" Content="◀◀" Command="{Binding ToggleMenu}" Style="{StaticResource ShellIconButton}" ToolTip="Hide menu" AutomationProperties.Name="Close menu" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" CornerRadius="{DynamicResource ChipCornerRadius}" Background="{DynamicResource AccentPrimary}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center">
                            <Image Source="{StaticResource AppMark}" Stretch="Uniform" Margin="{DynamicResource PaddingMark}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ProGlass Automation" FontWeight="{DynamicResource FontWeightHeading}" />
                            <TextBlock Text="Version 3.0" Style="{DynamicResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="{DynamicResource PaddingCompact}">
                        <Button Command="{Binding ShowBusiness}" AutomationProperties.Name="Home page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusiness}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsBusiness}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsBusiness}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsBusiness}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Home" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Business" Style="{StaticResource ShellSectionLabel}" FontWeight="{DynamicResource FontWeightHeading}" />
                        <Button Command="{Binding ShowInquiry}" AutomationProperties.Name="Inquiries page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInquiry}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsInquiry}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsInquiry}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsInquiry}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Inquiry" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Inquiries" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Settings" Style="{StaticResource ShellSectionLabel}" FontWeight="{DynamicResource FontWeightHeading}" />
                        <Button Command="{Binding ShowStudio}" AutomationProperties.Name="Theme Studio page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStudio}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsStudio}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsStudio}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsStudio}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Theme" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Theme Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowTexts}" AutomationProperties.Name="Texts Studio page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTexts}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsTexts}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsTexts}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsTexts}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Texts" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Texts Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowColors}" AutomationProperties.Name="Colors Studio page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsColors}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsColors}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsColors}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsColors}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Colors" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Colors Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowIcons}" AutomationProperties.Name="Icons Studio page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIcons}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsIcons}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsIcons}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsIcons}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Marks" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Icons Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowPages}" AutomationProperties.Name="Pages Studio page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPages}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsPages}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsPages}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsPages}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Layout" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Pages Studio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowAbout}" AutomationProperties.Name="About page">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShellNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAbout}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSwiss}" Value="True" />
                                                <Condition Binding="{Binding IsAbout}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsHolographic}" Value="True" />
                                                <Condition Binding="{Binding IsAbout}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeroAccent}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGlass}" Value="True" />
                                                <Condition Binding="{Binding IsAbout}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource GlassFrostElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="About" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="About" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="ProGlass Automation · Version 3.0" Style="{StaticResource ShellSectionLabel}" />
            </Grid>
            </ContentControl>
        </Border>
        <Grid Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSpatial}" Value="True">
                            <Setter Property="Margin" Value="{DynamicResource SpatialWorkspacePad}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" Style="{StaticResource ShellModuleBanner}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="{DynamicResource ControlMinHeight}" Margin="{DynamicResource PaddingCompact}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <studio:ShellMark Title="{Binding WorkspaceTitle}" Category="settings" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding WorkspaceTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" />
                            <TextBlock Text="{Binding WorkspaceSubtitle}" Style="{DynamicResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ContentControl Grid.Column="2" Style="{StaticResource ShellBannerCluster}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShellClock}" Style="{DynamicResource Caption}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <Border Style="{StaticResource ShellBannerRule}" />
                            <Button Content="Home" Command="{Binding ShowBusiness}" Style="{StaticResource ShellBannerButton}" ToolTip="Home" AutomationProperties.Name="Go home" />
                            <Border Style="{StaticResource ShellBannerRule}" />
                            <Button Content="Dark" Command="{Binding ToggleAppearance}" Style="{StaticResource ShellBannerButton}" AutomationProperties.Name="Toggle appearance" />
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </ContentControl>
            <TabControl Grid.Row="1" x:Name="WorkspaceTabs"
                        SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay}"
                        AutomationProperties.Name="Design workspace pages"
                        BorderThickness="0">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Background" Value="{DynamicResource ApplicationBackground}" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiquid}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGlass}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSpatial}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                <Setter Property="ClipToBounds" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="_Theme Studio"><studio:ThemeStudioView /></TabItem>
                <TabItem Header="_Home"><studio:BusinessReferenceView /></TabItem>
                <TabItem Header="_Inquiries"><inq:InquiryWorkspaceView /></TabItem>
                <TabItem Header="_Texts Studio"><studio:TextsStudioView /></TabItem>
                <TabItem Header="_Colors Studio"><studio:ColorsStudioView /></TabItem>
                <TabItem Header="_About"><studio:AboutView /></TabItem>
                <TabItem Header="_Icons Studio"><studio:IconsStudioView /></TabItem>
                <TabItem Header="_Pages Studio"><studio:PagesStudioView /></TabItem>
            </TabControl>
        </Grid>
        <Button Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Content="☰" Command="{Binding ToggleMenu}" ToolTip="Open menu" AutomationProperties.Name="Toggle menu" Panel.ZIndex="2" Margin="{DynamicResource PaddingPage}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ShellIconButton}">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        </Grid>
        <Grid x:Name="SpotlightScrim" Visibility="Collapsed" IsHitTestVisible="True">
            <Border x:Name="SpotlightSnap" />
            <Border Background="{DynamicResource ApplicationBackground}" Opacity="0.35" />
        </Grid>
    </Grid>
</Window>
