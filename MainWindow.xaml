<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
        xmlns:inq="clr-namespace:ProGlassAutomation.Inquiry"
        xmlns:cli="clr-namespace:ProGlassAutomation.Clients"
        xmlns:usr="clr-namespace:ProGlassAutomation.Users"
        xmlns:cmp="clr-namespace:ProGlassAutomation.Company" xmlns:prj="clr-namespace:ProGlassAutomation.Projects" xmlns:pi="clr-namespace:ProGlassAutomation.Proforma"
        Title="ProGlass Automation" Height="1000" Width="1700"
        MinHeight="{DynamicResource WindowMinHeight}" MinWidth="{DynamicResource WindowMinWidth}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Style="{DynamicResource ThemedWindow}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Focusable="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <DrawingImage x:Key="AppMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource AccentPrimary}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource TextOnAccent}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M9,7 L9,25 L12.4,25 L12.4,17.6 L16.4,17.6 C20.2,17.6 22.6,15.1 22.6,12.3 C22.6,9.5 20.2,7 16.4,7 Z M12.4,10 L16.2,10 C18.3,10 19.4,10.9 19.4,12.3 C19.4,13.7 18.3,14.6 16.2,14.6 L12.4,14.6 Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="ShellSidebar" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource StudioSidebarWidth}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Width" Value="0" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSpatial}" Value="True">
                    <Setter Property="Margin" Value="{DynamicResource SpatialStagePad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSwiss}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHolographic}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HeroAccent}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellIconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Shown only while the sidebar is collapsed. -->
        <Style x:Key="ShellMenuToggleButton" TargetType="Button"
               BasedOn="{StaticResource ShellIconButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuOpen}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellNavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <ContentControl Style="{DynamicResource Plate}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Focusable="False">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </ContentControl>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellExpanderCard" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ContentRow" Height="0" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Padding="{DynamicResource PaddingControl}" Cursor="Hand" FocusVisualStyle="{DynamicResource KeyboardFocus}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
                                                <DockPanel>
                                                    <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False"><Setter TargetName="Arrow" Property="Text" Value="▸" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="{DynamicResource PaddingCompact}">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentRow" Property="Height" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLiquid}" Value="True" />
                        <Condition Binding="{Binding IsDark}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsGlass}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassFrostBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
        </Style>
        <Style x:Key="ShellModuleBanner" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="{DynamicResource MarginSection}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                <ContentControl Style="{DynamicResource Card}" Focusable="False">
                    <ContentPresenter />
                </ContentControl>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShellBannerCluster" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
                <ContentControl Style="{DynamicResource Plate}" Focusable="False">
                    <ContentPresenter />
                </ContentControl>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- MinHeight was bound to FontSizeSection, i.e. a font size used as a
             control height (16 px). HOME and DARK were therefore shorter than the
             clock beside them, with their own text clipping out of the box. A
             control height comes from ControlMinHeight, which is what that token
             is for. -->
        <Style x:Key="ShellBannerButton" TargetType="Button" BasedOn="{StaticResource ShellIconButton}">
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="ShellBannerRule" TargetType="Border">
            <Setter Property="Width" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Height" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="ShellBody">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Shell chrome: three stable zones keep the workspace title centred
             independently of the variable-width operator/session controls. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" MinHeight="64"
                Background="{DynamicResource SurfacePrimary}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="{DynamicResource PaddingCompact}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Button Content="&#x2630;" Command="{Binding ToggleMenu}"
                            Style="{StaticResource ShellIconButton}"
                            Margin="{DynamicResource UiGapControl}" VerticalAlignment="Center"
                            ToolTip="Hide or show the menu" AutomationProperties.Name="Toggle menu" />
                    <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}"
                            CornerRadius="{DynamicResource ChipCornerRadius}" Background="{DynamicResource AccentPrimary}"
                            Margin="{DynamicResource UiGapControl}" VerticalAlignment="Center">
                        <studio:ShellMark Kind="Marks" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}"
                                          Foreground="{DynamicResource TextOnAccent}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass" Style="{DynamicResource SectionHeading}"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0" />
                        <Border Margin="{DynamicResource UiGapControl}" Padding="{DynamicResource PaddingCompact}"
                                CornerRadius="{DynamicResource ChipCornerRadius}" Background="{DynamicResource SurfaceSecondary}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}"
                                VerticalAlignment="Center">
                            <TextBlock Text="SUITE" Style="{DynamicResource Caption}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="{DynamicResource MarginInline}" MaxWidth="300">
                    <studio:ShellMark Title="{Binding WorkspaceTitle}" Width="{DynamicResource ChoiceMarkSize}"
                                      Height="{DynamicResource ChoiceMarkSize}" Foreground="{DynamicResource AccentPrimary}"
                                      Margin="{DynamicResource UiGapControl}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WorkspaceTitle}" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="{DynamicResource FontSizeSection}" FontWeight="{DynamicResource FontWeightHeading}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding WorkspaceSubtitle}" Style="{DynamicResource Caption}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Border Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource PaddingCompact}" Margin="{DynamicResource UiGapControlEnd}">
                        <StackPanel x:Name="SessionBanner" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" MaxWidth="112">
                                <TextBlock Text="OPERATOR" Style="{DynamicResource Caption}" FontSize="10" />
                                <TextBlock Text="{Binding SessionLabel}" ToolTip="{Binding SessionTooltip}"
                                           FontWeight="{DynamicResource FontWeightHeading}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                            <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                    Style="{StaticResource ShellBannerButton}" Margin="{DynamicResource UiGapControl}"
                                    AutomationProperties.Name="{Binding ActionAccessibleName}" ToolTip="{Binding ActionTooltip}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ShellClock}" Style="{DynamicResource Caption}"
                               VerticalAlignment="Center" Margin="{DynamicResource MarginInline}" ToolTip="Local time" />
                    <Button Content="&#x263E;" Command="{Binding ToggleAppearance}"
                            Style="{StaticResource ShellIconButton}" Margin="{DynamicResource UiGapControlEnd}"
                            VerticalAlignment="Center" ToolTip="Switch light and dark"
                            AutomationProperties.Name="Switch light and dark" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ShellSidebar}">
            <ContentControl Style="{DynamicResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="{DynamicResource PaddingCompact}">
                        <studio:ShellNavEntry Command="{Binding ShowBusiness}" IsSelected="{Binding IsBusiness}" Mark="Home" Label="Home" AutomationProperties.Name="Home page" />
                        <TextBlock Text="Business" Style="{StaticResource ShellSectionLabel}" FontWeight="{DynamicResource FontWeightHeading}" />
                        <studio:ShellNavEntry Command="{Binding ShowInquiry}" IsSelected="{Binding IsInquiry}" Mark="Inquiry" Label="Inquiries" AutomationProperties.Name="Inquiries page" />
                        <!-- step2 — Client Management. Same nav pattern as Inquiries;
                             the workspace index (8) is appended so existing
                             workspace indexes keep their meaning. -->
                        <studio:ShellNavEntry Command="{Binding ShowClients}" IsSelected="{Binding IsClients}" Mark="Work" Label="Clients" AutomationProperties.Name="Clients page" />
                        <!-- step3 — User Management. Same nav pattern as Inquiries;
                             the workspace index (9) is appended for the same
                             reason: every earlier index keeps its meaning. -->
                        <studio:ShellNavEntry Command="{Binding ShowUsers}" IsSelected="{Binding IsUsers}" Mark="Author" Label="Users" AutomationProperties.Name="Users page" />
                        <studio:ShellNavEntry Command="{Binding ShowProjects}" IsSelected="{Binding IsProjects}" Mark="Engineering" Label="Projects" AutomationProperties.Name="Projects page" />
                        <studio:ShellNavEntry Command="{Binding ShowProforma}" IsSelected="{Binding IsProforma}" Mark="Work" Label="Proforma" AutomationProperties.Name="Proforma invoice page" />
                        <TextBlock Text="Settings" Style="{StaticResource ShellSectionLabel}" FontWeight="{DynamicResource FontWeightHeading}" />
                        <!-- step4 — Company Profile (index 10); it describes this installation, not records. -->
                        <studio:ShellNavEntry Command="{Binding ShowCompany}" IsSelected="{Binding IsCompany}" Mark="Settings" Label="Company" AutomationProperties.Name="Company page" />
                        <studio:ShellNavEntry Command="{Binding ShowStudio}" IsSelected="{Binding IsStudio}" Mark="Theme" Label="Theme Studio" AutomationProperties.Name="Theme Studio page" />
                        <studio:ShellNavEntry Command="{Binding ShowTexts}" IsSelected="{Binding IsTexts}" Mark="Texts" Label="Texts Studio" AutomationProperties.Name="Texts Studio page" />
                        <studio:ShellNavEntry Command="{Binding ShowColors}" IsSelected="{Binding IsColors}" Mark="Colors" Label="Colors Studio" AutomationProperties.Name="Colors Studio page" />
                        <studio:ShellNavEntry Command="{Binding ShowIcons}" IsSelected="{Binding IsIcons}" Mark="Marks" Label="Icons Studio" AutomationProperties.Name="Icons Studio page" />
                        <studio:ShellNavEntry Command="{Binding ShowPages}" IsSelected="{Binding IsPages}" Mark="Layout" Label="Pages Studio" AutomationProperties.Name="Pages Studio page" />
                        <studio:ShellNavEntry Command="{Binding ShowAbout}" IsSelected="{Binding IsAbout}" Mark="About" Label="About" AutomationProperties.Name="About page" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="ProGlass Automation · Version 3.0" Style="{StaticResource ShellSectionLabel}" />
            </Grid>
            </ContentControl>
        </Border>
        <Grid Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="{DynamicResource PaddingCompact}" />
                    <!-- Structural guarantee: the content region cannot paint over
                         the sidebar column. Spatial is the one theme that bleeds
                         on purpose, so it opts out explicitly. -->
                    <Setter Property="ClipToBounds" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSpatial}" Value="True">
                            <Setter Property="Margin" Value="{DynamicResource SpatialWorkspacePad}" />
                            <Setter Property="ClipToBounds" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0" x:Name="WorkspaceTabs"
                        SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay}"
                        AutomationProperties.Name="Design workspace pages"
                        BorderThickness="0">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Background" Value="{DynamicResource ApplicationBackground}" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiquid}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGlass}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSpatial}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                <Setter Property="ClipToBounds" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="_Theme Studio"><studio:ThemeStudioView /></TabItem>
                <TabItem Header="_Home"><studio:BusinessReferenceView /></TabItem>
                <TabItem Header="_Inquiries"><inq:InquiryWorkspaceView /></TabItem>
                <TabItem Header="_Texts Studio"><studio:TextsStudioView /></TabItem>
                <TabItem Header="_Colors Studio"><studio:ColorsStudioView /></TabItem>
                <TabItem Header="_About"><studio:AboutView /></TabItem>
                <TabItem Header="_Icons Studio"><studio:IconsStudioView /></TabItem>
                <TabItem Header="_Pages Studio"><studio:PagesStudioView /></TabItem>
                <TabItem Header="_Clients"><cli:ClientWorkspaceView /></TabItem>
                <TabItem Header="_Users"><usr:UserWorkspaceView /></TabItem>
                <!-- step4 (10) Company · step5 (11) Projects · step6 (12) Proforma -->
                <TabItem Header="_Company"><cmp:CompanyProfileView /></TabItem>
                <TabItem Header="_Projects"><prj:ProjectWorkspaceView /></TabItem>
                <TabItem Header="_Proforma"><pi:ProformaWorkspaceView /></TabItem>
            </TabControl>
        </Grid>
        </Grid>
        <Grid x:Name="SpotlightScrim" Visibility="Collapsed" IsHitTestVisible="True">
            <Border x:Name="SpotlightSnap" />
            <Border Background="{DynamicResource ApplicationBackground}" Opacity="0.35" />
        </Grid>
        <!-- ── Sign-in gate ─────────────────────────────────────────────
             Every user has a password (owner instruction 2026-10-27), so the
             shell is unusable until one has been verified: no repository write
             can resolve an actor before this gate hands the session over.
             It is declared under the first-run gate, so an installation that
             still has no users at all is set up first. -->
        <usr:SignInView x:Name="SignInGate" Visibility="Collapsed" />

        <!-- ── First-run gate ───────────────────────────────────────────
             A database with no users cannot be administered, and telling the
             operator to "ask an administrator" on a fresh install is circular.
             This overlay is the way out: it shows the Windows account the
             workstation already runs under and registers it as the first
             Administrator. It is declared last so it covers the shell, and its
             own dimmed background swallows clicks, so nothing behind it can be
             used while setup is pending.

             Visibility is decided in MainWindow.xaml.cs from
             FirstRunViewModel.InitializeAsync, which asks IFirstRunService — the
             same service the Users page uses, so there is one implementation of
             the flow, not two. -->
        <usr:FirstRunSetupView x:Name="FirstRunGate" Visibility="Collapsed" />

    </Grid>
</Window>
