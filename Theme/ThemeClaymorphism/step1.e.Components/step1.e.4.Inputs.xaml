<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:clay="clr-namespace:ProGlassAutomation.ThemeClaymorphism" xmlns:input="clr-namespace:ProGlassAutomation.Customization">
 <Style TargetType="TextBox">
  <Setter Property="input:TextBoxFocusBehavior.SelectAllOnFocus" Value="True" />
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
  <Setter Property="SelectionTextBrush" Value="{DynamicResource TextPrimary}" />
  <Setter Property="SelectionOpacity" Value="{DynamicResource SelectionOpacity}" />
  <Setter Property="SelectionBrush" Value="{DynamicResource StateSelected}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Validation.ErrorTemplate"><Setter.Value><ControlTemplate>
   <AdornedElementPlaceholder />
  </ControlTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <clay:ClaySurface x:Name="Frame" Rank="Control" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <ScrollViewer x:Name="PART_ContentHost" />
   </clay:ClaySurface>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Frame" Property="ShadeBrush" Value="{DynamicResource StatusError}" /><Setter TargetName="Frame" Property="LightBrush" Value="{DynamicResource StatusError}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledSurface}" /><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
  <Style TargetType="PasswordBox">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Validation.ErrorTemplate"><Setter.Value><ControlTemplate>
   <AdornedElementPlaceholder />
  </ControlTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
   <clay:ClaySurface x:Name="Frame" Rank="Control" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" IsTabStop="False" />
   </clay:ClaySurface>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Frame" Property="ShadeBrush" Value="{DynamicResource StatusError}" /><Setter TargetName="Frame" Property="LightBrush" Value="{DynamicResource StatusError}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledSurface}" /><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="Row" Background="{DynamicResource TransparentBrush}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="2,2,0,0">
    <Border x:Name="Shade" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="0" CornerRadius="{DynamicResource ChipCornerRadius}"><ContentPresenter /></Border>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource StateSelected}" /><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ClayInsetLightBrush}" /><Setter TargetName="Shade" Property="BorderBrush" Value="{DynamicResource ClayInsetShadeBrush}" /><Setter TargetName="Shade" Property="BorderThickness" Value="0,0,2,2" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource SurfaceElevated}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <clay:ClaySurface x:Name="Frame" Rank="Control" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ChipCornerRadius}" Padding="{TemplateBinding Padding}">
     <Grid>
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border Background="{DynamicResource TransparentBrush}"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" /></Border>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="0,0,24,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
    <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="0,0,24,0"
             Visibility="Hidden" Focusable="True"
             Background="Transparent" Foreground="{TemplateBinding Foreground}"
             CaretBrush="{TemplateBinding Foreground}" BorderThickness="0" Padding="0"
             FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
             FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center"
             IsReadOnly="{TemplateBinding IsReadOnly}" />
     </Grid>
    </clay:ClaySurface>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
     <clay:ClaySurface Rank="Card" Background="{DynamicResource SurfaceElevated}" CornerRadius="{DynamicResource ControlCornerRadius}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
      <ScrollViewer MaxHeight="{DynamicResource PopupMaxHeight}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
     </clay:ClaySurface>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
   <Trigger Property="IsEditable" Value="True">
    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
   </Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /><Setter TargetName="Frame" Property="Background" Value="{DynamicResource DisabledSurface}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
