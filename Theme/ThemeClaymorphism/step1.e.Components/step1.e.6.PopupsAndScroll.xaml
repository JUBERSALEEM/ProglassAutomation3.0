<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:clay="clr-namespace:ProGlassAutomation.ThemeClaymorphism">
 <Style TargetType="ToolTip">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  <Setter Property="MaxWidth" Value="{DynamicResource PopupMaxWidth}" />
  <Setter Property="HasDropShadow" Value="True" />
  <Setter Property="Placement" Value="Bottom" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
   <clay:ClaySurface Rank="Control" Background="{TemplateBinding Background}" Padding="{DynamicResource PaddingPlate}"
                    MaxWidth="{TemplateBinding MaxWidth}" CornerRadius="{DynamicResource ControlCornerRadius}"><ContentPresenter>
     <ContentPresenter.Resources>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="Wrap" />
       <Setter Property="TextTrimming" Value="None" />
       <Setter Property="TextAlignment" Value="Left" />
      </Style>
     </ContentPresenter.Resources>
    </ContentPresenter></clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ContextMenu">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <clay:ClaySurface Rank="Card" Background="{DynamicResource SurfaceElevated}" Padding="{DynamicResource PaddingCompact}" CornerRadius="{DynamicResource ControlCornerRadius}"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" /></clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Border x:Name="Frame" Background="{DynamicResource TransparentBrush}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ChipCornerRadius}" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="2,2,0,0">
    <Border x:Name="Shade" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="0" CornerRadius="{DynamicResource ChipCornerRadius}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" /></Border>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ClayInsetLightBrush}" /><Setter TargetName="Shade" Property="BorderBrush" Value="{DynamicResource ClayInsetShadeBrush}" /><Setter TargetName="Shade" Property="BorderThickness" Value="0,0,2,2" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource TransparentBrush}" /></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Thumb">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <clay:ClaySurface x:Name="Grip" Rank="Chip" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource ChipCornerRadius}" />
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Lifted" Value="True" /></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="{DynamicResource ScrollBarSize}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <clay:ClaySurface Concave="True" Rank="Chip" Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" /></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="{DynamicResource ChoiceMarkSize}" /></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" /></Track.IncreaseRepeatButton>
    </Track>
   </clay:ClaySurface>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
   <Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="{DynamicResource ScrollBarSize}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <clay:ClaySurface Concave="True" Rank="Chip" Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ChipCornerRadius}">
     <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollPageButton}" /></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinWidth="{DynamicResource ChoiceMarkSize}" /></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollPageButton}" /></Track.IncreaseRepeatButton>
     </Track>
    </clay:ClaySurface>
   </ControlTemplate></Setter.Value></Setter>
  </Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
