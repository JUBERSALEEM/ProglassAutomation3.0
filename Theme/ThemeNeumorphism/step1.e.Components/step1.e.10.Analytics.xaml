<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:analytics="clr-namespace:ProGlassAutomation.Analytics" xmlns:neu="clr-namespace:ProGlassAutomation.ThemeNeumorphism">
 <Style x:Key="ChartCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="Margin" Value="{DynamicResource MarginPanel}" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <neu:NeumorphSurface Rank="Card" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}">
    <ContentPresenter />
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PositivePlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}" />
 <Style x:Key="FeaturePlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}" />
 <Style x:Key="InformationPlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}" />
 <Style x:Key="AttentionPlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}" />
 <Style TargetType="analytics:BentoChart">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  <Setter Property="Series1" Value="{DynamicResource ChartSeries1}" />
  <Setter Property="Series2" Value="{DynamicResource ChartSeries2}" />
  <Setter Property="Series3" Value="{DynamicResource ChartSeries3}" />
  <Setter Property="Series4" Value="{DynamicResource ChartSeries4}" />
  <Setter Property="AxisBrush" Value="{DynamicResource ChartAxis}" />
  <Setter Property="GridBrush" Value="{DynamicResource ChartGrid}" />
  <Setter Property="TooltipSurface" Value="{DynamicResource ChartTooltipSurface}" />
  <Setter Property="TooltipText" Value="{DynamicResource ChartTooltipText}" />
  <Setter Property="PlotHeight" Value="{DynamicResource ChartPlotHeight}" />
  <Setter Property="LineWidth" Value="{DynamicResource ChartLineWidth}" />
  <Setter Property="PointSize" Value="{DynamicResource ChartPointSize}" />
  <Setter Property="DonutRadius" Value="{DynamicResource ChartDonutRadius}" />
  <Setter Property="CenterFontSize" Value="{DynamicResource FontSizeTitle}" />
  <Setter Property="AreaOpacity" Value="{DynamicResource ChartAreaOpacity}" />
 </Style>
 <Style TargetType="analytics:BentoKpi">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="analytics:BentoKpi">
   <neu:NeumorphSurface x:Name="Pod" Rank="Card" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource CardCornerRadius}">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*" MinWidth="72" MaxWidth="96"/>
     </Grid.ColumnDefinitions>
     <StackPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
      <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="ValueText" Text="{TemplateBinding Value}" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="{DynamicResource FontWeightHeading}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{TemplateBinding Detail}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
     </StackPanel>
     <analytics:BentoChart x:Name="SparkPlot" Grid.Column="1" Data="{Binding Spark, RelativeSource={RelativeSource TemplatedParent}}" ShowAxis="False" ShowGrid="False" ShowLegend="False" VerticalAlignment="Stretch" Margin="{DynamicResource PaddingCompact}" />
    </Grid>
   </neu:NeumorphSurface>
   <ControlTemplate.Triggers>
    <Trigger Property="Tag" Value="Positive"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusSuccess}" /></Trigger>
    <Trigger Property="Tag" Value="Feature"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource AccentSecondary}" /></Trigger>
    <Trigger Property="Tag" Value="Attention"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusWarning}" /></Trigger>
    <DataTrigger Binding="{Binding Spark, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"><Setter TargetName="SparkPlot" Property="Visibility" Value="Collapsed" /></DataTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="DataGrid">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" /><Setter Property="BorderThickness" Value="0" />
  <Setter Property="RowBackground" Value="{DynamicResource SurfacePrimary}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource TransparentBrush}" /><Setter Property="GridLinesVisibility" Value="None" />
  <Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" />
  <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" />
  <Setter Property="RowHeaderWidth" Value="0" /><Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
  <Setter Property="MinRowHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="ColumnHeaderHeight" Value="{DynamicResource ControlMinHeight}" />
 </Style>
 <Style TargetType="DataGridColumnHeader">
  <!-- The band's template, and the reason it exists: `HorizontalContentAlignment`
      on a header style does NOT centre this label in this app — the header on
      screen stayed flush left in a build whose style said "centre", while the
      cells, which centre by a TextBlock inside a stretched presenter, were
      correct. So the label is centred the way the cells are: a full-width
      presenter, and a TextBlock style inside it that says TextAlignment=Center
      and FontWeight=Bold. Anything the header renders as text — a plain string
      or a rich element — is covered, and no inheritance has to be right.
      The sort mark is drawn over the trailing edge so it cannot shift the
      centre, and the grippers let the column still be resized by hand. -->
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
   <Grid>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="True">
      <ContentPresenter.Resources>
       <Style TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
       </Style>
      </ContentPresenter.Resources>
     </ContentPresenter>
    </Border>
    <TextBlock x:Name="SortMark" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
               FontSize="{DynamicResource FontSizeCaption}" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="{DynamicResource SpacingSmall}" Cursor="SizeWE" Background="{DynamicResource TransparentBrush}" />
    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="{DynamicResource SpacingSmall}" Cursor="SizeWE" Background="{DynamicResource TransparentBrush}" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortMark" Property="Text" Value="&#x2191;" /></Trigger>
    <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortMark" Property="Text" Value="&#x2193;" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="Bold" />
 </Style>
 <Style TargetType="DataGridRow">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="DataGridCell">
  <Setter Property="Background" Value="{DynamicResource TransparentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /></Trigger></Style.Triggers>
 </Style>

 <!-- ════════ The list-page pattern (docs/10.List-Page-Pattern.md) ════════
      Every module register uses these keys and nothing of its own, so a new
      page inherits the whole pattern instead of re-deriving it: a ruled header
      band, centred and bold; a body with no grid lines, centred and evenly
      spaced; equal column widths; and a tooltip that reveals a value the cell
      had to trim. Every value is a DynamicResource token, so the pattern
      repaints on a live theme switch and no page carries a colour.
      Keys are defined in this file rather than a new one because each style
      builds on the implicit DataGrid style above it, and a StaticResource may
      only name a key defined in the same dictionary. -->
 <!-- The header band: bold, centred, ruled along the column edges.
      No hand-written template. The framework's header template lays the label out
      with the header's own HorizontalContentAlignment, which is the mechanism the
      master app uses (ErpDataGridColumnHeaderStyle: HCA=Center, FontWeight=Bold,
      BorderThickness 0,0,1,1) and which centres the label with no inheritance to
      get wrong. A re-created template centred a box and left the text where it
      was — twice. FontWeight is the literal Bold, not FontWeightHeading, because
      that token resolves to SemiBold and the owner's complaint is precisely that
      the heading is not bold. -->
 <Style x:Key="ListColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
  <Setter Property="Background" Value="{DynamicResource SurfaceInformation}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontWeight" Value="Bold" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  <Setter Property="BorderThickness" Value="0,0,1,1" />
 </Style>

 <!-- The body cell draws no border at all: the register is read as rows, not as
      a spreadsheet. The template binds every colour, so the theme still owns
      background, selection and the focus ring. -->
 <Style x:Key="ListCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
  <Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridCell">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
             SnapsToDevicePixels="True">
      <!-- Stretch, not the cell's HorizontalContentAlignment. A centred
           presenter shrinks to the text, so a stretched TextBlock inside it
           cannot be any wider than its own glyphs and TextAlignment=Center has
           nothing to centre inside — the value renders at the left edge with no
           error anywhere. Full width for the presenter, centring for the text,
           and a chip or a button centres itself. -->
      <ContentPresenter HorizontalAlignment="Stretch"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        SnapsToDevicePixels="True" />
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- The register itself. ColumnWidth="*" is what gives every column the same
      width, so no module has to guess a pixel count that its own text might
      outgrow. -->
 <Style x:Key="ListGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="AutoGenerateColumns" Value="False" />
  <Setter Property="IsReadOnly" Value="True" />
  <Setter Property="CanUserAddRows" Value="False" />
  <Setter Property="CanUserDeleteRows" Value="False" />
  <Setter Property="CanUserResizeRows" Value="False" />
  <Setter Property="HeadersVisibility" Value="Column" />
  <Setter Property="GridLinesVisibility" Value="None" />
  <Setter Property="ColumnWidth" Value="*" />
  <Setter Property="MinColumnWidth" Value="{DynamicResource ControlMinWidth}" />
  <Setter Property="SelectionMode" Value="Single" />
  <Setter Property="SelectionUnit" Value="FullRow" />
  <Setter Property="CellStyle" Value="{StaticResource ListCell}" />
  <Setter Property="ColumnHeaderStyle" Value="{StaticResource ListColumnHeader}" />
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
 </Style>

 <!-- A register value: centred, trimmed when it does not fit, and one hover
      away from its full text. -->

 <!-- The value bubble: what a register shows when a cell had to trim its text.
      It is a ToolTip, so it is opened by the tooltip service and needs no code
      to place or dismiss, but it is styled here rather than left to Windows:
      default tooltips are system-drawn and ignore the theme entirely, which on a
      dark package puts a light grey box over a dark register.

      Width is capped by PopupMaxWidth and the text wraps, so a long client name
      becomes two readable lines instead of a strip as wide as the screen. --> <!-- The value: centred over the whole column, trimmed at its edge, and its
      full text available on hover. The tooltip is a BINDING, the master app's
      pattern (TextTrimming="CharacterEllipsis" ToolTip="{Binding …}"), not a
      behaviour: nothing measures, nothing intercepts the mouse, nothing allocates
      on hover, and the bubble appears immediately with the whole value. Round 53's
      version measured every cell on layout and on enter — that is what made the
      pointer feel slow — and could throw from the tooltip service. -->
 <Style x:Key="ListText" TargetType="TextBlock">
  <Setter Property="TextAlignment" Value="Center" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
 </Style>
 <Style x:Key="ListMonoText" TargetType="TextBlock" BasedOn="{StaticResource ListText}">
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
 </Style>
 <Style x:Key="ListStrongText" TargetType="TextBlock" BasedOn="{StaticResource ListText}">
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
 </Style>
</ResourceDictionary>
