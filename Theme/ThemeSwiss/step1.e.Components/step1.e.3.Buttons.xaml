<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
  <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
  <Setter Property="MinWidth" Value="{DynamicResource ControlMinWidth}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
    <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True">
    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusIndicator}" />
    <Setter TargetName="Frame" Property="BorderThickness" Value="{DynamicResource FocusThickness}" />
   </Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource StatePressed}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledSurface}" /><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentPressed}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledSurface}" /><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource StatusErrorSurface}" />
  <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
  <Setter Property="BorderBrush" Value="{DynamicResource StatusError}" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StatusErrorSurface}" /><Setter Property="BorderThickness" Value="{DynamicResource FocusThickness}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource StatusErrorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledSurface}" /><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
