<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:analytics="clr-namespace:ProGlassAutomation.Analytics" xmlns:list="clr-namespace:ProGlassAutomation.Customization">
 <Style x:Key="ChartCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="Margin" Value="{DynamicResource MarginPanel}" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="{TemplateBinding Padding}">
    <ContentPresenter />
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PositivePlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /></Style>
 <Style x:Key="FeaturePlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /></Style>
 <Style x:Key="InformationPlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /></Style>
 <Style x:Key="AttentionPlate" TargetType="ContentControl" BasedOn="{StaticResource ChartCard}"><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /></Style>
 <Style TargetType="analytics:BentoChart">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  <Setter Property="Series1" Value="{DynamicResource ChartSeries1}" />
  <Setter Property="Series2" Value="{DynamicResource ChartSeries2}" />
  <Setter Property="Series3" Value="{DynamicResource ChartSeries3}" />
  <Setter Property="Series4" Value="{DynamicResource ChartSeries4}" />
  <Setter Property="AxisBrush" Value="{DynamicResource ChartAxis}" />
  <Setter Property="GridBrush" Value="{DynamicResource ChartGrid}" />
  <Setter Property="TooltipSurface" Value="{DynamicResource ChartTooltipSurface}" />
  <Setter Property="TooltipText" Value="{DynamicResource ChartTooltipText}" />
  <Setter Property="PlotHeight" Value="{DynamicResource ChartPlotHeight}" />
  <Setter Property="LineWidth" Value="{DynamicResource ChartLineWidth}" />
  <Setter Property="PointSize" Value="{DynamicResource ChartPointSize}" />
  <Setter Property="DonutRadius" Value="{DynamicResource ChartDonutRadius}" />
  <Setter Property="CenterFontSize" Value="{DynamicResource FontSizeTitle}" />
  <Setter Property="AreaOpacity" Value="{DynamicResource ChartAreaOpacity}" />
 </Style>
 <Style TargetType="analytics:BentoKpi">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="analytics:BentoKpi">
   <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource CardCornerRadius}">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*" MinWidth="72" MaxWidth="96"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
      <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="ValueText" Text="{TemplateBinding Value}" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="{DynamicResource FontWeightHeading}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{TemplateBinding Detail}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
     </StackPanel>
     <analytics:BentoChart x:Name="SparkPlot" Grid.Column="1" Data="{Binding Spark, RelativeSource={RelativeSource TemplatedParent}}" ShowAxis="False" ShowGrid="False" ShowLegend="False" VerticalAlignment="Stretch" Margin="{DynamicResource PaddingCompact}" />
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Tag" Value="Positive"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusSuccess}" /></Trigger>
    <Trigger Property="Tag" Value="Feature"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource AccentSecondary}" /></Trigger>
    <Trigger Property="Tag" Value="Attention"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusWarning}" /></Trigger>
    <DataTrigger Binding="{Binding Spark, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"><Setter TargetName="SparkPlot" Property="Visibility" Value="Collapsed" /></DataTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="DataGrid">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="RowBackground" Value="{DynamicResource SurfacePrimary}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceSecondary}" />
  <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
  <Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" />
  <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" />
  <Setter Property="RowHeaderWidth" Value="0" /><Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
  <Setter Property="MinRowHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="ColumnHeaderHeight" Value="{DynamicResource ControlMinHeight}" />
 </Style>
 <Style x:Key="BentoColumnGripper" TargetType="Thumb">
  <Setter Property="Width" Value="{DynamicResource SpacingMedium}" /><Setter Property="Cursor" Value="SizeWE" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource TransparentBrush}" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource BorderStrong}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="DataGridColumnHeader">
  <Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
   <Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
    <DockPanel><TextBlock x:Name="SortMark" DockPanel.Dock="Right" FontSize="{DynamicResource FontSizeCaption}" Foreground="{TemplateBinding Foreground}" /><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" /></DockPanel>
   </Border><Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource BentoColumnGripper}" HorizontalAlignment="Left" /><Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource BentoColumnGripper}" HorizontalAlignment="Right" /></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortMark" Property="Text" Value=" ↑" /></Trigger><Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortMark" Property="Text" Value=" ↓" /></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Setter Property="Background" Value="{DynamicResource SurfaceInformation}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" /><Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
 </Style>
 <Style TargetType="DataGridRow">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource StateSelected}" /></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="DataGridCell">
  <Setter Property="Background" Value="{DynamicResource TransparentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource StateSelected}" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /></Trigger></Style.Triggers>
 </Style>

 <!-- ════════ The list-page pattern (docs/10.List-Page-Pattern.md) ════════
      Every module register uses these keys and nothing of its own, so a new
      page inherits the whole pattern instead of re-deriving it: a ruled header
      band, centred and bold; a body with no grid lines, centred and evenly
      spaced; equal column widths; and a tooltip that reveals a value the cell
      had to trim. Every value is a DynamicResource token, so the pattern
      repaints on a live theme switch and no page carries a colour.
      Keys are defined in this file rather than a new one because each style
      builds on the implicit DataGrid style above it, and a StaticResource may
      only name a key defined in the same dictionary. -->
 <Style x:Key="ListHeaderGripper" TargetType="Thumb">
  <Setter Property="Width" Value="{DynamicResource SpacingMedium}" />
  <Setter Property="Cursor" Value="SizeWE" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="Grip" Background="{DynamicResource TransparentBrush}" />
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Grip" Property="Background" Value="{DynamicResource BorderStrong}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- The header band: bold, centred, ruled on the right and along the bottom,
      so the columns are divided where the labels are and nowhere else. -->
 <Style x:Key="ListColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
  <Setter Property="Background" Value="{DynamicResource SurfaceInformation}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridColumnHeader">
     <Grid>
      <Border x:Name="Band" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         RecognizesAccessKey="True" SnapsToDevicePixels="True" />
      </Border>
      <Border HorizontalAlignment="Right" Width="{DynamicResource StrokeWidth}"
              Background="{DynamicResource BorderStrong}" SnapsToDevicePixels="True" />
      <Border VerticalAlignment="Bottom" Height="{DynamicResource StrokeWidth}"
              Background="{DynamicResource BorderStrong}" SnapsToDevicePixels="True" />
      <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ListHeaderGripper}" />
      <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ListHeaderGripper}" />
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Band" Property="Background" Value="{DynamicResource StateHover}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- The body cell draws no border at all: the register is read as rows, not as
      a spreadsheet. The template binds every colour, so the theme still owns
      background, selection and the focus ring. -->
 <Style x:Key="ListCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
  <Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridCell">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
             SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        SnapsToDevicePixels="True" />
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- The register itself. ColumnWidth="*" is what gives every column the same
      width, so no module has to guess a pixel count that its own text might
      outgrow. -->
 <Style x:Key="ListGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="AutoGenerateColumns" Value="False" />
  <Setter Property="IsReadOnly" Value="True" />
  <Setter Property="CanUserAddRows" Value="False" />
  <Setter Property="CanUserDeleteRows" Value="False" />
  <Setter Property="CanUserResizeRows" Value="False" />
  <Setter Property="HeadersVisibility" Value="Column" />
  <Setter Property="GridLinesVisibility" Value="None" />
  <Setter Property="ColumnWidth" Value="*" />
  <Setter Property="MinColumnWidth" Value="{DynamicResource ControlMinWidth}" />
  <Setter Property="SelectionMode" Value="Single" />
  <Setter Property="SelectionUnit" Value="FullRow" />
  <Setter Property="CellStyle" Value="{DynamicResource ListCell}" />
  <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ListColumnHeader}" />
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
 </Style>

 <!-- A register value: centred, trimmed when it does not fit, and one hover
      away from its full text. -->

 <!-- The value bubble: what a register shows when a cell had to trim its text.
      It is a ToolTip, so it is opened by the tooltip service and needs no code
      to place or dismiss, but it is styled here rather than left to Windows:
      default tooltips are system-drawn and ignore the theme entirely, which on a
      dark package puts a light grey box over a dark register.

      Width is capped by PopupMaxWidth and the text wraps, so a long client name
      becomes two readable lines instead of a strip as wide as the screen. -->
 <Style x:Key="ListBubble" TargetType="ToolTip">
  <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="MaxWidth" Value="{DynamicResource PopupMaxWidth}" />
  <Setter Property="HasDropShadow" Value="True" />
  <Setter Property="Placement" Value="Bottom" />
  <Setter Property="HorizontalOffset" Value="0" />
  <Setter Property="VerticalOffset" Value="0" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToolTip">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
             Padding="{TemplateBinding Padding}" MaxWidth="{TemplateBinding MaxWidth}" SnapsToDevicePixels="True">
      <ContentPresenter>
       <ContentPresenter.Resources>
        <!-- The bubble's own text: body size, normal weight, wrapped. The cell's
             centred-and-trimmed style must not leak into the popup, or the full
             value would itself be trimmed at the bubble's edge. -->
        <Style TargetType="TextBlock">
         <Setter Property="TextWrapping" Value="Wrap" />
         <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
         <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
         <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
         <Setter Property="TextTrimming" Value="None" />
         <Setter Property="TextAlignment" Value="Left" />
        </Style>
       </ContentPresenter.Resources>
      </ContentPresenter>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ListText" TargetType="TextBlock">
  <Setter Property="TextAlignment" Value="Center" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  <Setter Property="list:TruncatedTextToolTip.Enabled" Value="True" />
 </Style>
 <Style x:Key="ListMonoText" TargetType="TextBlock" BasedOn="{StaticResource ListText}">
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
 </Style>
 <Style x:Key="ListStrongText" TargetType="TextBlock" BasedOn="{StaticResource ListText}">
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
 </Style>
</ResourceDictionary>
