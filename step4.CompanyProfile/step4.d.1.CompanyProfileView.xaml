<UserControl x:Class="ProGlassAutomation.Company.CompanyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             xmlns:cmp="clr-namespace:ProGlassAutomation.Company"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step4 — Company Profile. Compact ERP page (owner-approved mockup 10).

         Structure, top to bottom — one page, three bands:
           1. HEADER. Title, one-line subtitle, and on the right the live state
              chip ("Saved 09:02" / "Unsaved changes" / "Not set up yet") beside
              the primary action. Save is reachable without scrolling.
           2. BODY. One scroll region. Left: the form card, fields in a 3-per-row
              grid (2-per-row where a value is long). Right: a fixed 300 px card
              holding the letterhead preview, the three placement tiles, the
              printed-size picker and the logo file chip.
           3. FOOTER. Sticky strip: who may edit on the left, Revert + Save on the
              right. The page therefore never ends in dead space.

         Spacing is ONE system, the mockup's 8 px grid:
           inside a control 8 · between fields 12 · between sections 16 ·
           between the two cards 16 · page inset 24.
         Every one of those numbers is a shared token (MarginItem, MarginSection,
         UiGapGroup, UiGapCluster, PaddingPage) — none is typed into an element.
         That is what makes horizontal and vertical gaps agree, which is what was
         wrong with the previous page.

         Theme rules obeyed here (docs/00 §A–J, step1.d.11):
           • every colour, brush, metric, radius and font comes from the shared
             contract through DynamicResource — no literals;
           • theme-owned roles (Card / Plate / PrimaryButton / SubtleButton) are
             looked up dynamically, never captured statically;
           • TextBox and ComboBox bind the active implicit style, so a theme
             switch replaces the template as well as the tokens;
           • no Canvas, no absolute placement, no negative margins, exactly one
             scroll region, horizontal scrolling disabled;
           • the three placements are one radio group rendered as equal tiles, so
             a three-way choice reads as a segmented control rather than three
             loose radio buttons with uneven gaps.

         The letterhead mock is the SAME identity in the chosen composition, so
         the placement choice is visible rather than two words in a list, and
         every image is Stretch="Uniform" so no logo can be distorted.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Styles live in step4.d.3: the page is markup for one screen,
                     the styles are a separate part. Merged here so every
                     StaticResource below resolves exactly as it did when the
                     two sat in one 950-line file. -->
                <ResourceDictionary Source="step4.d.3.CompanyProfileStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 1. HEADER ═══════════════════════════════════════════════
             Title on the left, state and the primary action on the right. The
             action lives here so Save is always one click away, however long
             the form gets. -->
        <Grid Grid.Row="0" Margin="{DynamicResource PaddingPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Company"
                           FontSize="{DynamicResource FontSizeSection}"
                           FontWeight="{DynamicResource FontWeightHeading}"
                           Foreground="{DynamicResource TextPrimary}"
                           AutomationProperties.Name="Company profile" />
                <TextBlock Text="Settings · Company profile, contact details and logo"
                           Style="{StaticResource CompanyHint}"
                           AutomationProperties.Name="Company profile subtitle" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- The chip states the truth: saved (with the time), unsaved, or
                     never set up. The long sentence stays in ProfileStateText and
                     is shown in the footer, so the header stays one line high. -->
                <Border Style="{StaticResource CompanyStateChip}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        ToolTip="{Binding ProfileStateText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource CompanyStateDot}" />
                        <TextBlock Text="{Binding HeaderStateText}"
                                   Style="{StaticResource CompanyStateText}"
                                   AutomationProperties.Name="Company profile state text" />
                    </StackPanel>
                </Border>

                <Button Style="{DynamicResource SubtleButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        ToolTip="Read the saved profile again"
                        AutomationProperties.Name="Reload the company profile">
                    <studio:ShellMark Kind="Refresh" Width="{DynamicResource ChoiceMarkSize}"
                                      Height="{DynamicResource ChoiceMarkSize}" />
                </Button>

                <Button Style="{DynamicResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        IsEnabled="{Binding CanSave}"
                        ToolTip="Save the company profile"
                        AutomationProperties.Name="Save the company profile">
                    <TextBlock Text="Save company" />
                </Button>
            </WrapPanel>
        </Grid>

        <!-- ══ 2. BODY ═════════════════════════════════════════════════
             One scroll region for the whole page. The form card is the star
             column; the 300 px panel is fixed because its content (a sheet mock,
             three tiles, a picker, a chip) has a known bound. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{DynamicResource PaddingPage}">
            <Grid x:Name="BodyGrid"
                  SizeChanged="OnBodySizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── The form card ─────────────────────────────────── -->
                <ContentControl x:Name="FormCard"
                                Grid.Column="0"
                                Grid.Row="0"
                                Style="{DynamicResource Card}"
                                Padding="{DynamicResource UiCardPadding}"
                                Margin="{DynamicResource UiGapCluster}"
                                VerticalAlignment="Top">
                    <StackPanel>
                        <!-- The read-only reason is printed ONCE, in the footer
                             sentence (FooterNote). It used to appear here as well,
                             so the same line ran twice on one screen (owner
                             screenshot, round 30b). The footer is sticky, so the
                             reason is still on screen beside the disabled form. -->

                        <!-- Refused save: the sentence names what to fix. -->
                        <Border Background="{DynamicResource StatusErrorSurface}"
                                BorderBrush="{DynamicResource StatusError}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginSection}"
                                Visibility="{Binding HasError, Converter={StaticResource CompanyVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Style="{StaticResource CompanyHint}"
                                       Foreground="{DynamicResource StatusError}"
                                       AutomationProperties.Name="Company profile error" />
                        </Border>

                        <!-- Saved. -->
                        <Border Background="{DynamicResource StatusSuccessSurface}"
                                BorderBrush="{DynamicResource StatusSuccess}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginSection}"
                                Visibility="{Binding HasStatus, Converter={StaticResource CompanyVisibility}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource CompanyHint}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       AutomationProperties.Name="Company profile saved" />
                        </Border>

                        <!-- ── Business identity ────────────────────────── -->
                        <TextBlock Text="Business identity"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Business identity section" />
                        <Border Style="{StaticResource CompanyHairline}" />

                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Company name *" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="The registered business name"
                                         AutomationProperties.Name="Company name" />
                                <TextBlock Text="{Binding CompanyNameError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company name error"
                                           Visibility="{Binding HasCompanyNameError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource UiGapFieldInline}">
                                <TextBlock Text="TRN" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Trn, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="20"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="15-digit UAE Tax Registration Number"
                                         AutomationProperties.Name="Company TRN" />
                                <TextBlock Text="15 digits. Optional, but required on a tax invoice."
                                           Style="{StaticResource CompanyHint}" />
                                <TextBlock Text="{Binding TrnError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company TRN error"
                                           Visibility="{Binding HasTrnError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Address" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="300"
                                         MinHeight="{DynamicResource ControlMinHeight}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Street, area, city, country — as printed"
                                         AutomationProperties.Name="Company address" />
                                <TextBlock Text="Separate lines are kept. This is the address the letterhead prints."
                                           Style="{StaticResource CompanyHint}" />
                                <TextBlock Text="{Binding AddressError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company address error"
                                           Visibility="{Binding HasAddressError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- ── Representative and contact ─────────────────── -->
                        <TextBlock Text="Representative and contact"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Representative and contact section" />
                        <Border Style="{StaticResource CompanyHairline}" />

                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Representative" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding RepresentativeName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="The person who signs company documents"
                                         AutomationProperties.Name="Representative name" />
                                <TextBlock Text="{Binding RepresentativeNameError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Representative name error"
                                           Visibility="{Binding HasRepresentativeNameError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                        Margin="{DynamicResource UiGapFieldInline}">
                                <TextBlock Text="Mobile" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding RepresentativeMobile, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Mobile number printed under the representative"
                                         AutomationProperties.Name="Representative mobile" />
                                <TextBlock Text="{Binding RepresentativeMobileError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Representative mobile error"
                                           Visibility="{Binding HasRepresentativeMobileError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                                        Margin="{DynamicResource UiGapFieldInline}">
                                <TextBlock Text="E-mail" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="The address a client replies to"
                                         AutomationProperties.Name="Company e-mail" />
                                <TextBlock Text="{Binding EmailError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company e-mail error"
                                           Visibility="{Binding HasEmailError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Telephone" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="40"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Landline or switchboard"
                                         AutomationProperties.Name="Company telephone" />
                                <TextBlock Text="{Binding TelephoneError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company telephone error"
                                           Visibility="{Binding HasTelephoneError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource UiGapFieldInline}">
                                <TextBlock Text="Website" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Printed under the contact details"
                                         AutomationProperties.Name="Company website" />
                                <TextBlock Text="{Binding WebsiteError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company website error"
                                           Visibility="{Binding HasWebsiteError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- ── Banking ─────────────────────────────────────── -->
                        <TextBlock Text="Banking"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Banking section" />
                        <Border Style="{StaticResource CompanyHairline}" />

                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Bank name" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="For example Emirates NBD"
                                         AutomationProperties.Name="Bank name" />
                                <TextBlock Text="{Binding BankNameError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Bank name error"
                                           Visibility="{Binding HasBankNameError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource UiGapFieldInline}">
                                <TextBlock Text="Account number / IBAN" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="80"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Account number or IBAN, with or without spaces"
                                         AutomationProperties.Name="Account number or IBAN" />
                                <TextBlock Text="Two fields, so the bank and the account stay separable."
                                           Style="{StaticResource CompanyHint}" />
                                <TextBlock Text="{Binding AccountNumberError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Account number error"
                                           Visibility="{Binding HasAccountNumberError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>

                <!-- ── The logo and letterhead panel ─────────────────── -->
                <ContentControl x:Name="LogoPanel"
                                Grid.Column="1"
                                Grid.Row="0"
                                Style="{DynamicResource Card}"
                                Padding="{DynamicResource UiCardPadding}"
                                Width="300"
                                VerticalAlignment="Top">
                    <cmp:CompanyLogoPanel />
                </ContentControl>
            </Grid>
        </ScrollViewer>

        <!-- ══ 3. FOOTER ═══════════════════════════════════════════════
             Sticky, full width, aligned to the same page inset as the cards, so
             the page never trails off into empty space and the actions are in the
             same place at every scroll position. -->
        <ContentControl Grid.Row="2"
                        Style="{DynamicResource Plate}"
                        Margin="{DynamicResource PaddingPage}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FooterNote}"
                           Style="{StaticResource CompanyHint}"
                           AutomationProperties.Name="Who may edit this profile" />
                <TextBlock Text="{Binding UnsavedText}"
                           Style="{StaticResource CompanyHint}"
                           Foreground="{DynamicResource StatusWarning}"
                           AutomationProperties.Name="Unsaved changes"
                           Visibility="{Binding HasUnsavedNotice, Converter={StaticResource CompanyVisibility}}" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{DynamicResource SubtleButton}"
                        Command="{Binding RevertCommand}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        IsEnabled="{Binding HasUnsavedChanges}"
                        ToolTip="Discard the changes on this page and reload the saved profile"
                        AutomationProperties.Name="Revert unsaved changes">
                    <TextBlock Text="Revert" />
                </Button>
                <Button Style="{DynamicResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        IsEnabled="{Binding CanSave}"
                        ToolTip="Save the company profile"
                        AutomationProperties.Name="Save the company profile from the footer">
                    <TextBlock Text="Save company" />
                </Button>
            </WrapPanel>
        </Grid>
        </ContentControl>
    </Grid>
</UserControl>
