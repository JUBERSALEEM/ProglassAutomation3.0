<UserControl x:Class="ProGlassAutomation.Company.CompanyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step4 — Company Profile. Compact ERP page (owner-approved mockup 10).

         Structure, top to bottom — one page, three bands:
           1. HEADER. Title, one-line subtitle, and on the right the live state
              chip ("Saved 09:02" / "Unsaved changes" / "Not set up yet") beside
              the primary action. Save is reachable without scrolling.
           2. BODY. One scroll region. Left: the form card, fields in a 3-per-row
              grid (2-per-row where a value is long). Right: a fixed 300 px card
              holding the letterhead preview, the three placement tiles, the
              printed-size picker and the logo file chip.
           3. FOOTER. Sticky strip: who may edit on the left, Revert + Save on the
              right. The page therefore never ends in dead space.

         Spacing is ONE system, the mockup's 8 px grid:
           inside a control 8 · between fields 12 · between sections 16 ·
           between the two cards 16 · page inset 24.
         Every one of those numbers is a shared token (MarginItem, MarginSection,
         UiGapGroup, UiGapCluster, PaddingPage) — none is typed into an element.
         That is what makes horizontal and vertical gaps agree, which is what was
         wrong with the previous page.

         Theme rules obeyed here (docs/00 §A–J, step1.d.11):
           • every colour, brush, metric, radius and font comes from the shared
             contract through DynamicResource — no literals;
           • theme-owned roles (Card / Plate / PrimaryButton / SubtleButton) are
             looked up dynamically, never captured statically;
           • TextBox and ComboBox bind the active implicit style, so a theme
             switch replaces the template as well as the tokens;
           • no Canvas, no absolute placement, no negative margins, exactly one
             scroll region, horizontal scrolling disabled;
           • the three placements are one radio group rendered as equal tiles, so
             a three-way choice reads as a segmented control rather than three
             loose radio buttons with uneven gaps.

         The letterhead mock is the SAME identity in the chosen composition, so
         the placement choice is visible rather than two words in a list, and
         every image is Stretch="Uniform" so no logo can be distorted.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <!-- Visibility from a boolean, expressed without a Style:
             `BasedOn` is a plain CLR property on Style, not a dependency
             property, so `BasedOn="{DynamicResource ...}"` throws
             XamlParseException at load. -->
        <BooleanToVisibilityConverter x:Key="CompanyVisibility" />

        <!-- ── Header state chip ──────────────────────────────────────
             One chip, three states, styled by DataTrigger. The colour is the
             theme's own status surface, so it reads correctly in all nine
             packages and in both modes. -->
        <Style x:Key="CompanyStateChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeaderSaved}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessSurface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeaderDirty}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StatusWarningSurface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompanyStateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeaderSaved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeaderDirty}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The dot beside the state text carries the same colour as the chip. -->
        <Style x:Key="CompanyStateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="{DynamicResource ChoiceMarkSize}" />
            <Setter Property="Height" Value="{DynamicResource ChoiceMarkSize}" />
            <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeaderSaved}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource StatusSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeaderDirty}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource StatusWarning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Section heading ────────────────────────────────────────
             Caption + hairline rule, the dense pattern from the mockup: the rule
             does the separating, so a section costs 16 px, not a new card. -->
        <Style x:Key="CompanySectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
        </Style>

        <Style x:Key="CompanyHairline" TargetType="Border">
            <Setter Property="Height" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
        </Style>

        <!-- Field label: the field's name, above its own box, at every width.
             Stacked labels are what keep the three-per-row grid readable when
             the window narrows. -->
        <Style x:Key="CompanyFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
        </Style>

        <Style x:Key="CompanyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
        </Style>

        <!-- A validation message sits directly under its own field, in the
             theme's error colour, and disappears as the field is corrected. -->
        <Style x:Key="CompanyFieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
        </Style>

        <!-- ── Placement tile ─────────────────────────────────────────
             A three-way choice rendered as three equal tiles instead of three
             radio buttons: selected takes the accent border and the accent
             surface, the way the mockup shows it. It is still a RadioButton, so
             the group, the keyboard behaviour and the accessible name are the
             platform's own. -->
        <Style x:Key="CompanyPlacementTile" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile"
                                Background="{DynamicResource SurfaceSecondary}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingCompact}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimary}" />
                                <Setter TargetName="Tile" Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tile" Property="Opacity"
                                        Value="{DynamicResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompanyTileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
        </Style>

        <!-- The little diagram inside a placement tile. It is drawn from theme
             brushes, never from an image, so it recolours with the package. -->
        <Style x:Key="CompanyTileDiagram" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingMark}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
        </Style>

        <Style x:Key="CompanyTileLogoBlock" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
        </Style>

        <Style x:Key="CompanyTileTextLine" TargetType="Border">
            <Setter Property="Height" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
        </Style>

        <!-- ── Letterhead mock ───────────────────────────────────────
             The sheet the identity will print on. Primary surface inside a
             hairline, so it reads as paper on any theme without a fixed white. -->
        <Style x:Key="CompanySheet" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingControl}" />
            <Setter Property="Margin" Value="{DynamicResource MarginSection}" />
        </Style>

        <Style x:Key="CompanySheetName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CompanySheetLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ── File chip ─────────────────────────────────────────────
             Thumbnail, name, size — one row, the mockup's file chip. It shows
             the PICKED file before a save and the stored asset after it. -->
        <Style x:Key="CompanyFileChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
        </Style>

        <Style x:Key="CompanyFileName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 1. HEADER ═══════════════════════════════════════════════
             Title on the left, state and the primary action on the right. The
             action lives here so Save is always one click away, however long
             the form gets. -->
        <Grid Grid.Row="0" Margin="{DynamicResource PaddingPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Company"
                           FontSize="{DynamicResource FontSizeSection}"
                           FontWeight="{DynamicResource FontWeightHeading}"
                           Foreground="{DynamicResource TextPrimary}"
                           AutomationProperties.Name="Company profile" />
                <TextBlock Text="Settings · Company profile, contact details and logo"
                           Style="{StaticResource CompanyHint}"
                           AutomationProperties.Name="Company profile subtitle" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- The chip states the truth: saved (with the time), unsaved, or
                     never set up. The long sentence stays in ProfileStateText and
                     is shown in the footer, so the header stays one line high. -->
                <Border Style="{StaticResource CompanyStateChip}"
                        Margin="{DynamicResource MarginInline}"
                        ToolTip="{Binding ProfileStateText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource CompanyStateDot}" />
                        <TextBlock Text="{Binding HeaderStateText}"
                                   Style="{StaticResource CompanyStateText}"
                                   AutomationProperties.Name="Company profile state text" />
                    </StackPanel>
                </Border>

                <Button Style="{DynamicResource SubtleButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="{DynamicResource MarginInline}"
                        ToolTip="Read the saved profile again"
                        AutomationProperties.Name="Reload the company profile">
                    <studio:ShellMark Kind="Refresh" Width="{DynamicResource ChoiceMarkSize}"
                                      Height="{DynamicResource ChoiceMarkSize}" />
                </Button>

                <Button Style="{DynamicResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="{DynamicResource MarginInline}"
                        IsEnabled="{Binding CanSave}"
                        ToolTip="Save the company profile"
                        AutomationProperties.Name="Save the company profile">
                    <TextBlock Text="Save company" />
                </Button>
            </WrapPanel>
        </Grid>

        <!-- ══ 2. BODY ═════════════════════════════════════════════════
             One scroll region for the whole page. The form card is the star
             column; the 300 px panel is fixed because its content (a sheet mock,
             three tiles, a picker, a chip) has a known bound. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{DynamicResource PaddingPage}">
            <Grid x:Name="BodyGrid"
                  SizeChanged="OnBodySizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── The form card ─────────────────────────────────── -->
                <ContentControl x:Name="FormCard"
                                Grid.Column="0"
                                Grid.Row="0"
                                Style="{DynamicResource Card}"
                                Padding="{DynamicResource UiCardPadding}"
                                Margin="{DynamicResource UiGapCluster}"
                                VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Read-only notice: only when this person cannot save.
                             The reason is printed; a disabled Save would not say
                             why, and the repository refuses the write anyway. -->
                        <Border Background="{DynamicResource StatusInformationSurface}"
                                BorderBrush="{DynamicResource StatusInformation}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginSection}"
                                Visibility="{Binding HasReadOnlyReason, Converter={StaticResource CompanyVisibility}}">
                            <TextBlock Text="{Binding ReadOnlyReason}"
                                       Style="{StaticResource CompanyHint}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       AutomationProperties.Name="Why the profile is read-only" />
                        </Border>

                        <!-- Refused save: the sentence names what to fix. -->
                        <Border Background="{DynamicResource StatusErrorSurface}"
                                BorderBrush="{DynamicResource StatusError}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginSection}"
                                Visibility="{Binding HasError, Converter={StaticResource CompanyVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Style="{StaticResource CompanyHint}"
                                       Foreground="{DynamicResource StatusError}"
                                       AutomationProperties.Name="Company profile error" />
                        </Border>

                        <!-- Saved. -->
                        <Border Background="{DynamicResource StatusSuccessSurface}"
                                BorderBrush="{DynamicResource StatusSuccess}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginSection}"
                                Visibility="{Binding HasStatus, Converter={StaticResource CompanyVisibility}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource CompanyHint}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       AutomationProperties.Name="Company profile saved" />
                        </Border>

                        <!-- ── Business identity ────────────────────────── -->
                        <TextBlock Text="Business identity"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Business identity section" />
                        <Border Style="{StaticResource CompanyHairline}" />

                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Company name *" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="The registered business name"
                                         AutomationProperties.Name="Company name" />
                                <TextBlock Text="{Binding CompanyNameError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company name error"
                                           Visibility="{Binding HasCompanyNameError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="TRN" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Trn, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="20"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="15-digit UAE Tax Registration Number"
                                         AutomationProperties.Name="Company TRN" />
                                <TextBlock Text="15 digits. Optional, but required on a tax invoice."
                                           Style="{StaticResource CompanyHint}" />
                                <TextBlock Text="{Binding TrnError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company TRN error"
                                           Visibility="{Binding HasTrnError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Address" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="300"
                                         MinHeight="{DynamicResource ControlMinHeight}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Street, area, city, country — as printed"
                                         AutomationProperties.Name="Company address" />
                                <TextBlock Text="Separate lines are kept. This is the address the letterhead prints."
                                           Style="{StaticResource CompanyHint}" />
                                <TextBlock Text="{Binding AddressError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company address error"
                                           Visibility="{Binding HasAddressError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- ── Representative and contact ─────────────────── -->
                        <TextBlock Text="Representative and contact"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Representative and contact section" />
                        <Border Style="{StaticResource CompanyHairline}" />

                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Representative" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding RepresentativeName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="The person who signs company documents"
                                         AutomationProperties.Name="Representative name" />
                                <TextBlock Text="{Binding RepresentativeNameError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Representative name error"
                                           Visibility="{Binding HasRepresentativeNameError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Mobile" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding RepresentativeMobile, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Mobile number printed under the representative"
                                         AutomationProperties.Name="Representative mobile" />
                                <TextBlock Text="{Binding RepresentativeMobileError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Representative mobile error"
                                           Visibility="{Binding HasRepresentativeMobileError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="E-mail" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="The address a client replies to"
                                         AutomationProperties.Name="Company e-mail" />
                                <TextBlock Text="{Binding EmailError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company e-mail error"
                                           Visibility="{Binding HasEmailError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Telephone" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="40"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Landline or switchboard"
                                         AutomationProperties.Name="Company telephone" />
                                <TextBlock Text="{Binding TelephoneError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company telephone error"
                                           Visibility="{Binding HasTelephoneError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Website" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Printed under the contact details"
                                         AutomationProperties.Name="Company website" />
                                <TextBlock Text="{Binding WebsiteError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Company website error"
                                           Visibility="{Binding HasWebsiteError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- ── Banking ─────────────────────────────────────── -->
                        <TextBlock Text="Banking"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Banking section" />
                        <Border Style="{StaticResource CompanyHairline}" />

                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Bank name" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="For example Emirates NBD"
                                         AutomationProperties.Name="Bank name" />
                                <TextBlock Text="{Binding BankNameError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Bank name error"
                                           Visibility="{Binding HasBankNameError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                                        Margin="{DynamicResource MarginSection}">
                                <TextBlock Text="Account number / IBAN" Style="{StaticResource CompanyFieldLabel}" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                         Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="80"
                                         IsEnabled="{Binding CanEdit}"
                                         ToolTip="Account number or IBAN, with or without spaces"
                                         AutomationProperties.Name="Account number or IBAN" />
                                <TextBlock Text="Two fields, so the bank and the account stay separable."
                                           Style="{StaticResource CompanyHint}" />
                                <TextBlock Text="{Binding AccountNumberError}"
                                           Style="{StaticResource CompanyFieldError}"
                                           AutomationProperties.Name="Account number error"
                                           Visibility="{Binding HasAccountNumberError, Converter={StaticResource CompanyVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>

                <!-- ── The logo and letterhead panel ─────────────────── -->
                <ContentControl x:Name="LogoPanel"
                                Grid.Column="1"
                                Grid.Row="0"
                                Style="{DynamicResource Card}"
                                Padding="{DynamicResource UiCardPadding}"
                                Width="300"
                                VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Logo and document header"
                                   Style="{StaticResource CompanySectionCaption}"
                                   AutomationProperties.Name="Logo section" />
                        <Border Style="{StaticResource CompanyHairline}" />
                        <TextBlock Text="What prints on every document. The image is copied into the application's data folder, so a backup or a moved installation keeps it."
                                   Style="{StaticResource CompanyHint}" />

                        <!-- The sheet, in the chosen composition. -->
                        <Border Style="{StaticResource CompanySheet}">
                            <Grid MinHeight="104">
                                <!-- Left portrait: mark beside the identity. -->
                                <Grid Visibility="{Binding IsLeftPortraitLayout, Converter={StaticResource CompanyVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Source="{Binding LogoPreview}"
                                           Stretch="Uniform"
                                           MaxHeight="56"
                                           MaxWidth="60"
                                           Margin="{DynamicResource MarginInline}"
                                           VerticalAlignment="Top"
                                           AutomationProperties.Name="Logo in the portrait header" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PreviewCompanyName}" Style="{StaticResource CompanySheetName}" />
                                        <TextBlock Text="{Binding PreviewAddressLine1}"
                                                   Style="{StaticResource CompanySheetLine}"
                                                   Visibility="{Binding HasPreviewAddressLine1, Converter={StaticResource CompanyVisibility}}" />
                                        <TextBlock Text="{Binding PreviewAddressLine2}"
                                                   Style="{StaticResource CompanySheetLine}"
                                                   Visibility="{Binding HasPreviewAddressLine2, Converter={StaticResource CompanyVisibility}}" />
                                        <TextBlock Text="{Binding PreviewTrnLine}" Style="{StaticResource CompanySheetLine}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Top masthead: full-width band, rule beneath. -->
                                <StackPanel Visibility="{Binding IsTopPanelLayout, Converter={StaticResource CompanyVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Source="{Binding LogoPreview}"
                                               Stretch="Uniform"
                                               MaxHeight="36"
                                               MaxWidth="96"
                                               Margin="{DynamicResource MarginInline}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="Logo in the top masthead" />
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PreviewCompanyName}"
                                                       Style="{StaticResource CompanySheetName}"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="{Binding PreviewTrnLine}"
                                                       Style="{StaticResource CompanySheetLine}"
                                                       TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource CompanyHairline}" />
                                    <TextBlock Text="{Binding PreviewAddressLine1}"
                                               Style="{StaticResource CompanySheetLine}"
                                               Visibility="{Binding HasPreviewAddressLine1, Converter={StaticResource CompanyVisibility}}" />
                                    <TextBlock Text="{Binding PreviewAddressLine2}"
                                               Style="{StaticResource CompanySheetLine}"
                                               Visibility="{Binding HasPreviewAddressLine2, Converter={StaticResource CompanyVisibility}}" />
                                </StackPanel>

                                <!-- Text only. -->
                                <StackPanel Visibility="{Binding IsNoLogoLayout, Converter={StaticResource CompanyVisibility}}">
                                    <TextBlock Text="{Binding PreviewCompanyName}" Style="{StaticResource CompanySheetName}" />
                                    <TextBlock Text="{Binding PreviewAddressLine1}"
                                               Style="{StaticResource CompanySheetLine}"
                                               Visibility="{Binding HasPreviewAddressLine1, Converter={StaticResource CompanyVisibility}}" />
                                    <TextBlock Text="{Binding PreviewAddressLine2}"
                                               Style="{StaticResource CompanySheetLine}"
                                               Visibility="{Binding HasPreviewAddressLine2, Converter={StaticResource CompanyVisibility}}" />
                                    <TextBlock Text="{Binding PreviewTrnLine}" Style="{StaticResource CompanySheetLine}" />
                                    <TextBlock Text="Text-only letterhead — no logo is printed."
                                               Style="{StaticResource CompanyHint}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Placement: three equal tiles, one radio group. -->
                        <TextBlock Text="Placement on documents" Style="{StaticResource CompanyFieldLabel}" />
                        <Grid Margin="{DynamicResource MarginItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0"
                                         GroupName="CompanyLogoLayout"
                                         Style="{StaticResource CompanyPlacementTile}"
                                         IsEnabled="{Binding CanEdit}"
                                         IsChecked="{Binding IsNoLogoLayout, Mode=TwoWay}"
                                         AutomationProperties.Name="No logo, text only">
                                <StackPanel>
                                    <Border Style="{StaticResource CompanyTileDiagram}">
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Style="{StaticResource CompanyTileTextLine}" />
                                            <Border Style="{StaticResource CompanyTileTextLine}" />
                                            <Border Style="{StaticResource CompanyTileTextLine}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="No logo" Style="{StaticResource CompanyTileCaption}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="1"
                                         GroupName="CompanyLogoLayout"
                                         Style="{StaticResource CompanyPlacementTile}"
                                         IsEnabled="{Binding CanEdit}"
                                         IsChecked="{Binding IsLeftPortraitLayout, Mode=TwoWay}"
                                         AutomationProperties.Name="Logo to the left of the identity">
                                <StackPanel>
                                    <Border Style="{StaticResource CompanyTileDiagram}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource CompanyTileLogoBlock}"
                                                    Width="14" Height="14" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border Style="{StaticResource CompanyTileTextLine}" />
                                                <Border Style="{StaticResource CompanyTileTextLine}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Left portrait" Style="{StaticResource CompanyTileCaption}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="2"
                                         GroupName="CompanyLogoLayout"
                                         Style="{StaticResource CompanyPlacementTile}"
                                         IsEnabled="{Binding CanEdit}"
                                         IsChecked="{Binding IsTopPanelLayout, Mode=TwoWay}"
                                         AutomationProperties.Name="Logo in a full-width top masthead">
                                <StackPanel>
                                    <Border Style="{StaticResource CompanyTileDiagram}">
                                        <StackPanel VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CompanyTileLogoBlock}"
                                                        Width="14" Height="8" />
                                                <Border Grid.Column="1" Style="{StaticResource CompanyTileTextLine}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Style="{StaticResource CompanyTileTextLine}" />
                                            <Border Style="{StaticResource CompanyTileTextLine}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Top masthead" Style="{StaticResource CompanyTileCaption}" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <TextBlock Text="{Binding LogoPlacementHint}" Style="{StaticResource CompanyHint}" />
                        <TextBlock Text="{Binding LogoLayoutError}"
                                   Style="{StaticResource CompanyFieldError}"
                                   AutomationProperties.Name="Logo placement error"
                                   Visibility="{Binding HasLogoLayoutError, Converter={StaticResource CompanyVisibility}}" />

                        <!-- Printed size: a picker, because it is a set of sane sizes. -->
                        <TextBlock Text="Printed size" Style="{StaticResource CompanyFieldLabel}" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  ItemsSource="{Binding LogoSizeOptions}"
                                  SelectedItem="{Binding SelectedLogoSizeOption, Mode=TwoWay}"
                                  Margin="{DynamicResource MarginItem}"
                                  IsEnabled="{Binding CanEdit}"
                                  ToolTip="The logo's long edge on the printed page"
                                  AutomationProperties.Name="Printed logo size">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Long edge in millimetres. The other edge follows the image's own proportions, so the logo is never stretched."
                                   Style="{StaticResource CompanyHint}" />
                        <TextBlock Text="{Binding LogoSizeError}"
                                   Style="{StaticResource CompanyFieldError}"
                                   AutomationProperties.Name="Logo size error"
                                   Visibility="{Binding HasLogoSizeError, Converter={StaticResource CompanyVisibility}}" />

                        <!-- The file chip: thumbnail, name, size, Remove. -->
                        <TextBlock Text="Logo file" Style="{StaticResource CompanyFieldLabel}" />
                        <Border Style="{StaticResource CompanyFileChip}"
                                Visibility="{Binding HasLogo, Converter={StaticResource CompanyVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="{Binding LogoPreview}"
                                       Stretch="Uniform"
                                       MaxHeight="32"
                                       MaxWidth="32"
                                       Margin="{DynamicResource MarginInline}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Logo file thumbnail"
                                       Visibility="{Binding HasLogoPreview, Converter={StaticResource CompanyVisibility}}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LogoDisplayName}"
                                               Style="{StaticResource CompanyFileName}"
                                               ToolTip="{Binding LogoDisplayName}"
                                               AutomationProperties.Name="Logo file name" />
                                    <TextBlock Text="{Binding LogoImageInfo}"
                                               Style="{StaticResource CompanyHint}"
                                               Visibility="{Binding HasLogoImageInfo, Converter={StaticResource CompanyVisibility}}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{DynamicResource SubtleButton}"
                                        Command="{Binding RemoveLogoCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip="Remove the logo from the profile"
                                        AutomationProperties.Name="Remove the company logo">
                                    <TextBlock Text="Remove" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- A missing or unreadable file says so here, and nothing
                             pretends the logo is still there. -->
                        <TextBlock Text="{Binding LogoPreviewProblem}"
                                   Style="{StaticResource CompanyFieldError}"
                                   AutomationProperties.Name="Logo problem"
                                   Visibility="{Binding HasLogoPreviewProblem, Converter={StaticResource CompanyVisibility}}" />

                        <Button Style="{DynamicResource SubtleButton}"
                                Command="{Binding ChooseLogoCommand}"
                                Margin="{DynamicResource MarginItem}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanEdit}"
                                ToolTip="Choose a PNG or JPEG image"
                                AutomationProperties.Name="Choose a logo image">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Add" Width="{DynamicResource ChoiceMarkSize}"
                                                  Height="{DynamicResource ChoiceMarkSize}"
                                                  Margin="{DynamicResource MarginInline}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Text="Choose image" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </ScrollViewer>

        <!-- ══ 3. FOOTER ═══════════════════════════════════════════════
             Sticky, full width, aligned to the same page inset as the cards, so
             the page never trails off into empty space and the actions are in the
             same place at every scroll position. -->
        <ContentControl Grid.Row="2"
                        Style="{DynamicResource Plate}"
                        Margin="{DynamicResource PaddingPage}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FooterNote}"
                           Style="{StaticResource CompanyHint}"
                           AutomationProperties.Name="Who may edit this profile" />
                <TextBlock Text="{Binding UnsavedText}"
                           Style="{StaticResource CompanyHint}"
                           Foreground="{DynamicResource StatusWarning}"
                           AutomationProperties.Name="Unsaved changes"
                           Visibility="{Binding HasUnsavedNotice, Converter={StaticResource CompanyVisibility}}" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{DynamicResource SubtleButton}"
                        Command="{Binding RevertCommand}"
                        Margin="{DynamicResource MarginInline}"
                        IsEnabled="{Binding HasUnsavedChanges}"
                        ToolTip="Discard the changes on this page and reload the saved profile"
                        AutomationProperties.Name="Revert unsaved changes">
                    <TextBlock Text="Revert" />
                </Button>
                <Button Style="{DynamicResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="{DynamicResource MarginInline}"
                        IsEnabled="{Binding CanSave}"
                        ToolTip="Save the company profile"
                        AutomationProperties.Name="Save the company profile from the footer">
                    <TextBlock Text="Save company" />
                </Button>
            </WrapPanel>
        </Grid>
        </ContentControl>
    </Grid>
</UserControl>
