<!-- ─────────────────────────────────────────────────────────────────────
     step6.d.0 — the proforma invoice screens' one style sheet.

     Field idiom, the product's: a caption-weight label above its value, and a
     muted hint under it. Everything here is a token from the shared contract,
     so a theme switch restyles the whole page without touching a view.

     No colour literal, no metric literal: the sizes and colours are the
     contract's, which is what keeps nine themes honest.
     ───────────────────────────────────────────────────────────────────── -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ProformaFieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
    </Style>

    <Style x:Key="ProformaFieldHint" TargetType="TextBlock">
        <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ProformaValueLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
    </Style>

    <Style x:Key="ProformaValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
    </Style>

    <Style x:Key="ProformaTotalLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
    </Style>

    <Style x:Key="ProformaTotalValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
    </Style>

    <Style x:Key="ProformaGrandTotalValue" TargetType="TextBlock" BasedOn="{StaticResource ProformaTotalValue}">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
    </Style>

</ResourceDictionary>
