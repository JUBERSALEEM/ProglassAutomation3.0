<UserControl x:Class="ProGlassAutomation.Proforma.ProformaSummaryStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         Stage 5 of 7 — the number the customer reads.

         Glass, then the charges around it, then the discount, then VAT, then the
         total. Every line is the engine's; the page prints it and never adds up
         anything itself. The target total is the reverse direction: the operator
         names the total, the engine solves the discount for it.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="step6.d.0.ProformaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PaddingCard}">

            <TextBlock Text="5 · SUMMARY" Style="{DynamicResource SectionHeading}"
                       Margin="{DynamicResource MarginItem}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                    <Grid Margin="{DynamicResource PaddingCard}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Glass"
                                   Style="{DynamicResource ProformaTotalLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GlassSubtotalText}"
                                   Style="{DynamicResource ProformaTotalValue}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Other charges"
                                   Style="{DynamicResource ProformaTotalLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OtherChargesText}"
                                   Style="{DynamicResource ProformaTotalValue}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Net subtotal"
                                   Style="{DynamicResource ProformaTotalLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NetSubtotalText}"
                                   Style="{DynamicResource ProformaTotalValue}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Discount"
                                   Style="{DynamicResource ProformaTotalLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscountAmountText}"
                                   Style="{DynamicResource ProformaTotalValue}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Before VAT"
                                   Style="{DynamicResource ProformaTotalLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BeforeVatText}"
                                   Style="{DynamicResource ProformaTotalValue}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="VAT"
                                   Style="{DynamicResource ProformaTotalLabel}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VatAmountText}"
                                   Style="{DynamicResource ProformaTotalValue}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="GRAND TOTAL"
                                   Style="{DynamicResource SectionHeading}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GrandTotalText}"
                                   Style="{DynamicResource ProformaGrandTotalValue}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="A discount is capped at the net subtotal; VAT is charged on what is left."
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource MarginItem}" />
                    </Grid>
                </ContentControl>

                <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}">
                    <ContentControl Style="{DynamicResource Card}">
                        <StackPanel Margin="{DynamicResource PaddingCard}">
                            <TextBlock Text="DISCOUNT" Style="{DynamicResource ProformaFieldLabel}" />
                            <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                      ItemsSource="{Binding DiscountOptions}"
                                      SelectedItem="{Binding SelectedDiscountOption}"
                                      AutomationProperties.Name="Discount method">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Style="{DynamicResource {x:Type TextBox}}" Margin="{DynamicResource MarginItem}"
                                     Text="{Binding DiscountValue, StringFormat=N2}"
                                     AutomationProperties.Name="Discount value" />
                            <TextBlock Text="50 % of the net subtotal is the ceiling."
                                       Style="{DynamicResource ProformaFieldHint}" />
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
                        <StackPanel Margin="{DynamicResource PaddingCard}">
                            <TextBlock Text="VAT" Style="{DynamicResource ProformaFieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                          Content="Charge VAT"
                                          IsChecked="{Binding VatApplicable, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="{DynamicResource UiGapControl}"
                                          AutomationProperties.Name="Charge VAT" />
                                <TextBox Style="{DynamicResource {x:Type TextBox}}" Width="90"
                                         Text="{Binding VatPercent, StringFormat=N2}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="VAT percent" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{DynamicResource Card}">
                        <StackPanel Margin="{DynamicResource PaddingCard}">
                            <TextBlock Text="SOLVE FOR A TOTAL" Style="{DynamicResource ProformaFieldLabel}" />
                            <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                     Text="{Binding TargetGrandTotalText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Target grand total" />
                            <Button Style="{DynamicResource SubtleButton}" Content="SET TARGET"
                                    Command="{Binding SetTargetCommand}"
                                    Margin="{DynamicResource MarginItem}"
                                    AutomationProperties.Name="Solve the discount for this total" />
                            <TextBlock Text="The result is held to one percent of the total you name."
                                       Style="{DynamicResource ProformaFieldHint}" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>

            <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
                <Grid Margin="{DynamicResource PaddingCard}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="NOTES" Style="{DynamicResource ProformaFieldLabel}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Invoice notes" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="TERMS" Style="{DynamicResource ProformaFieldLabel}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding TermsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Invoice terms" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <StackPanel Orientation="Horizontal" Margin="{DynamicResource MarginItem}">
                <Button Style="{DynamicResource SubtleButton}" Content="RECALCULATE"
                        Command="{Binding RecalculateCommand}"
                        Margin="{DynamicResource UiGapControl}"
                        AutomationProperties.Name="Recompute the invoice" />
                <TextBlock Text="{Binding StageHeadline}" Style="{DynamicResource Caption}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource MarginInline}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
