<UserControl x:Class="ProGlassAutomation.Proforma.ProformaChargesStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         Stage 4 of 7 — the work around the glass.

         Three sheets, the same three the estimator has always had: the
         catalogue the house suggests, the colour wastage it derives from the
         measured area, and whatever this job needs on top. A charge the operator
         switches off stays in the sheet, struck through by its own state.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="step6.d.0.ProformaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PaddingCard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{DynamicResource MarginItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="4 · OTHER CHARGES"
                       Style="{DynamicResource SectionHeading}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding OtherChargesText}" Style="{DynamicResource ProformaTotalValue}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource MarginInline}" />
                <Button Style="{DynamicResource SubtleButton}" Content="RECALCULATE"
                        Command="{Binding RecalculateCommand}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        AutomationProperties.Name="Recompute the invoice" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="CATALOGUE CHARGES" Style="{DynamicResource ProformaFieldLabel}"
                   Margin="{DynamicResource MarginItem}" />

        <ContentControl Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
            <DataGrid Style="{StaticResource ListGrid}"
                      ItemsSource="{Binding PredefinedCharges}"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      AutomationProperties.Name="Catalogue charges">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ON">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Checked="OnChargeToggled" Unchecked="OnChargeToggled"
                                          HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding ChargeName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CHARGE" Binding="{Binding ChargeName}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListStrongText}" />
                    <DataGridTextColumn Header="UNIT" Binding="{Binding UnitText}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListText}" />
                    <DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTemplateColumn Header="RATE">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Rate, StringFormat=N2}"
                                           ToolTip="{Binding Description}"
                                           Style="{StaticResource ListMonoText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding Description}"
                                         Style="{DynamicResource {x:Type TextBox}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                </DataGrid.Columns>
            </DataGrid>
        </ContentControl>

        <TextBlock Grid.Row="3" Text="COLOUR WASTAGE" Style="{DynamicResource ProformaFieldLabel}"
                   Margin="{DynamicResource MarginItem}" />

        <ContentControl Grid.Row="4" Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
            <DataGrid Style="{StaticResource ListGrid}"
                      ItemsSource="{Binding WastageCharges}"
                      CellEditEnding="OnWastageCellEditEnding"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      AutomationProperties.Name="Colour wastage">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ON">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Checked="OnChargeToggled" Unchecked="OnChargeToggled"
                                          HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding ColorName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="COLOUR">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ColorName}"
                                           ToolTip="{Binding SuggestionReason}"
                                           Style="{StaticResource ListStrongText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SHEETS FOR COST"
                                        Binding="{Binding SheetQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N2}"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="AREA M²" Binding="{Binding AreaSqm, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                </DataGrid.Columns>
            </DataGrid>
        </ContentControl>


        <TextBlock Grid.Row="5" Text="CUSTOM CHARGES" Style="{DynamicResource ProformaFieldLabel}"
                   Margin="{DynamicResource MarginItem}" />

        <ContentControl Grid.Row="6" Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
            <DataGrid Style="{StaticResource ListGrid}"
                      ItemsSource="{Binding CustomCharges}"
                      SelectedItem="{Binding SelectedCustomCharge, Mode=TwoWay}"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      AutomationProperties.Name="Custom charges">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ON">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Checked="OnChargeToggled" Unchecked="OnChargeToggled"
                                          HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding ChargeName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CHARGE" Binding="{Binding ChargeName}"
                                        ElementStyle="{StaticResource ListStrongText}" />
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="UNIT" Binding="{Binding UnitText}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListText}" />
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N2}"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                </DataGrid.Columns>
            </DataGrid>
        </ContentControl>

        <Grid Grid.Row="7" Margin="{DynamicResource MarginItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox Style="{DynamicResource {x:Type TextBox}}" Width="200"
                         Text="{Binding NewChargeName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Margin="{DynamicResource UiGapControl}"
                         AutomationProperties.Name="New charge name" />
                <TextBox Style="{DynamicResource {x:Type TextBox}}" Width="90"
                         Text="{Binding NewChargeQuantity, StringFormat=N2}"
                         VerticalAlignment="Center"
                         Margin="{DynamicResource UiGapControl}"
                         AutomationProperties.Name="New charge quantity" />
                <ComboBox Style="{DynamicResource {x:Type ComboBox}}" Width="90"
                          ItemsSource="{Binding ChargeUnits}" SelectedItem="{Binding NewChargeUnit}"
                          VerticalAlignment="Center"
                          Margin="{DynamicResource UiGapControl}"
                          AutomationProperties.Name="New charge unit" />
                <TextBox Style="{DynamicResource {x:Type TextBox}}" Width="110"
                         Text="{Binding NewChargeRate, StringFormat=N2}"
                         VerticalAlignment="Center"
                         Margin="{DynamicResource UiGapControl}"
                         AutomationProperties.Name="New charge rate" />
                <Button Style="{DynamicResource SubtleButton}" Content="ADD CHARGE"
                        Command="{Binding AddCustomChargeCommand}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource UiGapControl}"
                        AutomationProperties.Name="Add the custom charge" />
                <Button Style="{DynamicResource SubtleButton}" Content="REMOVE CHARGE"
                        Command="{Binding RemoveCustomChargeCommand}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource UiGapControl}"
                        AutomationProperties.Name="Remove the selected custom charge" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Custom total" Style="{DynamicResource ProformaFieldLabel}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource MarginInline}" />
                <Button Style="{DynamicResource SubtleButton}" Content="RECALCULATE"
                        Command="{Binding RecalculateCommand}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource UiGapControlEnd}"
                        AutomationProperties.Name="Recompute the invoice" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
