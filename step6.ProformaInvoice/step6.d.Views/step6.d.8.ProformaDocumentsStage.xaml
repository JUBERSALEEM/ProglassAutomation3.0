<UserControl x:Class="ProGlassAutomation.Proforma.ProformaDocumentsStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         Stage 6 of 7 — the paperwork that goes with the invoice.

         Files are copied into the invoice's own folder and named by the module,
         so an attachment survives the original being moved or deleted. A file is
         never overwritten and never removed from disk behind the operator's back:
         removing an attachment removes the invoice's copy of it.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="step6.d.0.ProformaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PaddingCard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{DynamicResource MarginItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="6 · DOCUMENTS"
                       Style="{DynamicResource SectionHeading}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource PrimaryButton}" Content="ATTACH FILE"
                        Click="OnAttachFile"
                        Margin="{DynamicResource UiGapControlEnd}"
                        AutomationProperties.Name="Attach a file to this invoice" />
                <Button Style="{DynamicResource SubtleButton}" Content="REMOVE"
                        Command="{Binding RemoveAttachmentCommand}"
                        Margin="{DynamicResource UiGapControlEnd}"
                        AutomationProperties.Name="Remove the selected attachment" />
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
            <DataGrid Style="{StaticResource ListGrid}"
                      ItemsSource="{Binding Attachments}"
                      SelectedItem="{Binding SelectedAttachment, Mode=TwoWay}"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      AutomationProperties.Name="Invoice attachments">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FILE" Binding="{Binding FileName}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListStrongText}" />
                    <DataGridTextColumn Header="TYPE" Binding="{Binding AttachmentType}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListText}" />
                    <DataGridTextColumn Header="STORED AS" Binding="{Binding StoredFileName}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="ATTACHED BY" Binding="{Binding UploadedByName}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListText}" />
                </DataGrid.Columns>
            </DataGrid>
        </ContentControl>

        <StackPanel Grid.Row="2" Margin="{DynamicResource MarginItem}">
            <TextBlock Text="Documents are copied into this invoice's own folder. A single file may not exceed 20 MB."
                       Style="{DynamicResource Caption}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Save the invoice before attaching a file: an attachment belongs to a numbered document."
                       Style="{DynamicResource ProformaFieldHint}" />
            <TextBlock Text="{Binding StageHeadline}" Style="{DynamicResource Caption}"
                       TextWrapping="Wrap"
                       Margin="{DynamicResource MarginItem}" />
        </StackPanel>
    </Grid>
</UserControl>
