<UserControl x:Class="ProGlassAutomation.Proforma.ProformaProfitStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         Stage 7 of 7 — what the invoice earns.

         Cost comes from the specification's own cost card, plus the wastage the
         operator sets here. Profit is the total less the cost; the margin is that
         profit over the total. The spec targets answer the other question: what
         each specification would need per square metre to clear the target.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="step6.d.0.ProformaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PaddingCard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{DynamicResource MarginItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="7 · PROFIT AND LOSS"
                       Style="{DynamicResource SectionHeading}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Margin="{DynamicResource UiGapControlEnd}" VerticalAlignment="Center">
                    <TextBlock Text="WASTAGE %" Style="{DynamicResource ProformaFieldLabel}" />
                    <TextBox Style="{DynamicResource {x:Type TextBox}}" Width="90"
                             Text="{Binding WastagePercent, StringFormat=N1}"
                             AutomationProperties.Name="Wastage percent" />
                </StackPanel>
                <Button Style="{DynamicResource SubtleButton}" Content="RECALCULATE"
                        Command="{Binding RecalculateCommand}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource UiGapControlEnd}"
                        AutomationProperties.Name="Recompute the invoice" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="{DynamicResource MarginItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                <StackPanel Margin="{DynamicResource PaddingCard}">
                    <TextBlock Text="COST" Style="{DynamicResource ProformaTotalLabel}" />
                    <TextBlock Text="{Binding TotalCostText}" Style="{DynamicResource ProformaTotalValue}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="1" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                <StackPanel Margin="{DynamicResource PaddingCard}">
                    <TextBlock Text="PROFIT" Style="{DynamicResource ProformaTotalLabel}" />
                    <TextBlock Text="{Binding ProfitText}" Style="{DynamicResource ProformaTotalValue}" />
                </StackPanel>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                <StackPanel Margin="{DynamicResource PaddingCard}">
                    <TextBlock Text="MARGIN" Style="{DynamicResource ProformaTotalLabel}" />
                    <TextBlock Text="{Binding MarginText}" Style="{DynamicResource ProformaTotalValue}" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <ContentControl Grid.Row="2" Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}">
            <DataGrid Style="{StaticResource ListGrid}"
                      ItemsSource="{Binding CostRows}"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      AutomationProperties.Name="Cost rows">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding SpecNumber}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="SPECIFICATION" Binding="{Binding SpecName}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListStrongText}" />
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListText}" />
                    <DataGridTextColumn Header="SQM" Binding="{Binding SheetSqm, StringFormat=N4}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="COST AED/M²" Binding="{Binding PricePerSqm, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListMonoText}" />
                    <DataGridTextColumn Header="BASIS" Binding="{Binding CostBasis}"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ListText}" />
                </DataGrid.Columns>
            </DataGrid>
        </ContentControl>

        <TextBlock Grid.Row="3" Text="SPECIFICATION TARGETS" Style="{DynamicResource ProformaFieldLabel}"
                   Margin="{DynamicResource MarginItem}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                <DataGrid Style="{StaticResource ListGrid}"
                          ItemsSource="{Binding TargetRows}"
                          CanUserReorderColumns="False" CanUserSortColumns="False"
                          AutomationProperties.Name="Specification targets">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SpecNumber}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListMonoText}" />
                        <DataGridTextColumn Header="SPECIFICATION" Binding="{Binding SpecName}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListStrongText}" />
                        <DataGridTextColumn Header="GIVEN" Binding="{Binding GivenPricePerSqm, StringFormat=N2}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListMonoText}" />
                        <DataGridTextColumn Header="BASE" Binding="{Binding CostBasisPerSqm, StringFormat=N2}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListMonoText}" />
                        <DataGridTextColumn Header="REQUIRED" Binding="{Binding SpecificationTargetPerSqm, StringFormat=N2}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListMonoText}" />
                        <DataGridTextColumn Header="DIFFERENCE" Binding="{Binding DifferencePerSqm, StringFormat=N2}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListMonoText}" />
                        <DataGridTextColumn Header="STATE" Binding="{Binding StatusText}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource ListText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </ContentControl>

            <ContentControl Grid.Column="1" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
                <StackPanel Margin="{DynamicResource PaddingCard}">
                    <TextBlock Text="HOW THE COST WAS READ" Style="{DynamicResource ProformaFieldLabel}" />
                    <TextBlock Text="{Binding CostBasisNote}" Style="{DynamicResource ProformaValue}" />

                    <TextBlock Text="WARNINGS" Style="{DynamicResource ProformaFieldLabel}"
                               Margin="{DynamicResource MarginItem}" />
                    <ItemsControl ItemsSource="{Binding LossWarnings}" Focusable="False"
                                  AutomationProperties.Name="Profit and loss warnings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{DynamicResource ProformaFieldHint}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StageHeadline}" Style="{DynamicResource Caption}"
                               TextWrapping="Wrap"
                               Margin="{DynamicResource MarginItem}" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
