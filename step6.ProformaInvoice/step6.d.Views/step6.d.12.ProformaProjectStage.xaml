<UserControl x:Class="ProGlassAutomation.Proforma.ProformaProjectStage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="step6.d.0.ProformaStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{DynamicResource PaddingCard}"><TextBlock Text="3 · PROJECT" Style="{DynamicResource SectionHeading}" Margin="{DynamicResource MarginItem}"/><TextBlock Text="Project, inquiry, preparer and quotation dates." Style="{DynamicResource Caption}" Margin="{DynamicResource MarginItem}"/><ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginItem}"><StackPanel Margin="{DynamicResource PaddingCard}"><TextBlock Text="PROJECT &amp; PREPARATION" Style="{DynamicResource ProformaFieldLabel}"/><TextBlock Text="{Binding ProjectText}" Style="{DynamicResource ProformaValue}"/><TextBlock Text="{Binding InquiryText}" Style="{DynamicResource ProformaFieldHint}"/><TextBlock Text="{Binding PreparedByText}" Style="{DynamicResource ProformaFieldHint}"/><TextBlock Text="{Binding PartiesRefreshedText}" Style="{DynamicResource ProformaFieldHint}"/></StackPanel></ContentControl><Grid Margin="{DynamicResource MarginItem}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="{DynamicResource UiGapControl}"><TextBlock Text="ISSUE DATE" Style="{DynamicResource ProformaFieldLabel}"/><TextBox Style="{DynamicResource {x:Type TextBox}}" MinWidth="160" Text="{Binding IssueDateText, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="dd MMM yyyy" Style="{DynamicResource ProformaFieldHint}"/></StackPanel><StackPanel Grid.Column="1" Margin="{DynamicResource UiGapControl}"><TextBlock Text="VALID UNTIL" Style="{Dyn