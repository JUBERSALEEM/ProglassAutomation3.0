<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms for the tray NotifyIcon (website inbox desktop notifications). -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.0.0</Version>
    <AssemblyTitle>ProGlass Automation</AssemblyTitle>
    <Product>ProGlass Automation</Product>
    <InformationalVersion>3.0</InformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- The Windows Forms SDK injects implicit GLOBAL usings for
       System.Windows.Forms and System.Drawing; with UseWPF=true that makes
       every bare WPF type (Application, UserControl, Brush, Color, ...)
       ambiguous project-wide (CS0104). Remove those two implicit usings:
       WinForms stays a normal assembly reference, and its imports are
       explicit and confined to InquiryInboxNotifier.cs (tray icon). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- Explicit inclusion keeps the application and verification executable separate. -->
  <ItemGroup>
    <!-- Diagnostics is shared foundation code, not a numbered feature: it is the
         one technical error log (docs/14) and every module writes to it. Its
         tests are a console project of their own, like every other module's. -->
    <Compile Include="App.xaml.cs;MainWindow.xaml.cs;AssemblyInfo.cs" />
    <Compile Include="Diagnostics/**/*.cs" />
    <Compile Include="Theme/step1.a.ThemeEngine/**/*.cs;Theme/ThemeBento/**/*.cs;Theme/ThemeClaymorphism/**/*.cs;Theme/ThemeFluent/**/*.cs;Theme/ThemeNeumorphism/**/*.cs;Theme/ThemeLiquidGlass/**/*.cs;Theme/ThemeGlassmorphism/**/*.cs;Theme/ThemeSpatial/**/*.cs;Theme/ThemeSwiss/**/*.cs;Theme/ThemeHolographic/**/*.cs;Theme/step1.f.Analytics/**/*.cs;Theme/step1.g.Customization/**/*.cs;step1.ThemeStudio/step1.b.ThemeStudioScreen/**/*.cs;Inquiry/**/*.cs;step2.ClientManagement/**/*.cs;step3.UserManagement/**/*.cs;step4.CompanyProfile/**/*.cs;step5.ProjectRecords/**/*.cs" />
    <Page Include="MainWindow.xaml;Theme/ThemeBento/**/*.xaml;Theme/ThemeClaymorphism/**/*.xaml;Theme/ThemeFluent/**/*.xaml;Theme/ThemeNeumorphism/**/*.xaml;Theme/ThemeLiquidGlass/**/*.xaml;Theme/ThemeGlassmorphism/**/*.xaml;Theme/ThemeSpatial/**/*.xaml;Theme/ThemeSwiss/**/*.xaml;Theme/ThemeHolographic/**/*.xaml;step1.ThemeStudio/step1.b.ThemeStudioScreen/**/*.xaml;Inquiry/**/*.xaml;step2.ClientManagement/**/*.xaml;step3.UserManagement/**/*.xaml;step4.CompanyProfile/**/*.xaml;step5.ProjectRecords/**/*.xaml" />
  </ItemGroup>
  <!-- The step2, step3 and step4 verification executables are their own projects
       (like step1.d): keep their sources out of the application build so the
       app never gains a second entry point. -->
  <ItemGroup>
    <Compile Remove="step2.ClientManagement/step2.f.tests/**/*.cs" />
    <Page Remove="step2.ClientManagement/step2.f.tests/**/*.xaml" />
    <None Remove="step2.ClientManagement/step2.f.tests/**/*.py" />
    <Compile Remove="step3.UserManagement/step3.f.tests/**/*.cs" />
    <Page Remove="step3.UserManagement/step3.f.tests/**/*.xaml" />
    <None Remove="step3.UserManagement/step3.f.tests/**/*.py" />
    <!-- step4's behaviour checks and its static gate are a console project of
         their own (step4.f), so neither source joins this build. -->
    <Compile Remove="Diagnostics/tests/**/*.cs" />
    <None Remove="Diagnostics/tests/**/*.py" />
    <Compile Remove="step4.CompanyProfile/step4.f.tests/**/*.cs" />
    <Page Remove="step4.CompanyProfile/step4.f.tests/**/*.xaml" />
    <None Remove="step4.CompanyProfile/step4.f.tests/**/*.py" />
    <!-- step5's verification executable (the G1 migration-preservation check)
         is its own console project for the same reason. -->
    <Compile Remove="step5.ProjectRecords/step5.f.tests/**/*.cs" />
    <Page Remove="step5.ProjectRecords/step5.f.tests/**/*.xaml" />
    <None Remove="step5.ProjectRecords/step5.f.tests/**/*.py" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <!-- Inquiry register persists with local EF Core + SQLite (same store engine as the legacy app). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>
</Project>
