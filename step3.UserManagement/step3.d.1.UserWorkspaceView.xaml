<UserControl x:Class="ProGlassAutomation.Users.UserWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:users="clr-namespace:ProGlassAutomation.Users"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step3 — User Management workspace.

         Theme rules obeyed by this view (docs/02 + step1.d.11 / step1.d.17):
           • every colour, brush, metric, radius and font comes from the
             shared contract through DynamicResource — no literals;
           • theme-owned card roles (Card / HeroCard / MetricCard) are looked
             up dynamically and never BasedOn a StaticResource;
           • controls with theme-owned templates (TextBox, ComboBox, DataGrid)
             bind the active implicit style explicitly, so a theme switch
             replaces the template as well as the tokens;
           • visibility is driven by Style DataTriggers or, where the element
             must keep the shared Caption style, by one BooleanToVisibility
             converter declared below — never by a Style with BasedOn.

         Layout: the same one-bar register as step2 Client Management — filter
         state and the chips on the left, search and actions on the right, and
         nothing under the list except the rows themselves.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <!-- A boolean that decides visibility, expressed without a Style:
             `BasedOn` is a plain CLR property on Style, not a dependency
             property, so `BasedOn="{DynamicResource ...}"` throws
             XamlParseException at load ("A DynamicResourceExtension cannot be set
             on the BasedOn property"). A converter keeps the element's own Style
             free for the shared Caption token. -->
        <BooleanToVisibilityConverter x:Key="UserVisibility" />
        <!-- The field label, as step2's ClientFieldLabel and the step4/step5
             editors already define it. Five labels carried the same three setters
             inline, so a theme that restyles SectionHeading reached none of them
             (owner, round 50: "few text didnt have heading type"). -->
        <Style x:Key="UserFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        </Style>
        <Style x:Key="UserToggleIcon" TargetType="studio:ShellMark">
            <Setter Property="Kind" Value="Cancel" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedRow.IsActive}" Value="False">
                    <Setter Property="Kind" Value="Add" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ── Filter chips ────────────────────────────────────────────
             All / Active / Inactive, each carrying its own count. Idle is the
             theme's BorderSubtle on SurfacePrimary; selected takes AccentPrimary
             with TextOnAccent, exactly as the Inquiry and Client registers do,
             so the three registers cannot drift apart. -->
        <Style x:Key="UserFilterChip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <!-- Same 36 px interactive height as every other control here. -->
            <Setter Property="MinHeight" Value="{DynamicResource UiActionMinHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource ControlMinWidth}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ChipCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StatePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The per-row menu trigger. Transparent until hovered, so twenty rows
             do not read as twenty buttons; still hit-testable and named for
             assistive tech. -->
        <Style x:Key="UserRowMenuButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Width" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Height" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- One page padding for the whole view (24 px, from the module scale),
         instead of a margin on each row. Rows that used to carry their own page
         margin stacked 16 + 16 px of dead space between the bar and the card
         whenever nothing was displayed between them. -->
    <Grid Margin="{DynamicResource UiPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── One command bar, one row ────────────────────────────────
             Left: what the operator is looking at and can narrow — search, the
             three status chips with their counts, and the two catalogue filters,
             each with its name in front of it.
             Right: what the operator can do — Edit, the status action, the
             overflow menu and the one primary action.

             Why this shape
             ──────────────
             The first build put every control in one horizontal StackPanel inside
             a `*` column, which cannot shrink: with the sidebar open the left
             group was drawn over the right group. The second build split it into
             two full-width rows, which removed the overlap but read as two
             stacked strips of unrelated controls. This version keeps the safety
             of wrapping (both groups are WrapPanels, so a narrow window wraps
             instead of overlapping) while fitting on one line at normal width:
             each dropdown shows its selection on its own face with no field
             label beside it, the search box holds its own clear button, and the
             redundant "Filters" reset button is gone — choosing All departments or
             All roles already clears a filter.
             ─────────────────────────────────────────────────────────────── -->
        <ContentControl Grid.Row="0" Style="{DynamicResource Plate}"
                        Padding="{DynamicResource UiCardPadding}"
                        Margin="{DynamicResource UiGapGroup}">
            <!-- The inset comes from the card's own Padding, the same token the
                 register card uses below it. `Plate` and `Card` ship different
                 theme paddings (PaddingPlate vs PaddingCard), which is why the
                 bar's content and the table's first column did not start on the
                 same vertical line; setting both explicitly removes that
                 difference in all nine themes. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- The flexible column. Its WrapPanel wraps, it never
                         overflows, so the action cluster on the right can never
                         be overlapped. -->
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Search, status, department, role ─────────────────── -->
                <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <Grid Width="190" MinWidth="140" VerticalAlignment="Center"
                          Margin="{DynamicResource UiGapAction}">
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 MinHeight="{DynamicResource UiActionMinHeight}"
                                 Padding="{DynamicResource UiSearchPadding}"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, username, role or department"
                                 AutomationProperties.Name="Search users" />
                        <!-- Placeholder, and a clear button that lives inside the
                             field instead of standing beside it. -->
                        <TextBlock Text="Search users…" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource UiSearchPadding}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource UserRowMenuButton}"
                                Content="✕"
                                Width="{DynamicResource UiActionMinHeight}"
                                Height="{DynamicResource UiActionMinHeight}"
                                Margin="{DynamicResource PaddingCompact}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="Clear the search"
                                AutomationProperties.Name="Clear search" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding StatusTabs}" Focusable="False"
                                  Margin="{DynamicResource UiGapAction}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="User status filters">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource UserFilterChip}"
                                        Command="{Binding DataContext.SelectStatusTabCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding LabelWithCount}"
                                        AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Department filter. The label sits beside the box with the
                         selection alone on the face ("All departments" until
                         something is chosen, then the catalogue's own wording),
                         which is the Inquiry toolbar's arrangement. Printing the
                         field word inside the face was tried: in a form or a
                         narrow bar it reads as a placeholder, and it doubles the
                         word once the row already says "Cutting Department".
                         The selection is bound as a ROW, not as a code string: a
                         SelectedValue applied before the list exists is what left
                         these boxes blank. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{DynamicResource UiGapAction}">
                        <TextBlock Text="Department" Style="{DynamicResource Caption}"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource UiGapAction}" />
                        <ComboBox Margin="{DynamicResource UiGapControl}" Style="{DynamicResource {x:Type ComboBox}}"
                                  MinWidth="150"
                                  MinHeight="{DynamicResource UiActionMinHeight}"
                                  ItemsSource="{Binding DepartmentFilters}"
                                  SelectedItem="{Binding SelectedDepartmentFilterItem, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Show only people from one department"
                                  AutomationProperties.Name="Department filter"
                                  AutomationProperties.HelpText="Filters the register by department; All departments shows every team">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Role filter, same idiom: the label says which field, the
                         face says the selection — "All roles" until a role is
                         chosen, the role's own name after it. Role is what a
                         person may do; department never is a permission, which is
                         why both filters exist. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{DynamicResource UiGapAction}">
                        <TextBlock Text="Role" Style="{DynamicResource Caption}"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource UiGapAction}" />
                        <ComboBox Margin="{DynamicResource UiGapControl}" Style="{DynamicResource {x:Type ComboBox}}"
                                  MinWidth="130"
                                  MinHeight="{DynamicResource UiActionMinHeight}"
                                  ItemsSource="{Binding RoleFilters}"
                                  SelectedItem="{Binding SelectedRoleFilterItem, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Show only people with one role"
                                  AutomationProperties.Name="Role filter"
                                  AutomationProperties.HelpText="Filters the register by role; All roles shows every role">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <!-- ── Actions ─────────────────────────────────────────────
                     8 px between the buttons of the group, 16 px before the
                     primary action so it reads as its own decision. -->
                <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                           HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding EditSelectedCommand}"
                            Margin="{DynamicResource UiGapControlEnd}"
                            MinHeight="{DynamicResource UiActionMinHeight}"
                            Padding="{DynamicResource UiActionPadding}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanManageUsers}"
                            ToolTip="Edit the selected person"
                            AutomationProperties.Name="Edit selected user">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Edit" Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource UiGapAction}" VerticalAlignment="Center" />
                            <TextBlock Text="Edit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding ToggleActiveCommand}"
                            CommandParameter="{Binding SelectedRow}"
                            Margin="{DynamicResource UiGapControlEnd}"
                            MinHeight="{DynamicResource UiActionMinHeight}"
                            Padding="{DynamicResource UiActionPadding}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanManageUsers}"
                            ToolTip="Activate or deactivate the selected person"
                            AutomationProperties.Name="Activate or deactivate selected user">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Style="{StaticResource UserToggleIcon}"
                                              Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource UiGapAction}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedToggleLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- A three-dot menu holding one item was a menu for its own
                         sake: it hid the only action behind a second click. Refresh
                         is a plain button, named as an action. -->
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="{DynamicResource UiGapControlEnd}"
                            MinHeight="{DynamicResource UiActionMinHeight}"
                            Padding="{DynamicResource UiActionPadding}"
                            VerticalAlignment="Center"
                            ToolTip="Reload the register from the database"
                            AutomationProperties.Name="Refresh the register">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Refresh"
                                              Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource UiGapAction}"
                                              VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Sign out is on the page because the session belongs to the
                         person using it, not to the window: the next operator on this
                         workstation must be able to end it. -->
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding SignOutCommand}"
                            Margin="{DynamicResource UiGapControlEnd}"
                            MinHeight="{DynamicResource UiActionMinHeight}"
                            Padding="{DynamicResource UiActionPadding}"
                            VerticalAlignment="Center"
                            ToolTip="End this session and return to the sign-in screen"
                            AutomationProperties.Name="Sign out">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Cancel"
                                              Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource UiGapAction}"
                                              VerticalAlignment="Center" />
                            <TextBlock Text="Sign out" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource PrimaryButton}"
                            Command="{Binding NewUserCommand}"
                            Margin="{DynamicResource UiGapControlEnd}"
                            MinHeight="{DynamicResource UiActionMinHeight}"
                            Padding="{DynamicResource UiActionPadding}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanManageUsers}"
                            AutomationProperties.Name="Add user">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Add" Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource UiGapAction}" VerticalAlignment="Center" />
                            <TextBlock Text="NEW USER" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <!-- Whose data this is. A non-administrator reads their own row
                     only; saying so is the difference between "empty" and
                     "restricted". -->
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding ScopeNote}"
                           Style="{DynamicResource Caption}"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource UiGapField}"
                           Visibility="{Binding HasScopeNote,
                                                Converter={StaticResource UserVisibility}}"
                           AutomationProperties.Name="Read scope" />
            </Grid>
        </ContentControl>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Failure surface: a refused write says why. -->
            <Border Grid.Row="0" Background="{DynamicResource StatusErrorSurface}"
                    BorderBrush="{DynamicResource StatusError}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource UiGapGroup}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusError}"
                           TextWrapping="Wrap" AutomationProperties.Name="User error" />
            </Border>

            <!-- Status line -->
            <Border Grid.Row="1" Background="{DynamicResource StatusInformationSurface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource UiGapGroup}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" AutomationProperties.Name="User status" />
            </Border>

            <!-- Read-only notice. It explains WHY the buttons are disabled; it is
                 not the enforcement — the repository refuses the same writes
                 independently of this view. -->
            <Border Grid.Row="2" Background="{DynamicResource StatusWarningSurface}"
                    BorderBrush="{DynamicResource StatusWarning}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource UiGapGroup}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPermissionMessage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding PermissionMessage}" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" AutomationProperties.Name="Permission notice" />
            </Border>
        </Grid>

        <!-- ── Register, first-run bootstrap, and editor share the last row ── -->
        <Grid Grid.Row="2">

            <!-- Register card -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowBootstrapCard}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ContentControl Style="{DynamicResource Card}"
                                Padding="{DynamicResource UiCardPadding}">
                    <DataGrid Style="{DynamicResource ListGrid}"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              Margin="0"
                              AutomationProperties.Name="User directory"
                              MouseDoubleClick="OnRowDoubleClick"
                              KeyDown="OnGridKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}"
                                                ElementStyle="{StaticResource ListStrongText}" />
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}"
                                                ElementStyle="{StaticResource ListMonoText}" />
                            <DataGridTextColumn Header="Department" Binding="{Binding DepartmentText}"
                                                ElementStyle="{StaticResource ListText}" />
                            <DataGridTextColumn Header="Role" Binding="{Binding RoleText}"
                                                ElementStyle="{StaticResource ListText}" />
                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Status" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusBadge}"
                                                Tag="{Binding StatusTag}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{DynamicResource StatusText}"
                                                       Tag="{Binding StatusTag}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}"
                                                ElementStyle="{StaticResource ListMonoText}" />
                            <!-- One trigger per row instead of three icons: twenty
                                 rows of pencil/cross/dots read as noise. -->
                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Actions" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource UserRowMenuButton}"
                                                Content="⋯"
                                                Click="OnRowMenuClick"
                                                Tag="{Binding DataContext,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Row actions"
                                                AutomationProperties.Name="User row actions">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{DynamicResource {x:Type ContextMenu}}"
                                                             DataContext="{Binding PlacementTarget.DataContext,
                                                                           RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Edit user…"
                                                              Command="{Binding PlacementTarget.Tag.EditUserCommand,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding ToggleLabel}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleActiveCommand,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ContentControl>
            </Grid>

            <!-- ── First-run bootstrap ─────────────────────────────────
                 Two states, one card (ShowBootstrapCard):
                 • no users at all — nobody can be identified and no
                   administrator could exist, so the person at this workstation
                   registers the Windows account they are already using;
                 • users but no password anywhere — a directory written before
                   migration 1015, where nobody can sign in and no administrator
                   exists to set one, so the administrator row this workstation
                   owns gets its first password here.
                 Each door closes as soon as it would stop being true. -->
            <Grid x:Name="BootstrapCard">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBootstrapCard}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ContentControl Style="{DynamicResource Card}"
                                Padding="{DynamicResource UiCardPadding}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding BootstrapTitle}"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       FontWeight="{DynamicResource FontWeightHeading}"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding BootstrapExplanation}"
                                       Style="{DynamicResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="{DynamicResource UiGapGroup}" />

                            <!-- The account is read, not typed: it is the account this
                                 Windows session is already signed in with. -->
                            <TextBlock Text="Windows account (this workstation)" Style="{StaticResource UserFieldLabel}" />
                            <TextBlock Text="{Binding BootstrapOperatorUsername}"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       Margin="{DynamicResource UiGapGroup}"
                                       AutomationProperties.Name="Workstation account" />

                            <TextBlock Text="Full name *" Style="{StaticResource UserFieldLabel}"
                                       Visibility="{Binding ShowBootstrapIdentityFields, Converter={StaticResource UserVisibility}}" />
                            <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                     Text="{Binding BootstrapFullName, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="{DynamicResource UiActionMinHeight}"
                                     Margin="{DynamicResource UiGapGroup}"
                                     ToolTip="The name that will appear on documents this person prepares"
                                     AutomationProperties.Name="First administrator full name"
                                     Visibility="{Binding ShowBootstrapIdentityFields, Converter={StaticResource UserVisibility}}" />

                            <TextBlock Text="Department" Style="{StaticResource UserFieldLabel}"
                                       Visibility="{Binding ShowBootstrapIdentityFields, Converter={StaticResource UserVisibility}}" />
                            <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                      ItemsSource="{Binding Departments}"
                                      SelectedItem="{Binding BootstrapDepartmentItem, Mode=TwoWay}"
                                      MinHeight="{DynamicResource UiActionMinHeight}"
                                      Margin="{DynamicResource UiGapGroup}"
                                      AutomationProperties.Name="First administrator department"
                                      Visibility="{Binding ShowBootstrapIdentityFields, Converter={StaticResource UserVisibility}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Password, chosen here: without it the row would
                                 exist and nobody could ever sign in as it. -->
                            <TextBlock Text="Password *" Style="{StaticResource UserFieldLabel}" />
                            <PasswordBox x:Name="BootstrapPasswordBox"
                                         Style="{DynamicResource {x:Type PasswordBox}}"
                                         MinHeight="{DynamicResource UiActionMinHeight}"
                                         Margin="{DynamicResource UiGapField}"
                                         PasswordChanged="OnBootstrapPasswordChanged"
                                         ToolTip="At least 8 characters, with a letter and a digit"
                                         AutomationProperties.Name="First administrator password" />

                            <TextBlock Text="Confirm the password *" Style="{StaticResource UserFieldLabel}" />
                            <PasswordBox x:Name="BootstrapPasswordConfirmBox"
                                         Style="{DynamicResource {x:Type PasswordBox}}"
                                         MinHeight="{DynamicResource UiActionMinHeight}"
                                         Margin="{DynamicResource UiGapGroup}"
                                         PasswordChanged="OnBootstrapPasswordConfirmChanged"
                                         ToolTip="Type the same password again"
                                         AutomationProperties.Name="Confirm first administrator password" />

                            <Border Background="{DynamicResource StatusErrorSurface}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{DynamicResource PaddingControl}"
                                    Margin="{DynamicResource UiGapGroup}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBootstrapError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BootstrapError}" Foreground="{DynamicResource StatusError}"
                                           TextWrapping="Wrap" AutomationProperties.Name="Bootstrap error" />
                            </Border>

                            <Button Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding RegisterFirstAdministratorCommand}"
                                    HorizontalAlignment="Left"
                                    MinHeight="{DynamicResource UiActionMinHeight}"
                                    Padding="{DynamicResource UiActionPadding}"
                                    Margin="{DynamicResource UiGapSection}"
                                    AutomationProperties.Name="{Binding BootstrapAccessibleName}">
                                <StackPanel Orientation="Horizontal">
                                    <studio:ShellMark Kind="Save" Width="{DynamicResource ChoiceMarkSize}"
                                                      Height="{DynamicResource ChoiceMarkSize}"
                                                      Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BootstrapSubmitLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </ContentControl>
            </Grid>

            <!-- Editor host: shown instead of the register while editing.
                 Visibility is driven from a wrapper Grid bound to the workspace
                 view model, so the editor keeps its own DataContext. -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <users:UserEditorView DataContext="{Binding Editor}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
