<UserControl x:Class="ProGlassAutomation.Users.UserEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step3 — user editor (add / edit).

         Layout notes:
           • the action buttons live in a footer plate at the bottom of the
             card, outside the scrolling field area, so they always keep the
             theme's own padding clear of the card edge;
           • Department and Role are dropdowns bound to catalogue rows, so a
             department or role that does not exist cannot be typed in;
           • there is no password field, because the application has no
             credentialed login to store one for. Identity is the Windows
             account, matched by username;
           • the audit footer shows WHO added and last changed this row, from
             the stored ids, never from a typed name.

         Theme rules: contract tokens only, dynamic card roles, explicit
         implicit-style bindings for theme-templated controls.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <!-- Same reason as the Users page: `BasedOn` is not a dependency
             property, so it cannot take a DynamicResource. -->
        <BooleanToVisibilityConverter x:Key="UserVisibility" />
        <!-- Labels stack above their field, so their spacing is vertical. -->
        <Style x:Key="UserFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        </Style>
        <!-- One reusable error plate: shown only when its own message is set. -->
        <Style x:Key="UserFieldErrorPlate" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusErrorSurface}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource UiGapField}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="UserFieldErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title strip -->
        <!-- The banner and the card share the page's own edges: no extra margin
             on either, so the editor lines up with the command bar and the
             register it replaces in every theme. -->
        <!-- The banner and the form card below it pin the SAME inset token, so the
             title sits on the same vertical line as the fields in all nine themes
             instead of following each theme's PaddingCard. -->
        <ContentControl Grid.Row="0" Style="{DynamicResource HeroCard}"
                        Background="{DynamicResource AccentPrimary}"
                        Padding="{DynamicResource UiCardPadding}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="{DynamicResource FontWeightHeading}"
                           Foreground="{DynamicResource TextOnAccent}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextOnAccent}"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource UiGapField}" />
            </StackPanel>
        </ContentControl>

        <!-- The card is sized by its content (VerticalAlignment=Top) instead of
             being stretched to the window: a short form ends where the form
             ends, and the ScrollViewer inside still scrolls a long one. -->
        <ContentControl Grid.Row="1" Style="{DynamicResource Card}"
                        Padding="{DynamicResource UiCardPadding}"
                        Margin="{DynamicResource UiGapGroup}"
                        VerticalAlignment="Top"
                        MaxWidth="900" HorizontalAlignment="Left">
            <!-- Fields and actions scroll as ONE column.
                 The first build put the fields in a `*` row and the footer in an
                 `Auto` row, so the fields grid stretched to fill whatever height
                 the window had and the footer was pushed to the bottom of the
                 card — a tall empty band between the last field and SAVE USER on
                 a short form (the owner's screenshot). With the card sized to its
                 content there is no band, and a long form still scrolls: the
                 scroll region is this ScrollViewer, so nothing escapes the card
                 and nothing is clipped. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ── Full name ──────────────────────────────── -->
                        <TextBlock Text="Full name *" Style="{StaticResource UserFieldLabel}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="{DynamicResource UiActionMinHeight}"
                                 MaxLength="120"
                                 ToolTip="The name shown in the register and on documents this person prepares"
                                 AutomationProperties.Name="Full name" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource UserFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFullNameError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FullNameError}" Style="{StaticResource UserFieldErrorText}"
                                       AutomationProperties.Name="Full name error" />
                        </Border>

                        <!-- ── Username (the identity match key) ─────── -->
                        <TextBlock Text="Username *" Style="{StaticResource UserFieldLabel}"
                                   Margin="{DynamicResource UiGapSection}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="{DynamicResource UiActionMinHeight}"
                                 MaxLength="64"
                                 ToolTip="The Windows account name this person signs in with. It must match exactly, otherwise the app cannot tell who is operating."
                                 AutomationProperties.Name="Username" />
                        <TextBlock Text="Must match this person's Windows account name — that is how the app recognises who is operating."
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource UiGapField}" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource UserFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUsernameError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding UsernameError}" Style="{StaticResource UserFieldErrorText}"
                                       AutomationProperties.Name="Username error" />
                        </Border>

                        <!-- ── Department ─────────────────────────────── -->
                        <TextBlock Text="Department *" Style="{StaticResource UserFieldLabel}"
                                   Margin="{DynamicResource UiGapSection}" />
                        <!-- Bound by ROW: the code list arrives with the view model,
                             so a SelectedValue resolved before it exists would show a
                             blank box for a person who already has a department. -->
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  ItemsSource="{Binding Departments}"
                                  MinHeight="{DynamicResource UiActionMinHeight}"
                                  SelectedItem="{Binding DepartmentItem, Mode=TwoWay}"
                                  ToolTip="The team this person belongs to. A department is not a permission."
                                  AutomationProperties.Name="Department">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Department describes the team, not what the person may do."
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource UiGapField}" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource UserFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDepartmentError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DepartmentError}" Style="{StaticResource UserFieldErrorText}"
                                       AutomationProperties.Name="Department error" />
                        </Border>

                        <!-- ── Role ───────────────────────────────────── -->
                        <TextBlock Text="Role *" Style="{StaticResource UserFieldLabel}"
                                   Margin="{DynamicResource UiGapSection}" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  ItemsSource="{Binding Roles}"
                                  MinHeight="{DynamicResource UiActionMinHeight}"
                                  SelectedItem="{Binding RoleItem, Mode=TwoWay}"
                                  ToolTip="What this person is authorised to do"
                                  AutomationProperties.Name="Role">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Estimator is the default. Only an Administrator can change access."
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource UiGapField}" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource UserFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRoleError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RoleError}" Style="{StaticResource UserFieldErrorText}"
                                       AutomationProperties.Name="Role error" />
                        </Border>

                        <!-- ── Password ─────────────────────────────────
                             A user only exists if they can sign in. The password is
                             masked and handed to the view model from the
                             code-behind; it is never displayed, and only its hash is
                             stored. Editing somebody else makes it a temporary
                             reset; editing yourself asks for the current password. -->
                        <TextBlock Text="{Binding PasswordSectionTitle}"
                                   Style="{StaticResource UserFieldLabel}"
                                   Margin="{DynamicResource UiGapSection}" />

                        <TextBlock Text="{Binding PasswordSectionHint}"
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource UiGapField}" />

                        <TextBlock Text="{Binding PasswordStateText}"
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource UiGapField}"
                                   Visibility="{Binding HasPasswordStateText,
                                                        Converter={StaticResource UserVisibility}}"
                                   AutomationProperties.Name="Password state" />

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCurrentPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Current password *" Style="{StaticResource UserFieldLabel}" />
                            <PasswordBox x:Name="CurrentPasswordBox"
                                         Style="{DynamicResource {x:Type PasswordBox}}"
                                         MinHeight="{DynamicResource UiActionMinHeight}"
                                         PasswordChanged="OnCurrentPasswordChanged"
                                         ToolTip="Required to change your own password"
                                         AutomationProperties.Name="Current password" />
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource UserFieldErrorPlate}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCurrentPasswordError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentPasswordError}"
                                           Style="{StaticResource UserFieldErrorText}"
                                           AutomationProperties.Name="Current password error" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="New password" Style="{StaticResource UserFieldLabel}" />
                        <PasswordBox x:Name="NewPasswordBox"
                                     Style="{DynamicResource {x:Type PasswordBox}}"
                                     MinHeight="{DynamicResource UiActionMinHeight}"
                                     PasswordChanged="OnNewPasswordChanged"
                                     ToolTip="At least 8 characters, with a letter and a digit"
                                     AutomationProperties.Name="New password" />

                        <TextBlock Text="Confirm the new password" Style="{StaticResource UserFieldLabel}" />
                        <PasswordBox x:Name="NewPasswordConfirmBox"
                                     Style="{DynamicResource {x:Type PasswordBox}}"
                                     MinHeight="{DynamicResource UiActionMinHeight}"
                                     PasswordChanged="OnNewPasswordConfirmChanged"
                                     ToolTip="Type the new password again"
                                     AutomationProperties.Name="Confirm new password" />

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource UserFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPasswordError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PasswordError}"
                                       Style="{StaticResource UserFieldErrorText}"
                                       AutomationProperties.Name="Password error" />
                        </Border>

                        <!-- ── Status ─────────────────────────────────── -->
                        <TextBlock Text="Status" Style="{StaticResource UserFieldLabel}"
                                   Margin="{DynamicResource UiGapSection}" />
                        <StackPanel>
                            <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                      Content="Active user"
                                      IsChecked="{Binding IsActive}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Active user" />
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="{DynamicResource UiGapField}" />
                        </StackPanel>

                        <!-- Audit footer: ids on the record, names resolved here. -->
                        <Border Background="{DynamicResource StatusInformationSurface}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingCompact}"
                                Margin="{DynamicResource UiGapSection}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAuditText}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AuditText}" Style="{DynamicResource Caption}"
                                       TextWrapping="Wrap" AutomationProperties.Name="Audit trail" />
                        </Border>

                        <!-- Save feedback -->
                        <Border Background="{DynamicResource StatusErrorSurface}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginItem}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrorMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusError}"
                                       TextWrapping="Wrap" AutomationProperties.Name="Save error" />
                        </Border>

                        <Border Background="{DynamicResource StatusSuccessSurface}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginItem}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" AutomationProperties.Name="Editor status" />
                        </Border>

                    <!-- ── Action footer ───────────────────────────────────
                         The last block of the form, one section gap below the audit
                         note, so the actions are plainly part of the card instead of
                         floating at the bottom of a stretched one. Order is
                         primary → status → cancel, and the gaps are the module's
                         action gap (8 px). -->
                    <!-- A rule, not a plate. A surface nested inside a surface is
                         what made the footer's padding differ from the fields'
                         padding in every theme (the inner Plate carries PaddingPlate,
                         the outer card carries UiCardPadding), so the buttons sat a
                         few pixels in from the fields above them. A hairline in the
                         section gap separates the actions without adding a second
                         surface. -->
                    <Border Height="{DynamicResource StrokeWidth}"
                            Background="{DynamicResource BorderStrong}"
                            HorizontalAlignment="Stretch"
                            Margin="{DynamicResource UiGapSection}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                MinHeight="{DynamicResource UiActionMinHeight}"
                                Padding="{DynamicResource UiActionPadding}"
                                Margin="{DynamicResource UiGapAction}"
                                AutomationProperties.Name="Save user">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Save" Width="{DynamicResource ChoiceMarkSize}"
                                                  Height="{DynamicResource ChoiceMarkSize}"
                                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="SAVE USER" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SubtleButton}"
                                Command="{Binding DeactivateCommand}"
                                MinHeight="{DynamicResource UiActionMinHeight}"
                                Padding="{DynamicResource UiActionPadding}"
                                Margin="{DynamicResource UiGapAction}"
                                IsEnabled="{Binding CanChangeStatus}"
                                AutomationProperties.Name="Activate or deactivate user">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Cancel" Width="{DynamicResource ChoiceMarkSize}"
                                                  Height="{DynamicResource ChoiceMarkSize}"
                                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeactivateCommandText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SubtleButton}"
                                Command="{Binding CancelCommand}"
                                MinHeight="{DynamicResource UiActionMinHeight}"
                                Padding="{DynamicResource UiActionPadding}"
                                Margin="{DynamicResource UiGapAction}"
                                AutomationProperties.Name="Cancel editing">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Cancel" Width="{DynamicResource ChoiceMarkSize}"
                                                  Height="{DynamicResource ChoiceMarkSize}"
                                                  Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    </StackPanel>
            </ScrollViewer>
        </ContentControl>
    </Grid>
</UserControl>
