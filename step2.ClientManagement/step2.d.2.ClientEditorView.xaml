<UserControl x:Class="ProGlassAutomation.Clients.ClientEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step2 — client editor (new / view / edit).

         Layout notes (owner feedback, 2026-10-27):
           • the action buttons live in a footer plate at the bottom of the
             card, outside the scrolling field area, so they always keep the
             theme's own padding clear of the card edge and of the card below;
           • two-field groups share one label row / input row / error row, so
             adjacent labels and boxes line up exactly instead of drifting;
           • Client name is the company; Attention name is the person to
             address at that company.

         Theme rules: contract tokens only, dynamic card roles, explicit
         implicit-style bindings for theme-templated controls.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <Style x:Key="ClientFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        </Style>
        <!-- One reusable error plate: shown only when its own message is set. -->
        <Style x:Key="ClientFieldErrorPlate" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusErrorSurface}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="ClientFieldErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title strip -->
        <ContentControl Grid.Row="0" Style="{DynamicResource HeroCard}"
                        Background="{DynamicResource AccentPrimary}"
                        Margin="{DynamicResource PaddingCompact}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="{DynamicResource FontWeightHeading}"
                           Foreground="{DynamicResource TextOnAccent}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextOnAccent}"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource MarginInline}" />
            </StackPanel>
        </ContentControl>

        <!-- Form card: scrolling fields above, fixed action footer below. -->
        <ContentControl Grid.Row="1" Style="{DynamicResource Card}"
                        Margin="{DynamicResource PaddingCompact}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{DynamicResource PaddingCard}">

                        <!-- ── Client name (company) ──────────────────── -->
                        <TextBlock Text="Client name (company) *" Style="{StaticResource ClientFieldLabel}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 ToolTip="The customer's company or trading name"
                                 AutomationProperties.Name="Client name" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClientNameError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ClientNameError}" Style="{StaticResource ClientFieldErrorText}"
                                       AutomationProperties.Name="Client name error" />
                        </Border>

                        <!-- ── Attention name (person to address) ─────── -->
                        <TextBlock Text="Attention name"
                                   Style="{StaticResource ClientFieldLabel}"
                                   Margin="{DynamicResource MarginSection}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding AttentionName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 ToolTip="The person at the client to address on quotes and documents"
                                 AutomationProperties.Name="Attention name" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAttentionNameError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AttentionNameError}" Style="{StaticResource ClientFieldErrorText}" />
                        </Border>

                        <!-- ── Representative (stable user reference) ────
                             A reference, never a typed name: the picker lists the
                             active users with the Salesman role and stores the
                             user id (migration 1014). "No representative" is a
                             real, valid choice — every client that existed before
                             the reference was added is in that state. -->
                        <TextBlock Text="Representative"
                                   Style="{StaticResource ClientFieldLabel}"
                                   Margin="{DynamicResource MarginSection}" />
                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}"
                                  MinHeight="{DynamicResource ControlMinHeight}"
                                  ItemsSource="{Binding Representatives}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding RepresentativeId, Mode=TwoWay}"
                                  IsEnabled="{Binding HasRepresentatives}"
                                  ToolTip="The salesman who owns this client"
                                  AutomationProperties.Name="Client representative">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding RepresentativeHint}"
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="{DynamicResource MarginInline}" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRepresentativeError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RepresentativeError}" Style="{StaticResource ClientFieldErrorText}" />
                        </Border>

                        <!-- ── Phone | E-mail (shared rows) ─────────────
                             Equal halves. The paired row below uses the same
                             halves, so field edges line up as one 2x2 block. -->
                        <Grid Margin="{DynamicResource MarginSection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone"
                                       Style="{StaticResource ClientFieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="E-mail"
                                       Style="{StaticResource ClientFieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Style="{DynamicResource {x:Type TextBox}}"
                                     Margin="{DynamicResource MarginInline}"
                                     VerticalAlignment="Center"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50" AutomationProperties.Name="Phone" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Style="{DynamicResource {x:Type TextBox}}"
                                     Margin="{DynamicResource MarginInline}"
                                     VerticalAlignment="Center"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200" AutomationProperties.Name="E-mail" />
                            <Border Grid.Row="2" Grid.Column="0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPhoneError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PhoneError}" Style="{StaticResource ClientFieldErrorText}" />
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEmailError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EmailError}" Style="{StaticResource ClientFieldErrorText}" />
                            </Border>
                        </Grid>

                        <!-- ── TRN | Status (shared rows) ───────────────
                             Four fields, one two-column grid: Phone | E-mail and
                             TRN | Status each take one equal width, so the boxes
                             stack in two clean columns instead of stepping in and
                             out (owner feedback: "trn and status can come in one
                             width"). -->
                        <Grid Margin="{DynamicResource MarginSection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="TRN (digits only, optional)"
                                       Style="{StaticResource ClientFieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Status"
                                       Style="{StaticResource ClientFieldLabel}" />
                            <!-- VerticalAlignment=Center is deliberate: the Status cell
                                 beside it is taller (toggle + caption), and a stretched
                                 TextBox would grow to that height (owner feedback: "TRN
                                 box too big in height"). The box keeps its own height
                                 and sits centred against the toggle. -->
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Style="{DynamicResource {x:Type TextBox}}"
                                     Margin="{DynamicResource MarginInline}"
                                     VerticalAlignment="Center"
                                     Text="{Binding Trn, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="20"
                                     ToolTip="UAE tax registration number. Stored as text so leading zeros survive."
                                     AutomationProperties.Name="TRN" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="{DynamicResource MarginInline}">
                                <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                          Content="Active client"
                                          IsChecked="{Binding IsActive}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Active client" />
                                <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Caption}"
                                           TextWrapping="Wrap"
                                           Margin="{DynamicResource MarginInline}" />
                            </StackPanel>
                            <Border Grid.Row="2" Grid.Column="0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTrnError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TrnError}" Style="{StaticResource ClientFieldErrorText}" />
                            </Border>
                        </Grid>

                        <!-- ── Address ────────────────────────────────── -->
                        <TextBlock Text="Address" Style="{StaticResource ClientFieldLabel}"
                                   Margin="{DynamicResource MarginSection}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="500" MinHeight="{DynamicResource ControlMinHeight}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="Address" />
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ClientFieldErrorPlate}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAddressError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AddressError}" Style="{StaticResource ClientFieldErrorText}" />
                        </Border>

                        <!-- ── Notes ──────────────────────────────────── -->
                        <TextBlock Text="Notes" Style="{StaticResource ClientFieldLabel}"
                                   Margin="{DynamicResource MarginSection}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="{DynamicResource ControlMinHeight}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="Notes" />

                        <!-- Duplicate warning: information, never a block. -->
                        <Border Background="{DynamicResource StatusWarningSurface}"
                                BorderBrush="{DynamicResource StatusWarning}"
                                BorderThickness="{DynamicResource BorderThicknessControl}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Margin="{DynamicResource MarginSection}"
                                Padding="{DynamicResource PaddingControl}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDuplicateWarning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DuplicateWarning}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Possible duplicate warning" />
                        </Border>

                        <!-- Save feedback -->
                        <Border Background="{DynamicResource StatusErrorSurface}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginItem}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrorMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusError}"
                                       TextWrapping="Wrap" AutomationProperties.Name="Save error" />
                        </Border>

                        <Border Background="{DynamicResource StatusSuccessSurface}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{DynamicResource PaddingControl}"
                                Margin="{DynamicResource MarginItem}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" AutomationProperties.Name="Editor status" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Action footer ───────────────────────────────────
                     A themed plate inside the card, with its own padding and a
                     margin, so the buttons never crowd the card edge or the
                     card below. It stays visible while the fields scroll. -->
                <ContentControl Grid.Row="1" Style="{DynamicResource Plate}"
                                Margin="{DynamicResource MarginItem}">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Save client">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Save" Width="{DynamicResource ChoiceMarkSize}"
                                                    Height="{DynamicResource ChoiceMarkSize}"
                                                    Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="SAVE CLIENT" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SubtleButton}"
                                Command="{Binding ReviewDuplicatesCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Check for duplicates">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Search" Width="{DynamicResource ChoiceMarkSize}"
                                                    Height="{DynamicResource ChoiceMarkSize}"
                                                    Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Check for duplicates" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SubtleButton}"
                                Command="{Binding CancelCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Cancel editing">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Cancel" Width="{DynamicResource ChoiceMarkSize}"
                                                    Height="{DynamicResource ChoiceMarkSize}"
                                                    Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </ContentControl>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
