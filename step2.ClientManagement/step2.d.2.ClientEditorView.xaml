<UserControl x:Class="ProGlassAutomation.Clients.ClientEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step2 — client editor (new / view / edit).

         Same theme rules as the workspace: contract tokens only, explicit
         implicit-style bindings for theme-templated controls, dynamic card
         roles. DataContext is ClientEditorViewModel (assigned by the host).
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <Style x:Key="ClientFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        </Style>
        <Style x:Key="ClientFieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasClientNameError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title strip -->
        <ContentControl Grid.Row="0" Style="{DynamicResource HeroCard}"
                        Background="{DynamicResource AccentPrimary}"
                        Margin="{DynamicResource PaddingCompact}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="{DynamicResource FontWeightHeading}"
                           Foreground="{DynamicResource TextOnAccent}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextOnAccent}"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource MarginInline}" />
            </StackPanel>
        </ContentControl>

        <!-- Form -->
        <ContentControl Grid.Row="1" Style="{DynamicResource Card}"
                        Margin="{DynamicResource PaddingCompact}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{DynamicResource PaddingCard}">

                    <!-- Client name (required) -->
                    <TextBlock Text="Client name *" Style="{StaticResource ClientFieldLabel}" />
                    <TextBox Style="{DynamicResource {x:Type TextBox}}"
                             Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             ToolTip="The customer's company or trading name"
                             AutomationProperties.Name="Client name" />
                    <TextBlock Text="{Binding ClientNameError}" Style="{StaticResource ClientFieldError}"
                               AutomationProperties.Name="Client name error" />

                    <!-- Contact person -->
                    <TextBlock Text="Contact person" Style="{StaticResource ClientFieldLabel}"
                               Margin="{DynamicResource MarginSection}" />
                    <TextBox Style="{DynamicResource {x:Type TextBox}}"
                             Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             AutomationProperties.Name="Contact person" />
                    <Border Background="{DynamicResource StatusErrorSurface}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource PaddingControl}"
                            Margin="{DynamicResource MarginInline}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasContactPersonError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ContactPersonError}"
                                   Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Phone / e-mail -->
                    <Grid Margin="{DynamicResource MarginSection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="{DynamicResource MarginInline}">
                            <TextBlock Text="Phone" Style="{StaticResource ClientFieldLabel}" />
                            <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50"
                                     AutomationProperties.Name="Phone" />
                            <Border Background="{DynamicResource StatusErrorSurface}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{DynamicResource PaddingControl}"
                                    Margin="{DynamicResource MarginInline}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPhoneError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PhoneError}"
                                           Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}">
                            <TextBlock Text="E-mail" Style="{StaticResource ClientFieldLabel}" />
                            <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200"
                                     AutomationProperties.Name="E-mail" />
                            <Border Background="{DynamicResource StatusErrorSurface}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{DynamicResource PaddingControl}"
                                    Margin="{DynamicResource MarginInline}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEmailError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EmailError}"
                                           Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- TRN / status -->
                    <Grid Margin="{DynamicResource MarginSection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="{DynamicResource MarginInline}">
                            <TextBlock Text="TRN (digits only, optional)"
                                       Style="{StaticResource ClientFieldLabel}" />
                            <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                     Text="{Binding Trn, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="20"
                                     ToolTip="UAE tax registration number. Stored as text so leading zeros survive."
                                     AutomationProperties.Name="TRN" />
                            <Border Background="{DynamicResource StatusErrorSurface}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{DynamicResource PaddingControl}"
                                    Margin="{DynamicResource MarginInline}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTrnError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TrnError}"
                                           Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}">
                            <TextBlock Text="Status" Style="{StaticResource ClientFieldLabel}" />
                            <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                      Content="Active client"
                                      IsChecked="{Binding IsActive}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Active client" />
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="{DynamicResource MarginInline}" />
                        </StackPanel>
                    </Grid>

                    <!-- Address -->
                    <TextBlock Text="Address" Style="{StaticResource ClientFieldLabel}"
                               Margin="{DynamicResource MarginSection}" />
                    <TextBox Style="{DynamicResource {x:Type TextBox}}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500" MinHeight="{DynamicResource ControlMinHeight}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Address" />
                    <Border Background="{DynamicResource StatusErrorSurface}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource PaddingControl}"
                            Margin="{DynamicResource MarginInline}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAddressError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AddressError}"
                                   Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="Notes" Style="{StaticResource ClientFieldLabel}"
                               Margin="{DynamicResource MarginSection}" />
                    <TextBox Style="{DynamicResource {x:Type TextBox}}"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="{DynamicResource ControlMinHeight}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Notes" />

                    <!-- Duplicate warning: information, never a block. -->
                    <Border Background="{DynamicResource StatusWarningSurface}"
                            BorderBrush="{DynamicResource StatusWarning}"
                            BorderThickness="{DynamicResource BorderThicknessControl}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Margin="{DynamicResource MarginSection}"
                            Padding="{DynamicResource PaddingControl}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDuplicateWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DuplicateWarning}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Possible duplicate warning" />
                    </Border>

                    <!-- Save feedback -->
                    <Border Background="{DynamicResource StatusErrorSurface}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource PaddingControl}"
                            Margin="{DynamicResource MarginItem}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrorMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusError}"
                                   TextWrapping="Wrap" AutomationProperties.Name="Save error" />
                    </Border>

                    <Border Background="{DynamicResource StatusSuccessSurface}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource PaddingControl}"
                            Margin="{DynamicResource MarginItem}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" AutomationProperties.Name="Editor status" />
                    </Border>

                    <!-- Actions -->
                    <WrapPanel Margin="{DynamicResource MarginSection}">
                        <Button Content="SAVE CLIENT" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Save client" />
                        <Button Content="Check for duplicates" Style="{DynamicResource SubtleButton}"
                                Command="{Binding ReviewDuplicatesCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Check for duplicates" />
                        <Button Content="Cancel" Style="{DynamicResource SubtleButton}"
                                Command="{Binding CancelCommand}"
                                Margin="{DynamicResource MarginInline}"
                                AutomationProperties.Name="Cancel editing" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentControl>
    </Grid>
</UserControl>
