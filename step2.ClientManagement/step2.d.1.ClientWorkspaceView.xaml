<UserControl x:Class="ProGlassAutomation.Clients.ClientWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clients="clr-namespace:ProGlassAutomation.Clients"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step2 — Client Management workspace.

         Theme rules obeyed by this view (docs/02 + step1.d.11):
           • every colour, brush, metric, radius and font comes from the
             shared contract through DynamicResource — no literals;
           • theme-owned card roles (Card / HeroCard / MetricCard) are looked
             up dynamically and never BasedOn a StaticResource;
           • controls with theme-owned templates (TextBox, ComboBox, CheckBox,
             DataGrid) bind the active implicit style explicitly, so a theme
             switch replaces the template as well as the tokens;
           • visibility is driven by Style DataTriggers, so no converter or
             code-behind is needed for the register/editor switch.

         One view serves all nine installed themes in Light and Dark. It has
         no theme-specific branch and adds nothing to any theme package.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <!-- The row action flips meaning with the client's state, so the mark
             flips with it: cross = deactivate, plus = re-activate. -->
        <Style x:Key="ClientToggleIcon" TargetType="studio:ShellMark">
            <Setter Property="Kind" Value="Cancel" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Kind" Value="Add" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ── Filter chips ────────────────────────────────────────────
             All / Active / Inactive, each carrying its own count. Idle is the
             theme's BorderSubtle on SurfacePrimary; selected takes AccentPrimary
             with TextOnAccent, exactly as the Inquiry status chips do, so the
             two registers cannot drift apart. -->
        <Style x:Key="ClientFilterChip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource ControlMinWidth}" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
            <Setter Property="Margin" Value="{DynamicResource MarginInline}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ChipCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StatePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The per-row menu trigger. Transparent until hovered, so fifteen rows
             do not read as fifteen buttons; still hit-testable and named for
             assistive tech. -->
        <Style x:Key="ClientRowMenuButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Width" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Height" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── One command bar ─────────────────────────────────────────
             Owner feedback on the first build of this bar: "this section didn't
             have proper spacing in texts", "why this section become ugly, where
             are the filtered and other things gone", and on the strip under the
             register: "move these to top so this space can be extra".

             Three causes, three fixes:

               1. The bar repeated the page title. The shell banner already says
                  "Clients / Business · Client directory", and the bar printed a
                  second "Clients" with "Client directory" jammed against it at a
                  smaller size - that crowding is the "ugly" part. The title is
                  gone from the bar; the bar carries filter state only.
               2. Every label was stacked with no rhythm. Each line now carries
                  the theme's own inset, and the two blocks are vertically
                  centred against each other instead of both hugging the top.
               3. The selection actions lived in a strip under the register and
                  printed SelectedSummary, which repeated the row already on
                  screen. They are in this bar now and the strip is gone, so the
                  register gets those pixels back as rows.

             Still only contracted controls: Plate, Caption, TextBox, Button,
             PrimaryButton, SubtleButton, ContextMenu, MenuItem, ShellMark. -->
        <ContentControl Grid.Row="0" Style="{DynamicResource Plate}" Margin="{DynamicResource PaddingPage}">
            <Grid Margin="{DynamicResource PaddingCompact}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filter state: the count sentence, then the chips under it. The
                     order matters for spacing - MarginInline carries a bottom inset
                     but no top one, so the text above the chips is what guarantees
                     a gap between the two lines. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                            Margin="{DynamicResource MarginInline}">
                    <TextBlock Text="{Binding RegisterSummary}" Style="{DynamicResource Caption}"
                               Margin="{DynamicResource MarginInline}" />
                    <ItemsControl ItemsSource="{Binding StatusTabs}" Focusable="False"
                                  AutomationProperties.Name="Client status filters">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClientFilterChip}"
                                        Command="{Binding DataContext.SelectStatusTabCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding LabelWithCount}"
                                        AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- One row of actions, every control vertically centred so none
                     of them floats above the others. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Search. The hint line is a TextBlock over the field with a
                         DataTrigger on the bound text: TextBox has no placeholder
                         property, and a converter would need an app-level resource
                         this project does not have. -->
                    <studio:ShellMark Kind="Search" Width="{DynamicResource ChoiceMarkSize}"
                                      Height="{DynamicResource ChoiceMarkSize}"
                                      Margin="{DynamicResource MarginInline}"
                                      VerticalAlignment="Center" />
                    <Grid Width="300" VerticalAlignment="Center"
                          Margin="{DynamicResource MarginInline}">
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, contact, phone, e-mail, TRN or address"
                                 AutomationProperties.Name="Search clients" />
                        <TextBlock Text="Search clients…" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource PaddingCompact}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding ClearSearchCommand}"
                            Margin="{DynamicResource UiGapControl}"
                            ToolTip="Clear the search"
                            AutomationProperties.Name="Clear search">
                        <studio:ShellMark Kind="Cancel" Width="{DynamicResource ChoiceMarkSize}"
                                          Height="{DynamicResource ChoiceMarkSize}" />
                    </Button>

                    <!-- Selection actions, moved up from the strip under the
                         register. Disabled until a row is selected; they act on
                         the selected row, and the per-row menu does the same for
                         a row that was never selected. -->
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding EditSelectedCommand}"
                            Margin="{DynamicResource UiGapControl}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="Edit the selected client"
                            AutomationProperties.Name="Edit selected client">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Edit" Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="Edit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SubtleButton}"
                            Command="{Binding ToggleActiveCommand}"
                            CommandParameter="{Binding SelectedRow}"
                            Margin="{DynamicResource UiGapControl}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="Activate or deactivate the selected client"
                            AutomationProperties.Name="Activate or deactivate selected client">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Style="{StaticResource ClientToggleIcon}"
                                              Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedToggleLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource PrimaryButton}"
                            Command="{Binding NewClientCommand}"
                            Margin="{DynamicResource UiGapControl}"
                            AutomationProperties.Name="New client">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Add" Width="{DynamicResource ChoiceMarkSize}"
                                              Height="{DynamicResource ChoiceMarkSize}"
                                              Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="NEW CLIENT" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="{DynamicResource UiGapControl}" x:Name="MoreActionsButton" Style="{DynamicResource SubtleButton}"
                            Content="⋯"
                            Click="OnMoreActionsClick"
                            ToolTip="More actions"
                            AutomationProperties.Name="More client actions">
                        <Button.ContextMenu>
                            <ContextMenu Style="{DynamicResource {x:Type ContextMenu}}">
                                <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- ── Register (list) and editor share row 2 ─────────────────── -->
        <Grid Grid.Row="2" Margin="{DynamicResource PaddingPage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error surface: failures are shown, never swallowed. -->
            <Border Grid.Row="0" Background="{DynamicResource StatusErrorSurface}"
                    BorderBrush="{DynamicResource StatusError}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource MarginItem}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusError}"
                           TextWrapping="Wrap" AutomationProperties.Name="Client error" />
            </Border>

            <!-- Status line -->
            <Border Grid.Row="1" Background="{DynamicResource StatusInformationSurface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource MarginItem}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" AutomationProperties.Name="Client status" />
            </Border>

            <!-- Register card -->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ContentControl Style="{DynamicResource Card}">
                    <DataGrid Style="{DynamicResource ListGrid}"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              AutomationProperties.Name="Client directory"
                              MouseDoubleClick="OnRowDoubleClick"
                              KeyDown="OnGridKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}"
                                                ElementStyle="{DynamicResource ListStrongText}" />
                            <DataGridTextColumn Header="Attention" Binding="{Binding AttentionName}"
                                                ElementStyle="{DynamicResource ListText}" />
                            <DataGridTextColumn Header="Representative" Binding="{Binding RepresentativeText}"
                                                ElementStyle="{DynamicResource ListText}" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}"
                                                ElementStyle="{DynamicResource ListMonoText}" />
                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}"
                                                ElementStyle="{DynamicResource ListText}" />
                            <DataGridTextColumn Header="TRN" Binding="{Binding Trn}"
                                                ElementStyle="{DynamicResource ListMonoText}" />
                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Status" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource StatusBadge}"
                                                Tag="{Binding StatusTag}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{DynamicResource StatusText}"
                                                       Tag="{Binding StatusTag}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}"
                                                ElementStyle="{DynamicResource ListMonoText}" />
                            <!-- Row menu. One trigger per row instead of three
                                 icons: fifteen rows of pencil/cross/dots read as
                                 noise. The menu is a themed ContextMenu, and the
                                 footer keeps working for whatever row is selected,
                                 so a row can be acted on either way. -->
                            <DataGridTemplateColumn CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Actions" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ClientRowMenuButton}"
                                                Content="⋯"
                                                Click="OnRowMenuClick"
                                                Tag="{Binding DataContext,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="Row actions"
                                                AutomationProperties.Name="Client row actions">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{DynamicResource {x:Type ContextMenu}}"
                                                             DataContext="{Binding PlacementTarget.DataContext,
                                                                           RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Edit client…"
                                                              Command="{Binding PlacementTarget.Tag.EditClientCommand,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding ToggleLabel}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleActiveCommand,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ContentControl>
            </Grid>

            <!-- Editor host: shown instead of the register while editing.
                 Visibility is driven from a wrapper Grid bound to the
                 workspace view model, so the editor itself keeps its own
                 DataContext and no ancestor lookup is required. -->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <clients:ClientEditorView DataContext="{Binding Editor}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
