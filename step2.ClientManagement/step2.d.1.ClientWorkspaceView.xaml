<UserControl x:Class="ProGlassAutomation.Clients.ClientWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clients="clr-namespace:ProGlassAutomation.Clients"
             xmlns:studio="clr-namespace:ProGlassAutomation.ThemeStudio"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- ─────────────────────────────────────────────────────────────────
         step2 — Client Management workspace.

         Theme rules obeyed by this view (docs/02 + step1.d.11):
           • every colour, brush, metric, radius and font comes from the
             shared contract through DynamicResource — no literals;
           • theme-owned card roles (Card / HeroCard / MetricCard) are looked
             up dynamically and never BasedOn a StaticResource;
           • controls with theme-owned templates (TextBox, ComboBox, CheckBox,
             DataGrid) bind the active implicit style explicitly, so a theme
             switch replaces the template as well as the tokens;
           • visibility is driven by Style DataTriggers, so no converter or
             code-behind is needed for the register/editor switch.

         One view serves all nine installed themes in Light and Dark. It has
         no theme-specific branch and adds nothing to any theme package.
         ───────────────────────────────────────────────────────────────── -->
    <UserControl.Resources>
        <!-- Register cells are centred to match the centred column headers
             (owner feedback: left-aligned values under centred headers read as
             misaligned). Trimming stays so a long company name cannot push a
             column wider. -->
        <Style x:Key="ClientNameCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ClientMonoCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!-- The row action flips meaning with the client's state, so the mark
             flips with it: cross = deactivate, plus = re-activate. -->
        <Style x:Key="ClientToggleIcon" TargetType="studio:ShellMark">
            <Setter Property="Kind" Value="Cancel" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Kind" Value="Add" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientPlainCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!-- ── Register alignment and header rules ──────────────────────
             Owner direction, twice: the rules belong in the header row only, the
             data rows stay blank, and the header must not look boxed.

             Header: this view draws one hairline at each column boundary and
             switches the theme's own header frame off. The theme's frame is a
             package-wide control weight (2px in Neumorphism, 4px in
             Claymorphism) and at that weight a table header reads as a boxed
             grid, which is what was rejected. The hairline width is the theme's
             StrokeWidth and its colour BorderStrong, so the rule still follows
             the theme; the zeros are structural, not metrics.

             Rows: GridLinesVisibility="None" is explicit. The packages disagree
             here (Neumorphism draws nothing, Bento draws horizontal rules) and
             the register is meant to read as plain rows in every theme.

             Cells: a DataGridTextColumn hands its cell a full-width slot, but a
             template column (Status) hands it a content-sized one, so the
             badge's own HorizontalAlignment is ignored. Alignment belongs on the
             cell. Both derived styles keep the theme's cell chrome, header
             template and resize grippers: no theme gives DataGridCell a
             Template, and every setter either style owns resolves through
             DynamicResource, so a live theme switch still repaints them. -->
        <Style x:Key="ClientHeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="{DynamicResource SpacingMedium}" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{DynamicResource TransparentBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background"
                                        Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The cell geometry is owned here, not inherited, and the reason is
             measured rather than stylistic: with the package's cell style the
             register painted a 1px rule on all four sides of every cell, so the
             data rows came out as a boxed grid (owner screenshots) even after
             GridLinesVisibility was cleared. The template below keeps every
             colour a TemplateBinding, so the theme still owns background,
             foreground, selection and focus ring, and it cannot draw a border
             the theme has not asked for. HorizontalContentAlignment="Stretch"
             on the presenter is what makes the value styles' own alignment and
             TextAlignment take effect: a left-aligned presenter hands every cell
             a content-sized slot, which is why centred values still rendered
             hard against the left edge. -->
        <Style x:Key="ClientCell" TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClientColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource ClientHeaderGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource ClientHeaderGripper}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClientHeaderLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
        </Style>
        <Style x:Key="ClientHeaderRule" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="{DynamicResource StrokeWidth}" />
            <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Header: identity, counters, primary actions ─────────────── -->
        <Grid Grid.Row="0" Margin="{DynamicResource PaddingPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2.4*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{DynamicResource HeroCard}"
                            Background="{DynamicResource AccentPrimary}"
                            Margin="{DynamicResource PaddingCompact}">
                <StackPanel>
                    <TextBlock Text="PROGLASS  ·  CLIENTS" FontWeight="{DynamicResource FontWeightHeading}"
                               Foreground="{DynamicResource TextOnAccent}" />
                    <TextBlock Text="Customer directory" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextOnAccent}"
                               Margin="{DynamicResource MarginInline}" />
                    <TextBlock Text="{Binding RegisterSummary}" FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="{DynamicResource FontWeightHeading}"
                               Foreground="{DynamicResource TextOnAccent}"
                               Margin="{DynamicResource MarginInline}" />
                    <TextBlock Text="Inactive clients stay in the directory for history and reporting."
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextOnAccent}"
                               TextWrapping="Wrap"
                               Margin="{DynamicResource MarginInline}" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="1" Style="{DynamicResource MetricCard}"
                            Margin="{DynamicResource PaddingCompact}">
                <StackPanel>
                    <TextBlock Text="Active" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding ActiveCount}" FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <TextBlock Text="Available for current work" Style="{DynamicResource Caption}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="2" Style="{DynamicResource MetricCard}"
                            Margin="{DynamicResource PaddingCompact}">
                <StackPanel>
                    <TextBlock Text="Inactive" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding InactiveCount}" FontSize="{DynamicResource FontSizeSection}"
                               FontWeight="{DynamicResource FontWeightHeading}" />
                    <TextBlock Text="Kept for history" Style="{DynamicResource Caption}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="3" Style="{DynamicResource Card}"
                            Margin="{DynamicResource PaddingCompact}">
                <StackPanel Margin="{DynamicResource PaddingCompact}">
                    <TextBlock Text="Actions" Style="{DynamicResource Caption}" />
                    <Button Style="{DynamicResource PrimaryButton}"
                            Command="{Binding NewClientCommand}" HorizontalAlignment="Stretch"
                            Margin="{DynamicResource MarginInline}"
                            AutomationProperties.Name="New client">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Add" Width="{DynamicResource ChoiceMarkSize}"
                                                Height="{DynamicResource ChoiceMarkSize}"
                                                Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="NEW CLIENT" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Two equal-width secondary actions on one row. The grid
                         owns the horizontal inset and the buttons fill their
                         halves exactly, so Edit and Refresh are the same size —
                         nested margins used to make Edit narrower than Refresh. -->
                    <Grid Margin="{DynamicResource MarginInline}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource SubtleButton}"
                                Command="{Binding EditSelectedCommand}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding HasSelection}"
                                AutomationProperties.Name="Edit selected client">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Edit" Width="{DynamicResource ChoiceMarkSize}"
                                                    Height="{DynamicResource ChoiceMarkSize}"
                                                    Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Edit" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource SubtleButton}"
                                Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Refresh client list">
                            <StackPanel Orientation="Horizontal">
                                <studio:ShellMark Kind="Refresh" Width="{DynamicResource ChoiceMarkSize}"
                                                    Height="{DynamicResource ChoiceMarkSize}"
                                                    Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ── Search / filter row (hidden while editing) ─────────────── -->
        <Grid Grid.Row="1" Margin="{DynamicResource PaddingPage}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Style="{DynamicResource Card}">
                <Grid Margin="{DynamicResource PaddingCompact}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Search" Style="{DynamicResource Caption}"
                                   Margin="{DynamicResource MarginInline}" />
                        <TextBox Style="{DynamicResource {x:Type TextBox}}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, contact, phone, e-mail, TRN or address"
                                 AutomationProperties.Name="Search clients" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="{DynamicResource MarginInline}">
                        <TextBlock Text="Show" Style="{DynamicResource Caption}"
                                   Margin="{DynamicResource MarginInline}" />
                        <CheckBox Style="{DynamicResource {x:Type CheckBox}}"
                                  Content="Include inactive"
                                  IsChecked="{Binding IncludeInactive}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Include inactive clients" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource SubtleButton}"
                            Command="{Binding ClearSearchCommand}"
                            Margin="{DynamicResource MarginInline}"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Clear search">
                        <StackPanel Orientation="Horizontal">
                            <studio:ShellMark Kind="Cancel" Width="{DynamicResource ChoiceMarkSize}"
                                                Height="{DynamicResource ChoiceMarkSize}"
                                                Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                            <TextBlock Text="Clear search" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ── Register (list) and editor share row 2 ─────────────────── -->
        <Grid Grid.Row="2" Margin="{DynamicResource PaddingPage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error surface: failures are shown, never swallowed. -->
            <Border Grid.Row="0" Background="{DynamicResource StatusErrorSurface}"
                    BorderBrush="{DynamicResource StatusError}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource MarginItem}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusError}"
                           TextWrapping="Wrap" AutomationProperties.Name="Client error" />
            </Border>

            <!-- Status line -->
            <Border Grid.Row="1" Background="{DynamicResource StatusInformationSurface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="{DynamicResource BorderThicknessControl}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Margin="{DynamicResource MarginItem}"
                    Padding="{DynamicResource PaddingControl}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" AutomationProperties.Name="Client status" />
            </Border>

            <!-- Register card -->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ContentControl Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" Style="{DynamicResource {x:Type DataGrid}}"
                                  ItemsSource="{Binding Rows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  CellStyle="{StaticResource ClientCell}"
                                  GridLinesVisibility="None"
                                  ColumnHeaderStyle="{StaticResource ClientColumnHeader}"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  MinColumnWidth="{DynamicResource ControlMinWidth}"
                                  Margin="{DynamicResource MarginItem}"
                                  AutomationProperties.Name="Client directory"
                                  MouseDoubleClick="OnRowDoubleClick"
                                  KeyDown="OnGridKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Binding="{Binding ClientName}" ElementStyle="{StaticResource ClientNameCell}">
                                    <DataGridTextColumn.Header>
            <Grid>
                <TextBlock Text="Client" Style="{StaticResource ClientHeaderLabel}" />
                <Border Style="{StaticResource ClientHeaderRule}" />
            </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="1.2*" Binding="{Binding AttentionName}" ElementStyle="{StaticResource ClientPlainCell}">
                                    <DataGridTextColumn.Header>
            <Grid>
                <TextBlock Text="Attention" Style="{StaticResource ClientHeaderLabel}" />
                <Border Style="{StaticResource ClientHeaderRule}" />
            </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="1*" Binding="{Binding Phone}" ElementStyle="{StaticResource ClientMonoCell}">
                                    <DataGridTextColumn.Header>
            <Grid>
                <TextBlock Text="Phone" Style="{StaticResource ClientHeaderLabel}" />
                <Border Style="{StaticResource ClientHeaderRule}" />
            </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="1.4*" Binding="{Binding Email}" ElementStyle="{StaticResource ClientPlainCell}">
                                    <DataGridTextColumn.Header>
            <Grid>
                <TextBlock Text="E-mail" Style="{StaticResource ClientHeaderLabel}" />
                <Border Style="{StaticResource ClientHeaderRule}" />
            </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="0.9*" Binding="{Binding Trn}" ElementStyle="{StaticResource ClientMonoCell}">
                                    <DataGridTextColumn.Header>
            <Grid>
                <TextBlock Text="TRN" Style="{StaticResource ClientHeaderLabel}" />
                <Border Style="{StaticResource ClientHeaderRule}" />
            </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="0.8*" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
            <Grid>
                <TextBlock Text="Status" Style="{StaticResource ClientHeaderLabel}" />
                <Border Style="{StaticResource ClientHeaderRule}" />
            </Grid>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource StatusBadge}"
                                                    Tag="{Binding StatusTag}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Style="{DynamicResource StatusText}"
                                                           Tag="{Binding StatusTag}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="1*" Binding="{Binding UpdatedText}" ElementStyle="{StaticResource ClientMonoCell}">
                                    <DataGridTextColumn.Header>
            <Grid>
                <TextBlock Text="Updated" Style="{StaticResource ClientHeaderLabel}" />
            </Grid>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Selected-row action strip: nothing that deletes a row. -->
                        <ContentControl Grid.Row="1" Style="{DynamicResource Card}"
                                        Margin="{DynamicResource MarginItem}">
                            <Grid Margin="{DynamicResource PaddingCompact}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedSummary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="{DynamicResource MarginInline}"
                                           AutomationProperties.Name="Selected client summary" />
                                <Button Grid.Column="1" Style="{DynamicResource SubtleButton}"
                                        Command="{Binding EditSelectedCommand}"
                                        Margin="{DynamicResource MarginInline}"
                                        IsEnabled="{Binding HasSelection}"
                                        AutomationProperties.Name="Edit selected client">
                                    <StackPanel Orientation="Horizontal">
                                        <studio:ShellMark Kind="Edit" Width="{DynamicResource ChoiceMarkSize}"
                                                            Height="{DynamicResource ChoiceMarkSize}"
                                                            Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" />
                                        <TextBlock Text="Edit selected" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{DynamicResource SubtleButton}"
                                        Command="{Binding ToggleActiveCommand}"
                                        CommandParameter="{Binding SelectedRow}"
                                        Margin="{DynamicResource MarginInline}"
                                        IsEnabled="{Binding HasSelection}"
                                        AutomationProperties.Name="Activate or deactivate selected client">
                                    <StackPanel Orientation="Horizontal">
                                        <studio:ShellMark Style="{StaticResource ClientToggleIcon}"
                                                          Width="{DynamicResource ChoiceMarkSize}"
                                                          Height="{DynamicResource ChoiceMarkSize}"
                                                          Margin="{DynamicResource MarginInline}"
                                                          VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedToggleLabel}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </ContentControl>
            </Grid>

            <!-- Editor host: shown instead of the register while editing.
                 Visibility is driven from a wrapper Grid bound to the
                 workspace view model, so the editor itself keeps its own
                 DataContext and no ancestor lookup is required. -->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <clients:ClientEditorView DataContext="{Binding Editor}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
